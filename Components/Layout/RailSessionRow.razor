@* One rail row: a live session (link) or a past one (opened with its history on click). *@
@inject SessionManager Sessions
@inject NavigationManager Nav

@if (Session is { } s)
{
    <NavLink class="s" href="@($"session/{s.Id}")" ActiveClass="on" aria-current="@(IsCur(s.Id) ? "page" : null)">
        <span class="dot @Dot(s)"></span>
        <div><div class="n">@s.Name</div>@Where(s.Branch, s.Repo)</div>
        @switch (s.Status)
        {
            case SessionStatus.Waiting: <span class="pill wait"><span aria-hidden="true">@s.Pending.Count</span><span class="vh">@Strings.Plural(s.Pending.Count, "Mascot.Decision")</span></span> break;
            case SessionStatus.Running: <span class="c c-ok">@L["Status.Running"]</span> break;
            case SessionStatus.Crashed: <span class="pill err">@s.ExitLabel</span> break;
            default: <span class="c">@(s.CostUsd >= 0.005m ? Fmt.Cost(s.CostUsd, 2) : "")</span> break;
        }
    </NavLink>
}
else if (Past is { } p)
{
    <a class="s @(IsCur(p.Id) ? "on" : null)" href="@($"session/{p.Id}")" aria-current="@(IsCur(p.Id) ? "page" : null)" @onclick="Open" @onclick:preventDefault>
        <span class="dot exited"></span>
        <div><div class="n">@p.Title</div>@Where(p.Branch, TranscriptStore.RepoName(p.Cwd))@if (Sessions.RunningElsewhere(p.Id)) {<div class="branch c-ok">@L["Status.Elsewhere"]</div>}</div>
        <span class="c">@(p.CostUsd >= 0.005m ? Fmt.Cost(p.CostUsd.Value, 2) : "")</span>
    </a>
}

@code {
    [Parameter] public LiveSession? Session { get; set; }
    [Parameter] public PastSession? Past { get; set; }

    internal static string Dot(LiveSession s) => s.Status switch
    {
        SessionStatus.Waiting => "wait",
        SessionStatus.Running => "run",
        SessionStatus.Crashed => "err",
        SessionStatus.Exited => "exited",
        _ => "idle",
    };

    static RenderFragment Where(string? branch, string? repo) => string.Join(" · ", new[] { branch, repo }.Where(x => !string.IsNullOrEmpty(x))) is { Length: > 0 } w
        ? @<div class="branch"><Icon Name="branch" />@w</div>
        : @<text></text>;

    bool IsCur(string id) => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0] == $"session/{id}";

    void Open()
    {
        Sessions.Open(Past!);
        Nav.NavigateTo($"session/{Past!.Id}");
    }
}
