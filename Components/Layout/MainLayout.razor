@inherits LayoutComponentBase
@implements IDisposable
@inject UiState Ui
@inject SessionManager Sessions
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="app">
    <Rail />
    <main>@Body</main>
</div>
<CommandPalette />
<IconSprite />

@* blazor.web.js sets display:block on #blazor-error-ui and wires .reload / .dismiss by class. *@
<div id="blazor-error-ui" role="alert" data-nosnippet>
    <div class="beu">
        <div class="duck" aria-hidden="true"><Duck Mood="Mood.Ko" Size="36" /></div>
        <p><b>@L["Layout.Error"]</b>@L["Layout.ErrorHint"]</p>
        <a href="" class="reload btn primary"><Icon Name="refresh" Sm />@L["Layout.Reload"]</a>
        <button type="button" class="dismiss btn ghost" aria-label="@L["Layout.Dismiss"]"><Icon Name="x" /></button>
    </div>
</div>

@code {
    DotNetObjectReference<MainLayout>? self;
    readonly Dictionary<string, (SessionStatus Status, DateTimeOffset? Result)> seen = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        self = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("claudeUi.registerShortcuts", self);
        lock (seen) Due();   // what is already waiting when the page loads is on screen, not news
        Sessions.Changed += OnSessions;
    }

    // Compared on the thread that raised Changed, not later in the dispatcher: a permission answered and the next one
    // asked inside one dispatch would otherwise read Waiting → Waiting and go unnoticed.
    void OnSessions()
    {
        List<(string, string, string)> due;
        lock (seen) due = Due();
        if (due.Count > 0 && (!Shell.Desktop || Notifications.ShellOn)) _ = InvokeAsync(() => Post(due));
    }

    // Notifications.cs: compare each session with its last observation.
    List<(string Id, string Title, string Body)> Due()
    {
        var due = new List<(string, string, string)>();
        foreach (var s in Sessions.All)
        {
            var (status, result, pending) = (s.Status, s.LastResultAt, s.Pending);
            var had = seen.TryGetValue(s.Id, out var before);
            seen[s.Id] = (status, result);
            var kind = Notifications.Between(had ? before.Status : null, before.Result, status, result, s.LastResultSubtype);
            if (kind != Notifications.Kind.None)
                due.Add((s.Id, s.Name, Notifications.Body(kind, pending.FirstOrDefault()?.Tool, s.LastTurn, s.LastResultSubtype)));
        }
        return due;
    }

    // app.js decides whether the user is looking; true = the desktop shell must post it.
    async Task Post(List<(string Id, string Title, string Body)> due)
    {
        foreach (var (id, title, body) in due)
            try
            {
                if (await JS.InvokeAsync<bool>("claudeUi.notify", id, title, body, Shell.Desktop)) Notifications.ToShell(id, title, body);
            }
            catch (Exception e) when (e is JSException or JSDisconnectedException or TaskCanceledException) { }   // the next one may still get through
    }

    // Keys sent by app.js. Navigation and toggles are handled here; Escape / Enter / Shift+Enter / Delete
    // are relayed through UiState.Key (session interrupt, permission card), except Escape closing the palette.
    [JSInvokable]
    public void OnShortcut(string key)
    {
        switch (key)
        {
            case "Ctrl+K": Ui.PaletteOpen = !Ui.PaletteOpen; break;
            case "Ctrl+I": Ui.InspectorOpen = !Ui.InspectorOpen; break;
            case "Ctrl+N": Ui.PaletteOpen = false; Nav.NavigateTo(""); break;
            case "Ctrl+Shift+O": Ui.PaletteOpen = false; Nav.NavigateTo("overview"); break;
            case "Ctrl+Shift+A":
                if (Sessions.DecisionQueue.FirstOrDefault() is { S: { } s })
                {
                    Ui.PaletteOpen = false;
                    Nav.NavigateTo($"session/{s.Id}");
                }
                break;
            case "Escape" when Ui.PaletteOpen: Ui.PaletteOpen = false; break;
            default: Ui.RaiseKey(key); break;
        }
    }

    public void Dispose()
    {
        Sessions.Changed -= OnSessions;
        self?.Dispose();
    }
}
