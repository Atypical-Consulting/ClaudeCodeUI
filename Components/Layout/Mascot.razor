@* Rail duck. Priority: decisions pending > running > crashed > turn done < 5 min > calm. *@
@implements IDisposable
@inject SessionManager Sessions

@{ var st = State; }
<div class="mascot">
    <div class="duck"><Duck Mood="st.Mood" Size="48" /></div>
    <div><b>@st.Title</b>@st.Text</div>
</div>

@code {
    (Mood Mood, string Title, string Text) State
    {
        get
        {
            var all = Sessions.All;
            var pending = Sessions.DecisionQueue.Count();
            if (pending > 0)
                return (Mood.Shocked, pending == 1 ? L["Mascot.Decision1"] : L["Mascot.DecisionN", pending], L["Mascot.NextDecision"]);
            var running = all.Count(s => s.Status == SessionStatus.Running);
            if (running > 0)
                return (Mood.Excited, L["Mascot.Working"], running == 1 ? L["Mascot.Running1"] : L["Mascot.RunningN", running]);
            if (all.LastOrDefault(s => s.Status == SessionStatus.Crashed) is { } c)
                return (Mood.Sad, L["Mascot.Crashed"], $"{c.Name} · exit {c.ExitCode}");
            // ponytail: re-evaluated on the next session event, not by a timer at the 5-minute mark
            if (all.Where(s => s.LastResultSubtype == "success" && s.LastResultAt > DateTimeOffset.Now.AddMinutes(-5)).MaxBy(s => s.LastResultAt) is { } d)
                return (Mood.Blissful, L["Mascot.TurnDone"], d.LastTurn is { } t ? $"{d.Name} · {Fmt.Dur(t)}" : d.Name);
            return (Mood.Happy, L["Mascot.Calm"], L["Mascot.NoDecision"]);
        }
    }

    protected override void OnInitialized() => Sessions.Changed += Refresh;
    void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => Sessions.Changed -= Refresh;
}
