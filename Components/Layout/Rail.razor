@implements IDisposable
@inject SessionManager Sessions
@inject WorktreeService Worktrees
@inject UiState Ui

<nav class="pane" aria-label="@L["Rail.Label"]">
    <div class="ph"><span class="brand"><i></i>Claude Code</span></div>
    <div class="rail-actions">
        <NavLink class="btn block" href="" Match="NavLinkMatch.All" ActiveClass="is-hover"><Icon Name="plus" Sm />@L["Rail.NewSession"]<kbd>Alt N</kbd></NavLink>
        <button class="search" @onclick="() => Ui.PaletteOpen = true"><Icon Name="search" Sm />@L["Rail.Search"]<kbd>Ctrl K</kbd></button>
        <NavLink class="btn block ghost" href="overview" ActiveClass="is-hover"><Icon Name="grid" Sm />@L["Nav.Overview"]</NavLink>
        <NavLink class="btn block ghost" href="worktrees" ActiveClass="is-hover"><Icon Name="branch" Sm />Worktrees
            @if (Worktrees.CleanableCount is > 0)
            {
                <span class="tag" style="margin-left:auto">@L["Rail.ToClean", Worktrees.CleanableCount]</span>
            }
        </NavLink>
        <NavLink class="btn block ghost" href="extensions" ActiveClass="is-hover"><Icon Name="plug" Sm />Extensions
            @if (FailedMcp > 0)
            {
                <span class="pill err" style="margin-left:auto">@FailedMcp</span>
            }
        </NavLink>
    </div>
    <div style="flex:1;min-height:0;overflow:auto">
    @{ var active = Sessions.Active; }
    @if (active.Count > 0)
    {
        <div class="grp"><span class="cap">@L["Rail.Active"]</span></div>
        <div class="list">
            @foreach (var s in active)
            {
                <RailSessionRow @key="s.Id" Session="s" />
            }
        </div>
    }
    @{ var past = recent.Where(p => !Sessions.IsActive(p.Id)).Take(8).ToList(); }   @* the palette searches the full list *@
    @if (past.Count > 0)
    {
        <div class="grp"><span class="cap">@L["Rail.Recent"]</span></div>
        <div class="list">
            @foreach (var p in past)
            {
                <RailSessionRow @key="p.Id" Past="p" />
            }
        </div>
    }
    </div>
    <QuotaMeter />
    <Mascot />
</nav>

@code {
    int FailedMcp => Sessions.All.LastOrDefault(s => s.Init is not null)?.Init!.Mcp.Count(m => m.Status == "failed") ?? 0;

    IReadOnlyList<PastSession> recent = [];
    Task loading = Task.CompletedTask;
    DateTimeOffset loadedAt;

    protected override void OnInitialized() { Sessions.Changed += Refresh; Worktrees.Changed += Refresh; LoadRecent(); }
    void Refresh() { LoadRecent(); InvokeAsync(StateHasChanged); }

    // TranscriptStore.Recent reads up to ~4 MB of transcripts when its 30 s cache expires: off the render thread, at most every 30 s.
    void LoadRecent()
    {
        if (!RendererInfo.IsInteractive || !loading.IsCompleted || DateTimeOffset.Now - loadedAt < TimeSpan.FromSeconds(30)) return;
        loadedAt = DateTimeOffset.Now;
        loading = Task.Run(async () => { recent = TranscriptStore.Recent(); await InvokeAsync(StateHasChanged); });
    }
    public void Dispose() { Sessions.Changed -= Refresh; Worktrees.Changed -= Refresh; }
}
