@* Ctrl K: sessions (live + recent) and actions, filtered. Escape is handled by MainLayout. *@
@implements IDisposable
@using System.Text.Encodings.Web
@inject UiState Ui
@inject SessionManager Sessions
@inject NavigationManager Nav
@inject IJSRuntime JS

@if (Ui.PaletteOpen)
{
    var rows = Rows();
    sel = Math.Clamp(sel, 0, Math.Max(0, rows.Count - 1));
    <div class="scrim" @onclick="() => Ui.PaletteOpen = false"></div>
    <div class="palette" role="dialog" aria-label="Rechercher">
        <div class="q-in"><Icon Name="search" /><input @ref="input" value="@q" @oninput="Search" @onkeydown="e => Key(e, rows)" placeholder="Rechercher une session ou une action…" aria-label="Rechercher" /><kbd>Échap</kbd></div>
        @for (var i = 0; i < rows.Count; i++)
        {
            var r = rows[i];
            var on = i == sel;
            if (i == 0 && r.Session) { <div class="pg cap">Sessions</div> }
            if (!r.Session && (i == 0 || rows[i - 1].Session)) { <div class="pg cap">Actions</div> }
            <div class="pi @(on ? "on" : null)" @onclick="r.Run">
                @if (r.Session) { <span class="dot @r.Dot"></span> } else { <span class="ic"><Icon Name="@r.Dot" Sm /></span> }
                <div><div class="n">@Mark(r.Name)</div>@if (r.Detail is { Length: > 0 } d) { <div class="d">@d</div> }</div>
                <span class="r">
                    @if (r.Pill > 0) { <span class="pill wait">@r.Pill</span> }
                    @if (on && r.Session) { <kbd>⏎</kbd> }
                    else if (r.Kbd is { } k) { <kbd>@k</kbd> }
                    else { @r.Right }
                </span>
            </div>
        }
        @if (rows.Count == 0) { <div class="pg" style="color:var(--fg-4)">Aucun résultat</div> }
        <div class="pfoot"><span><kbd>↑</kbd> <kbd>↓</kbd> naviguer</span><span><kbd>⏎</kbd> ouvrir</span></div>
    </div>
}

@code {
    static readonly string[] Themes = ["graphite", "encre", "ristretto", "mousse", "contraste"];

    // Dot = dot class for a session, icon name for an action.
    sealed record Row(bool Session, string Name, string Dot, string? Detail, int Pill, string? Right, string? Kbd, Func<Task> Run);

    ElementReference input;
    string q = "", theme = "graphite";
    int sel;
    bool wasOpen, focus;

    List<Row> Rows()
    {
        var all = Sessions.All.Reverse()
            .Select(s => (Name: s.Name, s.Branch, s.Repo, Row: SessionRow(s)))
            .Concat(TranscriptStore.Recent().Where(p => Sessions.Get(p.Id) is null)
                .Select(p => (Name: p.Title, p.Branch, Repo: (string?)TranscriptStore.RepoName(p.Cwd), Row: PastRow(p))));
        var rows = all.Where(x => Hit(x.Name) || Hit(x.Branch) || Hit(x.Repo)).Take(q.Length > 0 ? 8 : 5).Select(x => x.Row).ToList();

        var cwd = CurrentCwd();
        var name = char.ToUpper(theme[0]) + theme[1..];
        Row[] actions =
        [
            new(false, cwd is null ? "Nouvelle session" : $"Nouvelle session dans {ClaudeCodeUI.Components.Pages.NewSession.Chip(cwd)}", "plus", null, 0, null, "Ctrl N",
                Go(cwd is null ? "" : $"?cwd={Uri.EscapeDataString(cwd)}")),
            new(false, "Vue d'ensemble", "grid", null, 0, null, "Ctrl ⇧ O", Go("overview")),
            new(false, $"Thème : {name}", "palette", null, 0, "changer…", null, NextTheme),
            new(false, "Worktrees", "branch", null, 0, null, null, Go("worktrees")),
            new(false, "Extensions", "plug", null, 0, null, null, Go("extensions")),
            new(false, "Apparence", "palette", null, 0, null, null, Go("settings/appearance")),
        ];
        rows.AddRange(actions.Where(a => Hit(a.Name)));
        return rows;
    }

    Row SessionRow(LiveSession s) => new(true, s.Name, RailSessionRow.Dot(s),
        Join(s.Branch, s.Repo, s.Status switch
        {
            SessionStatus.Waiting when s.Pending.FirstOrDefault() is { } p => $"attend · {p.Tool}",
            SessionStatus.Idle or SessionStatus.Exited when s.CostUsd >= 0.005m => Fmt.Cost(s.CostUsd, 2),
            _ => null,
        }),
        s.Status == SessionStatus.Waiting ? s.Pending.Count : 0,
        s.Status switch { SessionStatus.Running => "en cours", SessionStatus.Crashed => $"exit {s.ExitCode}", SessionStatus.Waiting => null, _ => "terminée" },
        null, Go($"session/{s.Id}"));

    Row PastRow(PastSession p) => new(true, p.Title, "idle",
        Join(p.Branch, TranscriptStore.RepoName(p.Cwd), Day(p.LastWrite), p.CostUsd >= 0.005m ? Fmt.Cost(p.CostUsd.Value, 2) : null),
        0, "terminée", null, () => { Sessions.Open(p); return Go($"session/{p.Id}")(); });

    static string Day(DateTimeOffset t) => (DateTime.Today - t.LocalDateTime.Date).Days switch
    {
        0 => Fmt.Time(t),
        1 => "hier",
        var d => $"il y a {d} j",
    };

    static string Join(params string?[] parts) => string.Join(" · ", parts.Where(p => !string.IsNullOrEmpty(p)));

    bool Hit(string? s) => q.Trim() is not { Length: > 0 } t || s?.Contains(t, StringComparison.OrdinalIgnoreCase) == true;

    // The first match wrapped in <mark>; every part HTML-encoded.
    MarkupString Mark(string s)
    {
        var t = q.Trim();
        var i = t.Length > 0 ? s.IndexOf(t, StringComparison.OrdinalIgnoreCase) : -1;
        var e = HtmlEncoder.Default;
        return new(i < 0 ? e.Encode(s) : $"{e.Encode(s[..i])}<mark>{e.Encode(s.Substring(i, t.Length))}</mark>{e.Encode(s[(i + t.Length)..])}");
    }

    // The session on screen, else the most recent one; a worktree cwd gives its repo.
    string? CurrentCwd()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri);
        var cwd = (path.StartsWith("session/") ? Sessions.Get(path[8..].Split('?', '#')[0])?.Cwd : null)
                  ?? Sessions.All.LastOrDefault()?.Cwd ?? TranscriptStore.Recent().FirstOrDefault()?.Cwd;
        return cwd is null ? null : TranscriptStore.RootOf(cwd);
    }

    Func<Task> Go(string url) => () =>
    {
        Ui.PaletteOpen = false;
        Nav.NavigateTo(url);
        return Task.CompletedTask;
    };

    async Task NextTheme()
    {
        theme = Themes[(Array.IndexOf(Themes, theme) + 1) % Themes.Length];
        await JS.InvokeVoidAsync("claudeUi.setTheme", theme);
    }

    void Search(ChangeEventArgs e)
    {
        q = e.Value as string ?? "";
        sel = 0;
    }

    async Task Key(KeyboardEventArgs e, List<Row> rows)
    {
        if (rows.Count == 0) return;
        switch (e.Key)
        {
            case "ArrowDown": sel = (sel + 1) % rows.Count; break;
            case "ArrowUp": sel = (sel + rows.Count - 1) % rows.Count; break;
            case "Enter": await rows[sel].Run(); break;
        }
    }

    async void Changed()
    {
        await InvokeAsync(async () =>
        {
            if (Ui.PaletteOpen && !wasOpen)
            {
                q = ""; sel = 0; focus = true;
                try { theme = await JS.InvokeAsync<string>("claudeUi.getTheme"); } catch (JSException) { }
            }
            wasOpen = Ui.PaletteOpen;
            StateHasChanged();
        });
    }

    void SessionsChanged() { if (Ui.PaletteOpen) InvokeAsync(StateHasChanged); }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!focus || !Ui.PaletteOpen) return;
        focus = false;
        await JS.InvokeVoidAsync("claudeUi.focus", input);
    }

    protected override void OnInitialized()
    {
        Ui.Changed += Changed;
        Sessions.Changed += SessionsChanged;
    }

    public void Dispose()
    {
        Ui.Changed -= Changed;
        Sessions.Changed -= SessionsChanged;
    }
}
