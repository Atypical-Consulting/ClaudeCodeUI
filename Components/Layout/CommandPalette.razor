@* Ctrl K: sessions (live + recent), message hits from past transcripts, and actions, filtered. Escape is handled by MainLayout.
   A modal combobox: the input owns focus and points at the active option; the app behind is inert while open. *@
@implements IDisposable
@using System.Text.Encodings.Web
@inject UiState Ui
@inject SessionManager Sessions
@inject NavigationManager Nav
@inject IJSRuntime JS

@if (Ui.PaletteOpen)
{
    var rows = Rows();
    sel = Math.Clamp(sel, 0, Math.Max(0, rows.Count - 1));
    <div class="scrim" @onclick="() => Ui.PaletteOpen = false"></div>
    <div class="palette" role="dialog" aria-modal="true" aria-label="@L["Rail.Search"]">
        <div class="q-in"><Icon Name="search" /><input @ref="input" value="@q" @oninput="Search" @onkeydown="e => Key(e, rows)" placeholder="@L["Palette.Placeholder"]" aria-label="@L["Rail.Search"]"
            role="combobox" aria-expanded="@(rows.Count > 0 ? "true" : "false")" aria-controls="pal-list" aria-autocomplete="list" aria-activedescendant="@(rows.Count > 0 ? $"pal-{sel}" : null)" /><kbd>@L["Key.Esc"]</kbd></div>
        <div id="pal-list" role="listbox" aria-label="@L["Rail.Search"]" @ref="list">
            @foreach (var (kind, gid, title) in new[] { (0, "pal-g-s", L["Palette.Sessions"]), (1, "pal-g-m", L["Palette.Messages"]), (2, "pal-g-a", L["Palette.Actions"]) })
            {
                if (!rows.Any(r => Kind(r) == kind)) continue;
                <div role="group" aria-labelledby="@gid">
                    <div class="pg cap" id="@gid" role="presentation">@title</div>
                    @for (var i = 0; i < rows.Count; i++)
                    {
                        if (Kind(rows[i]) != kind) continue;
                        var r = rows[i];
                        var on = i == sel;
                        <div id="pal-@i" class="pi @(on ? "on" : null)" role="option" aria-selected="@(on ? "true" : "false")" @onclick="r.Run">
                            @if (r.Session) { <span class="dot @r.Dot"></span> } else { <span class="ic"><Icon Name="@r.Dot" Sm /></span> }
                            <div><div class="n">@Mark(r.Name)</div>@if (r.Detail is { Length: > 0 } d) { <div class="d">@d</div> }</div>
                            <span class="r">
                                @if (r.Pill > 0) { <span class="pill wait">@r.Pill</span> }
                                @if (on && r.Session) { <kbd>⏎</kbd> }
                                else if (r.Kbd is { } k) { <kbd>@k</kbd> }
                                else { @r.Right }
                            </span>
                        </div>
                    }
                </div>
            }
        </div>
        <div role="status">
            @if (searching) { <div class="pg" style="color:var(--fg-4)">@L["Palette.SearchingMessages"]</div> }
            else if (rows.Count == 0) { <div class="pg" style="color:var(--fg-4)">@L["Palette.NoResults"]</div> }
            else if (partial) { <div class="pg" style="color:var(--fg-4)">@L["Palette.OlderNotSearched"]</div> }
        </div>
        <div class="pfoot"><span><kbd>↑</kbd> <kbd>↓</kbd> @L["Palette.Navigate"]</span><span><kbd>⏎</kbd> @L["Palette.Open"]</span></div>
    </div>
}

@code {
    static readonly string[] Themes = ["graphite", "encre", "ristretto", "mousse", "contraste"];

    // Dot = dot class for a session, icon name for an action. Msg = a message hit (Name is its snippet).
    sealed record Row(bool Session, string Name, string Dot, string? Detail, int Pill, string? Right, string? Kbd, Func<Task> Run, bool Msg = false);

    static int Kind(Row r) => r.Msg ? 1 : r.Session ? 0 : 2;   // display order = rows order, so ↑/↓ follow the screen

    // Message search: from MinChars, debounced, cancelled by the next keystroke or by closing, scanned off the circuit's thread.
    const int MinChars = 3, MaxHits = 20;
    IReadOnlyList<TranscriptHit> hits = [];
    bool searching, partial;
    CancellationTokenSource? cts;

    ElementReference input, list;
    string q = "", theme = "graphite";
    int sel;
    bool wasOpen;
    bool? modal;   // the open/close transition claudeUi.modal still has to apply after the render

    List<Row> Rows()
    {
        // Sessions that need you first (waiting, then running), newest first within each.
        var all = Sessions.Active.Reverse().OrderBy(s => s.Status switch { SessionStatus.Waiting => 0, SessionStatus.Running => 1, _ => 2 })
            .Select(s => (Name: s.Name, s.Branch, s.Repo, Row: SessionRow(s)))
            .Concat(TranscriptStore.Recent().Where(p => !Sessions.IsActive(p.Id))
                .Select(p => (Name: p.Title, p.Branch, Repo: (string?)TranscriptStore.RepoName(p.Cwd), Row: PastRow(p))));
        var rows = all.Where(x => Hit(x.Name) || Hit(x.Branch) || Hit(x.Repo)).Take(q.Length > 0 ? 8 : 5).Select(x => x.Row).ToList();
        rows.AddRange(hits.Select(h => new Row(true, h.Snippet, Sessions.Get(h.Session.Id) is { } live ? RailSessionRow.Dot(live) : "exited",
            Join(h.Session.Title, TranscriptStore.RepoName(h.Session.Cwd)), 0, Day(h.At), null, PastRow(h.Session).Run, Msg: true)));

        var cwd = CurrentCwd();
        var next = Sessions.DecisionQueue.FirstOrDefault().S;
        var here = CurrentId() is { } cur ? Sessions.Get(cur) : null;
        Row[] actions =
        [
            .. next is null ? [] : new Row[] { new(false, L["Palette.NextDecision"], "shield", next.Name, Sessions.DecisionQueue.Count(), null, Strings.Kbd("Ctrl ⇧ A"), Go($"session/{next.Id}")) },
            .. here is { CanFork: true } ? new Row[] { new(false, L["Session.Fork"], "branch", here.Name, 0, null, null, () => Go($"session/{Sessions.Fork(here).Id}")()) } : [],
            new(false, cwd is null ? L["Rail.NewSession"] : L["Palette.NewSessionIn", ClaudeCodeUI.Components.Pages.NewSession.Chip(cwd)], "plus", null, 0, null, Strings.Kbd("Alt N"),
                Go(cwd is null ? "" : $"?cwd={Uri.EscapeDataString(cwd)}")),
            new(false, L["Nav.Overview"], "grid", null, 0, null, Strings.Kbd("Ctrl ⇧ O"), Go("overview")),
            .. CurrentId() is { } id && Sessions.IsActive(id) ? [new Row(false, L["Session.Stop"], "x", Sessions.Get(id)!.Name, 0, null, null, () => StopSession(id))] : Array.Empty<Row>(),
            new(false, L["Palette.Theme", L["Theme." + theme]], "palette", null, 0, L["Palette.ChangeTheme"], null, NextTheme),
            new(false, L["Nav.Worktrees"], "branch", null, 0, null, null, Go("worktrees")),
            new(false, L["Nav.Extensions"], "plug", null, 0, null, null, Go("extensions")),
            new(false, L["Nav.Appearance"], "palette", null, 0, null, null, Go("settings/appearance")),
            .. Shell.Desktop ? [new Row(false, L["Appearance.UpdateCheck"], "refresh", null, 0, Shell.Version, null, CheckForUpdates)] : Array.Empty<Row>(),
        ];
        rows.AddRange(actions.Where(a => Hit(a.Name)));
        return rows;
    }

    Row SessionRow(LiveSession s) => new(true, s.Name, RailSessionRow.Dot(s),
        Join(s.Branch, s.Repo, s.Status switch
        {
            SessionStatus.Waiting when s.Pending.FirstOrDefault() is { } p => L["Status.WaitingOn", p.Tool],
            SessionStatus.Idle or SessionStatus.Exited when s.CostUsd >= 0.005m => Fmt.Cost(s.CostUsd, 2),
            _ => null,
        }),
        s.Status == SessionStatus.Waiting ? s.Pending.Count : 0,
        s.Status switch { SessionStatus.Running => L["Status.Running"], SessionStatus.Crashed => s.ExitLabel, SessionStatus.Waiting => null, _ => L["Status.Done"] },
        null, Go($"session/{s.Id}"));

    Row PastRow(PastSession p) => new(true, p.Title, "exited",
        Join(p.Branch, TranscriptStore.RepoName(p.Cwd), Day(p.LastWrite), p.CostUsd >= 0.005m ? Fmt.Cost(p.CostUsd.Value, 2) : null),
        0, Sessions.RunningElsewhere(p.Id) ? L["Status.Elsewhere"] : L["Status.History"], null, () => { Sessions.Open(p); return Go($"session/{p.Id}")(); });

    string Day(DateTimeOffset t) => (DateTime.Today - t.LocalDateTime.Date).Days switch
    {
        0 => Fmt.Time(t),
        1 => L["Day.Yesterday"],
        var d => L["Day.Ago", d],
    };

    static string Join(params string?[] parts) => string.Join(" · ", parts.Where(p => !string.IsNullOrEmpty(p)));

    bool Hit(string? s) => q.Trim() is not { Length: > 0 } t || s?.Contains(t, StringComparison.OrdinalIgnoreCase) == true;

    // The first match wrapped in <mark>; every part HTML-encoded.
    MarkupString Mark(string s)
    {
        var t = q.Trim();
        var i = t.Length > 0 ? s.IndexOf(t, StringComparison.OrdinalIgnoreCase) : -1;
        var e = HtmlEncoder.Default;
        return new(i < 0 ? e.Encode(s) : $"{e.Encode(s[..i])}<mark>{e.Encode(s.Substring(i, t.Length))}</mark>{e.Encode(s[(i + t.Length)..])}");
    }

    string? CurrentId() => Nav.ToBaseRelativePath(Nav.Uri) is var path && path.StartsWith("session/") ? path[8..].Split('?', '#')[0] : null;

    // The session on screen, else the most recent one; a worktree cwd gives its repo.
    string? CurrentCwd()
    {
        var cwd = (CurrentId() is { } id ? Sessions.Get(id)?.Cwd : null)
                  ?? Sessions.All.LastOrDefault()?.Cwd ?? TranscriptStore.Recent().FirstOrDefault()?.Cwd;
        return cwd is null ? null : TranscriptStore.RootOf(cwd);
    }

    Func<Task> Go(string url) => () =>
    {
        Ui.PaletteOpen = false;
        Nav.NavigateTo(url);
        return Task.CompletedTask;
    };

    async Task StopSession(string id)
    {
        Ui.PaletteOpen = false;
        await Sessions.Stop(id);
        Nav.NavigateTo("overview");
    }

    Task CheckForUpdates()
    {
        Ui.PaletteOpen = false;
        Shell.CheckForUpdates();
        return Task.CompletedTask;
    }

    async Task NextTheme()
    {
        theme = Themes[(Array.IndexOf(Themes, theme) + 1) % Themes.Length];
        await JS.InvokeVoidAsync("claudeUi.setTheme", theme);
    }

    void Search(ChangeEventArgs e)
    {
        q = e.Value as string ?? "";
        sel = 0;
        _ = FindMessages(q.Trim());
    }

    async Task FindMessages(string t)
    {
        cts?.Cancel();
        (hits, partial, searching) = ([], false, t.Length >= MinChars);
        if (!searching) return;
        var c = cts = new CancellationTokenSource();
        try
        {
            await Task.Delay(250, c.Token);
            var (found, complete) = await Task.Run(() => TranscriptStore.Search(t, MaxHits, c.Token), c.Token);
            if (c.IsCancellationRequested) return;   // a newer keystroke or closing won the race
            (hits, partial, searching) = (found, !complete, false);
            StateHasChanged();
        }
        catch (OperationCanceledException) { }
    }

    async Task Key(KeyboardEventArgs e, List<Row> rows)
    {
        if (rows.Count == 0) return;
        switch (e.Key)
        {
            case "ArrowDown": sel = (sel + 1) % rows.Count; break;
            case "ArrowUp": sel = (sel + rows.Count - 1) % rows.Count; break;
            case "Enter": await rows[sel].Run(); break;
        }
    }

    void Changed() => _ = InvokeAsync(async () =>
    {
        if (Ui.PaletteOpen && !wasOpen)
        {
            q = ""; sel = 0; modal = true;
            await FindMessages("");
            try { theme = await JS.InvokeAsync<string>("claudeUi.getTheme"); }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException) { }
        }
        else if (!Ui.PaletteOpen && wasOpen)
        {
            modal = false;
            cts?.Cancel();
        }
        wasOpen = Ui.PaletteOpen;
        StateHasChanged();
    });

    void SessionsChanged() { if (Ui.PaletteOpen) InvokeAsync(StateHasChanged); }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (modal is { } open)
        {
            modal = null;
            await JS.InvokeVoidAsync("claudeUi.modal", open, input);
        }
        if (Ui.PaletteOpen) await JS.InvokeVoidAsync("claudeUi.reveal", list, $"pal-{sel}");
    }

    protected override void OnInitialized()
    {
        Ui.Changed += Changed;
        Sessions.Changed += SessionsChanged;
    }

    public void Dispose()
    {
        Ui.Changed -= Changed;
        Sessions.Changed -= SessionsChanged;
        cts?.Cancel();
    }
}
