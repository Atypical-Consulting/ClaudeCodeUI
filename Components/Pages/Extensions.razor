@page "/extensions"
@implements IDisposable
@inject SessionManager Sessions
@inject UiState Ui
@inject NavigationManager Nav

<PageTitle>@L["Nav.Extensions"] · Claude Code</PageTitle>

<div class="pane">
    <div class="ph"><h1 class="ttl">@L["Nav.Extensions"]</h1>@if (Live is { } lv)
        {
            var others = Sessions.All.Where(x => x.HasProcess || x == lv).ToList();
            <span class="sub" title="@Slash(lv.Cwd)">@if (others.Count > 1)
                {
                    <select aria-label="@L["Ext.Session"]" value="@lv.Id" @onchange="e => Nav.NavigateTo(Link(e.Value?.ToString()))">
                        @foreach (var o in others)
                        {
                            <option value="@o.Id">@o.Name · @Fmt.Home(o.Cwd)</option>
                        }
                    </select>
                }
                else
                {
                    <a href="@($"session/{lv.Id}")">@lv.Name</a>@(" · " + Fmt.Home(lv.Cwd))
                }</span>
        }
        else if (Past is { } past)
        {
            <span class="sub" title="@Slash(past.Cwd)">@past.Title@(" · " + Fmt.Home(past.Cwd))</span>
        }</div>
    <div class="ext">
        @if (Live is not { } s)
        {
            var known = Past is not null;
            var open = Sessions.All.Where(x => x.HasProcess).ToList();
            <div><h2>@L["Nav.Extensions"]</h2><p class="lead">@(SessionQuery is not { Length: > 0 } ? L["Ext.NoSession"] : known ? L["Ext.SessionGoneOf", Past!.Title] : L["Ext.SessionUnknown"])</p>
                <div class="acts">@if (known)
                    {
                        <a class="btn primary" href="@($"session/{Uri.EscapeDataString(SessionQuery!)}")">@L["Ext.OpenSession"]</a>
                        <a class="btn" href=""><Icon Name="plus" Sm />@L["Rail.NewSession"]</a>
                    }
                    else if (open.Count > 0)
                    {
                        @foreach (var o in open)
                        {
                            <a class="btn" href="@Link(o.Id)" title="@Slash(o.Cwd)">@L["Ext.ShowFor", o.Name]</a>
                        }
                    }
                    else
                    {
                        <a class="btn primary" href=""><Icon Name="plus" Sm />@L["Rail.NewSession"]</a>
                    }</div></div>
            <h3>@L["Ext.Plugins.ForHome"]</h3>
            <p class="d hint">@L["Ext.Plugins.NoSessionNote"]</p>
            @PluginsTab(null, Home, null, null)
        }
        else
        {
            var servers = Servers(s);
            var skills = s.Init?.Skills ?? skillsRead;
            var agents = Agents(s);
            <div><h2>@L["Nav.Extensions"]</h2><p class="lead">@L["Ext.Lead"]</p></div>
            <div class="subtabs" role="tablist" aria-label="@L["Nav.Extensions"]">
                @Tab("mcp", "MCP", s.HasProcess || s.McpStatus is not null ? servers.Count : null)
                @Tab("skills", L["Ext.Tab.Skills"], skills?.Length)
                @Tab("agents", L["Ext.Tab.Agents"], s.InitializeInfo is null && s.Init is null ? null : agents.Count)
                @Tab("plugins", L["Ext.Tab.Plugins"], installed?.Count)
                @Tab("hooks", L["Ext.Tab.Hooks"], hooks?.Rows.Count)
                @Tab("permissions", L["Ext.Tab.Permissions"], perms?.Rules.Count)
            </div>
            <div id="ext-panel" role="tabpanel" aria-labelledby="ext-tab-@tab">
            @if (!s.HasProcess && tab != "plugins")
            {
                <p class="lead" role="status">@(s.ExitCode is { } code ? L["Ext.NoProcessExited", code] : L["Ext.NoProcess"])</p>
                <div class="acts"><button class="btn primary" disabled="@busy" @onclick="() => Start(s)"><Icon Name="zap" Sm />@L["Ext.StartProcess"]</button></div>
            }
            else if (tab == "mcp")
            {
                @if (note is not null)
                {
                    <div class="errbox" role="alert">@note</div>
                }
                <div class="filters">
                    @Filter("", L["Filter.All"], servers.Count)
                    @foreach (var (st, lbl) in new[] { ("connected", "Ext.Filter.Connected"), ("needs-auth", "Ext.Filter.Auth"), ("failed", "Ext.Filter.Failed"), ("disabled", "Ext.Filter.Disabled") })
                    {
                        var c = servers.Count(x => x.Status == st);
                        if (c > 0 || filter == st) { @Filter(st, L[lbl], c) }
                    }
                    @if (servers.Count(x => x.Status == "failed") > 1)
                    {
                        <button class="btn" disabled="@busy" @onclick="() => ReconnectAll(s, servers)"><Icon Name="refresh" Sm />@L["Ext.RetryAll"]</button>
                    }
                </div>
                @foreach (var skipped in s.Init?.McpErrors ?? [])
                {
                    <div class="errbox" role="status">@L["Ext.Skipped", skipped.Name, skipped.Message]</div>
                }
                @if (servers.Any(x => x.Status is "connected" or "disabled"))
                {
                    <p class="d hint">@L["Ext.SwitchesHint"]</p>
                }
                var shownRows = servers.Where(x => filter == "" || x.Status == filter).ToList();
                var stop = shownRows.FirstOrDefault(x => x.Name == selected)?.Name ?? shownRows.FirstOrDefault()?.Name;
                <table class="mcp servers" aria-label="@L["Ext.McpTable"]">
                    <thead><tr><th>@L["Ext.Col.Server"]</th><th>@L["Col.State"]</th><th class="num tools" title="@L["Ext.ToolsHint"]">@L["Col.Tools"]</th><th class="num"><span class="vh">@L["Ext.Col.Actions"]</span></th></tr></thead>
                    <tbody>
                        @foreach (var m in shownRows)
                        {
                            var rt = m.Name == stop ? 0 : -1;
                            <tr @key="m.Name" data-r class="@(m.Name == selected ? "sel" : null)" tabindex="@rt" aria-selected="@(m.Name == selected ? "true" : "false")" @onclick="() => Select(m.Name)" @onkeydown='e => { if (e.Key is "Enter" or " ") Select(m.Name); }'>
                                <td><div class="n" title="@m.Short">@m.Short</div><div class="d" title="@m.Origin">@m.Origin</div></td>
                                <td>@State(m.Status)</td>
                                <td class="num tools">@(m.Status == "failed" ? m.Tools?.Length ?? 0 : m.Status == "connected" ? m.Tools?.Length.ToString() ?? "—" : "—")</td>
                                <td class="num rowacts" @onclick:stopPropagation>
                                    @switch (m.Status)
                                    {
                                        case "failed":
                                            <button class="btn" tabindex="@rt" disabled="@busy" aria-label="@($"{L["Ext.Retry"]}: {m.Short}")" @onclick="() => Reconnect(s, m.Name)">@L["Ext.Retry"]</button>
                                            break;
                                        case "needs-auth" when SignsInHere(m):
                                            <button class="btn" tabindex="@rt" disabled="@busy" aria-label="@($"{L["Ext.SignIn"]}: {m.Short}")" @onclick="() => SignIn(s, m.Name)">@L["Ext.SignIn"]</button>
                                            break;
                                        case "connected" or "disabled":
                                            var on = m.Status == "connected";
                                            <button class="toggle @(on ? "on" : null)" tabindex="@rt" role="switch" aria-checked="@(on ? "true" : "false")" aria-label="@($"{L["Ext.EnableHere"]}: {m.Short}")" title="@L["Ext.EnableHereHint"]"
                                                    disabled="@busy" @onclick="() => Toggle(s, m.Name, !on)"><span class="sw"></span></button>
                                            break;
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (shownRows.Count == 0)
                {
                    <p class="lead">@L["Ext.FilterEmpty"]</p>
                }
                else
                {
                    <p class="keys">@L["Ext.KeysMcp"]</p>
                }
            }
            else if (tab == "hooks")
            {
                <p class="lead">@((MarkupString)L["Ext.Hooks.Lead", $"<code title=\"{Fmt.Enc(Slash(s.Cwd))}\">{Fmt.Enc(Fmt.Home(s.Cwd))}</code>"].Value)</p>
                @if (hooksNote is not null)
                {
                    <div class="errbox" role="alert">@hooksNote</div>
                }
                else if (hooks is { Disabled: true })
                {
                    <div class="errbox" role="status">@L["Ext.Hooks.Disabled"]</div>
                }
                @if (hooks is { Locked: true })
                {
                    <div class="errbox" role="status">@L["Ext.Hooks.Locked"]</div>
                }
                @if (hooks is { Rows.Count: 0 })
                {
                    <p class="lead">@L["Ext.Hooks.None"]</p>
                }
                else if (hooks is { } hl)
                {
                    var hrows = hl.Rows.Where(h => Matches($"{h.Event} {(h.Matcher.Length > 0 ? h.Matcher : L["Ext.Hooks.AnyMatcher"])} {h.Plugin ?? SourceTag(h.Source)}", h.Command)).ToList();
                    @FindBox(hrows.Count, hl.Rows.Count)
                    @if (hrows.Count == 0)
                    {
                        <p class="lead">@L["Ext.FindEmpty"]</p>
                    }
                    else
                    {
                    var anyEdit = hrows.Any(h => h.Edit is not null && !hl.Locked && PermissionRules.Files.Contains(h.Source));
                    <table class="mcp hooktab @(anyEdit ? null : "ro")" aria-label="@L["Ext.Tab.Hooks"]">
                        <thead><tr><th>@L["Ext.Col.Event"]</th><th>@L["Ext.Col.Matcher"]</th><th>@L["Ext.Col.Command"]</th><th class="num"><span class="vh">@L["Ext.Col.Actions"]</span></th></tr></thead>
                        <tbody>
                            @{ var hstop = StopOf(hrows.Select(HookKey)); }
                            @foreach (var h in hrows)
                            {
                                var meta = string.Join(" · ", new[] { h.Type, h.Timeout is { } t ? $"{t} s" : null, h.Display }.Where(x => !string.IsNullOrEmpty(x)));
                                var hkey = HookKey(h);
                                var rt = hkey == hstop ? 0 : -1;
                                <tr data-r tabindex="@rt" @onfocusin="() => cursor = hkey" class="@(h == hookEditing ? "sel" : null)">
                                    <td><div class="n">@h.Event</div><span class="tag" title="@(h.Plugin is null ? h.SourceLabel : null)">@SourceTag(h.Source)</span>@if (h.Plugin is { } hp)
                                        {
                                            <span class="d id" title="@hp">@hp</span>
                                        }@if (h.Disabled)
                                        {
                                            <span class="tag">@L["Ext.Hooks.RowDisabled"]</span>
                                        }</td>
                                    <td>@if (h.Matcher.Length > 0)
                                        {
                                            <code>@Breaks(h.Matcher, '|')</code>
                                        }
                                        else
                                        {
                                            <span class="d">@L["Ext.Hooks.AnyMatcher"]</span>
                                        }</td>
                                    <td><code class="hookcmd">@Breaks(h.Command, '/')</code><div class="d">@meta</div>@if (h.BlocksOnFailure)
                                        {
                                            <span class="tag" title="@L["Ext.Hooks.BlocksHint"]">@L["Ext.Hooks.Blocks"]</span>
                                        }</td>
                                    <td class="num rowacts">@if (h.Edit is not null && !hl.Locked && PermissionRules.Files.Contains(h.Source))
                                        {
                                            @if (h.Type == "command")
                                            {
                                                <button class="btn ghost" tabindex="@rt" disabled="@busy" aria-label="@L["Ext.Hooks.EditRow", HookName(h), h.Command]" @onclick="() => EditHook(h)">@L["Ext.Hooks.Edit"]</button>
                                            }
                                            var hk = "h:" + HookKey(h);
                                            <button class="btn arm @(confirm == hk ? "danger" : "ghost")" tabindex="@rt" disabled="@busy" aria-label="@(confirm == hk ? L["Ext.ConfirmRemoveOf", $"{HookName(h)} {h.Command}"] : L["Ext.Hooks.RemoveRow", HookName(h), h.Command])" @onclick='() => Armed(hk, () => SaveHook(s, h, true))' @onblur="Disarm">@(confirm == hk ? L["Ext.ConfirmRemove"] : L["Ext.Perm.Remove"])</button>
                                        }
                                        else if (h.Plugin is not null)
                                        {
                                            <span class="d">@L["Ext.Hooks.FromPlugin"]</span>
                                        }</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <p class="keys">@L["Ext.KeysRows"]</p>
                    }
                }
                @if (hooks is { Locked: false, Catalog.Count: > 0 } hf)
                {
                    var ev = hf.Catalog.FirstOrDefault(x => x.Name == hookEvent) ?? hf.Catalog[0];
                    <div class="field">
                        <span class="lbl" id="hook-form-cap">@(hookEditing is null ? L["Ext.Hooks.AddTitle"] : L["Ext.Hooks.EditTitle"])</span>
                        <div class="picks" role="group" aria-labelledby="hook-form-cap">
                            <select aria-label="@L["Ext.Col.Event"]" @bind="hookEvent" disabled="@busy" title="@ev.Summary">
                                @foreach (var c in hf.Catalog)
                                {
                                    <option value="@c.Name">@c.Name</option>
                                }
                            </select>
                            <div class="input"><input aria-label="@L["Ext.Col.Matcher"]" @bind="hookMatcher" @bind:event="oninput" placeholder="@(ev.Matcher ? "Bash|Write" : L["Ext.Hooks.NoMatcher"])"
                                                      disabled="@(busy || !ev.Matcher)" spellcheck="false" autocomplete="off" /></div>
                            @if (hookEditing is null)
                            {
                                <select aria-label="@L["Perm.SaveIn"]" @bind="hookFile" disabled="@busy">
                                    @foreach (var src in PermissionRules.Files)
                                    {
                                        <option value="@src">@L["Perm.Dest." + src]</option>
                                    }
                                </select>
                            }
                        </div>
                        <div class="input"><input aria-label="@L["Ext.Col.Command"]" @bind="hookCommand" @bind:event="oninput" placeholder="npm run lint" spellcheck="false" autocomplete="off" disabled="@busy"
                                                  @onkeydown='async e => { if (e.Key == "Enter") await SaveHook(s, hookEditing, false); }' /></div>
                        <div class="picks">
                            <div class="input"><input type="number" min="1" aria-label="@L["Ext.Hooks.Timeout"]" placeholder="@L["Ext.Hooks.Timeout"]" @bind="hookTimeout" disabled="@busy" /></div>
                            <label class="toggle"><input type="checkbox" @bind="hookBlock" disabled="@busy" />@L["Ext.Hooks.Block"]</label>
                            <button class="btn primary" disabled="@(busy || hookCommand.Trim().Length == 0)" @onclick="() => SaveHook(s, hookEditing, false)"><Icon Name="@(hookEditing is null ? "plus" : "check")" Sm />@(hookEditing is null ? L["Ext.Hooks.AddButton"] : L["Ext.Hooks.SaveButton"])</button>
                            @if (hookEditing is not null)
                            {
                                <button class="btn" @onclick="ResetHookForm">@L["Action.Cancel"]</button>
                            }
                        </div>
                    </div>
                }
            }
            else if (tab == "permissions")
            {
                <p class="lead">@((MarkupString)L["Ext.Perm.Lead", $"<code title=\"{Fmt.Enc(Slash(s.Cwd))}\">{Fmt.Enc(Fmt.Home(s.Cwd))}</code>"].Value)</p>
                @if (permsNote is not null)
                {
                    <div class="errbox" role="alert">@permsNote</div>
                }
                @if (perms is { ManagedOnly: true })
                {
                    <div class="errbox" role="status">@L["Ext.Perm.ManagedOnly"]</div>
                }
                @foreach (var err in perms?.Errors ?? [])
                {
                    <div class="errbox" role="status">@L["Ext.Perm.FileError", err]</div>
                }
                @if (perms is { } ps)
                {
                    <div class="filters">
                        @Filter("", L["Filter.All"], ps.Rules.Count)
                        @foreach (var b in PermissionRules.Behaviors)
                        {
                            var c = ps.Rules.Count(r => r.Behavior == b);
                            if (c > 0 || filter == b) { @Filter(b, L["Ext.Perm." + b], c) }
                        }
                    </div>
                    @if (ps.Rules.Count == 0)
                    {
                        <p class="lead">@L["Ext.Perm.None"]</p>
                    }
                    else
                    {
                        <table class="mcp" aria-label="@L["Ext.Tab.Permissions"]">
                            <thead><tr><th>@L["Ext.Col.Rule"]</th><th>@L["Ext.Col.Behavior"]</th><th>@L["Ext.Col.Source"]</th><th class="num"><span class="vh">@L["Ext.Col.Actions"]</span></th></tr></thead>
                            <tbody>
                                @{ var shownRules = ps.Rules.Where(x => filter == "" || x.Behavior == filter).ToList(); var pstop = StopOf(shownRules.Select(r => "r:" + r.Source + "|" + r.Behavior + "|" + r.Rule)); }
                                @foreach (var r in shownRules)
                                {
                                    var rk = "r:" + r.Source + "|" + r.Behavior + "|" + r.Rule;
                                    var rt = rk == pstop ? 0 : -1;
                                    <tr data-r tabindex="@rt" @onfocusin="() => cursor = rk">
                                        <td><div class="n"><code>@PermissionRules.Visible(r.Rule)</code></div>@if (r.Text is var (pre, emph, suf))
                                            {
                                                <div class="d">@pre<b>@PermissionRules.Visible(emph)</b>@suf</div>
                                            }</td>
                                        <td><span class="tag">@L["Ext.Perm." + r.Behavior]</span></td>
                                        <td><span class="tag">@SourceTag(r.Source)</span>@if (r.NotInEffect)
                                            {
                                                <div class="d">@L["Ext.Perm.NotInEffect"]</div>
                                            }</td>
                                        <td class="num rowacts">@if (r.Editable)
                                            {
                                                <button class="btn arm @(confirm == rk ? "danger" : "ghost")" tabindex="@rt" disabled="@busy" aria-label="@(confirm == rk ? L["Ext.ConfirmRemoveOf", r.Rule] : L["Ext.Perm.RemoveRule", r.Rule])" @onclick='() => Armed(rk, () => EditRule(s, r.Source, r.Behavior, r.Rule, false))' @onblur="Disarm">@(confirm == rk ? L["Ext.ConfirmRemove"] : L["Ext.Perm.Remove"])</button>
                                            }</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <p class="keys">@L["Ext.KeysRows"]</p>
                    }
                    <div class="field">
                        <label for="perm-rule">@L["Ext.Perm.Add"]</label>
                        <div class="input"><input id="perm-rule" @bind="ruleDraft" @bind:event="oninput" @onkeydown='async e => { if (e.Key == "Enter") await EditRule(s, ruleFile, ruleBehavior, ruleDraft.Trim(), true); }'
                                                  placeholder="Bash(npm run test:*)" spellcheck="false" autocomplete="off" disabled="@busy" /></div>
                    </div>
                    <div class="picks">
                        <select aria-label="@L["Ext.Col.Behavior"]" @bind="ruleBehavior" disabled="@busy">
                            @foreach (var b in PermissionRules.Behaviors)
                            {
                                <option value="@b">@L["Ext.Perm." + b]</option>
                            }
                        </select>
                        <select aria-label="@L["Perm.SaveIn"]" @bind="ruleFile" disabled="@busy">
                            @foreach (var src in PermissionRules.Files)
                            {
                                <option value="@src">@L["Perm.Dest." + src]</option>
                            }
                        </select>
                        <button class="btn primary" disabled="@(busy || ruleDraft.Trim().Length == 0)" @onclick="() => EditRule(s, ruleFile, ruleBehavior, ruleDraft.Trim(), true)"><Icon Name="plus" Sm />@L["Ext.Perm.AddButton"]</button>
                    </div>
                    @if (ps.Dirs.Count > 0)
                    {
                        <div><span class="cap">@L["Dirs.Label"]</span>
                            <ul class="dirs">
                                @foreach (var (path, src) in ps.Dirs)
                                {
                                    <li class="chip" title="@Slash(path)"><Icon Name="folder" Sm />@Fmt.Home(path) <span class="tag">@SourceTag(src)</span></li>
                                }
                            </ul>
                        </div>
                    }
                }
            }
            else if (tab == "plugins")
            {
                @PluginsTab(s, s.Cwd, servers, skills)
            }
            else if (tab == "skills" && skills is null)
            {
                <p class="lead" role="status">@L["Ext.Plugins.Loading"]</p>
            }
            else if (tab == "skills")
            {
                var sk = skills!.Select(k => (Name: k, Desc: Describe(s, k))).Where(x => Matches(x.Name, x.Desc)).ToList();
                var kstop = StopOf(sk.Select(x => x.Name));
                @FindBox(sk.Count, skills!.Length)
                @if (sk.Count == 0)
                {
                    <p class="lead">@L["Ext.FindEmpty"]</p>
                }
                else
                {
                    <table class="mcp" aria-label="@L["Ext.Tab.Skills"]">
                        <thead><tr><th>@L["Ext.Col.Skill"]</th><th>@L["Ext.Col.Description"]</th></tr></thead>
                        <tbody>
                            @foreach (var (name, d) in sk)
                            {
                                var (text, origin) = SplitSource(d);
                                var op = expanded.Contains("k:" + name);
                                <tr data-r tabindex="@(name == kstop ? 0 : -1)" class="@(op ? "open" : null)" aria-expanded="@(op ? "true" : "false")" @onfocusin="() => cursor = name"
                                    @onclick='() => Expand("k:" + name)' @onkeydown='e => { if (e.Key is "Enter" or " ") Expand("k:" + name); }'>
                                    <td><div class="n id">@name</div>@if (origin is not null && !name.Contains(':'))
                                        {
                                            <span class="tag">@origin</span>
                                        }</td><td><span class="last prose clamp">@(text ?? "—")</span></td></tr>
                            }
                        </tbody>
                    </table>
                    <p class="keys">@L["Ext.KeysExpand"]</p>
                }
            }
            else if (tab == "agents")
            {
                var ag = agents.Where(a => Matches(a.Name, a.Desc)).ToList();
                var astop = StopOf(ag.Select(a => a.Name));
                @FindBox(ag.Count, agents.Count)
                @if (ag.Count == 0)
                {
                    <p class="lead">@L["Ext.FindEmpty"]</p>
                }
                else
                {
                <table class="mcp" aria-label="@L["Ext.Tab.Agents"]">
                    <thead><tr><th>@L["Agent.Title"]</th><th>@L["Ext.Col.Description"]</th><th>@L["Model"]</th></tr></thead>
                    <tbody>
                        @foreach (var (name, desc, model) in ag)
                        {
                            var op = expanded.Contains("a:" + name);
                            <tr data-r tabindex="@(name == astop ? 0 : -1)" class="@(op ? "open" : null)" aria-expanded="@(op ? "true" : "false")" @onfocusin="() => cursor = name"
                                @onclick='() => Expand("a:" + name)' @onkeydown='e => { if (e.Key is "Enter" or " ") Expand("a:" + name); }'><td><div class="n id">@name</div></td><td><span class="last prose clamp">@(desc ?? "—")</span></td><td><span class="tag">@(model ?? "—")</span></td></tr>
                        }
                    </tbody>
                </table>
                <p class="keys">@L["Ext.KeysExpand"]</p>
                }
            }
            </div>
        }
    </div>
</div>

@if (Ui.InspectorOpen && tab == "mcp" && Live is { } ls && Servers(ls).FirstOrDefault(x => x.Name == selected) is { } sel)
{
    <aside class="pane insp" aria-label="@L["Inspector"]">
        <div class="ph"><h2 class="ttl" title="@sel.Short">@sel.Short</h2><span class="sub">@sel.Origin</span>@CloseInspector()</div>
        @if (sel.Status == "failed")
        {
            <div class="section">
                <h3>@L["Ext.FailedTitle"]</h3>
                @if (sel.Error is { } err)
                {
                    <div class="errbox">@err.TrimEnd()</div>
                }
                <p>@L["Ext.FailedText"] @FailedWhere(sel)</p>
                <div class="acts">
                    <button class="btn primary" disabled="@busy" @onclick="() => Reconnect(ls, sel.Name)"><Icon Name="refresh" Sm="true" />@L["Ext.Retry"]</button>
                    <button class="btn ghost" disabled="@busy" title="@L["Ext.EnableHereHint"]" @onclick="() => Toggle(ls, sel.Name, false)">@L["Ext.TurnOff"]</button>
                </div>
            </div>
        }
        else if (sel.Status == "needs-auth")
        {
            <div class="section">
                <h3>@L["Ext.AuthTitle"]</h3>
                <p>@L["Ext.AuthText"]</p>
                @if (!SignsInHere(sel))
                {
                    <p>@L["Ext.AuthHow"]</p>
                }
                else
                {
                    @if (auth is { } a && a.Server == sel.Name)
                    {
                        <p role="status">@L["Ext.AuthWaiting"]</p>
                        <div class="acts"><a class="btn primary" href="@a.Url" target="_blank" rel="noopener noreferrer" @ref="authLink">@L["Ext.OpenSignIn"]</a></div>
                    }
                    else
                    {
                        <div class="acts"><button class="btn primary" disabled="@busy" @onclick="() => SignIn(ls, sel.Name)"><Icon Name="plug" Sm="true" />@L["Ext.SignIn"]</button></div>
                    }
                    <p>@L["Ext.AuthHowAlt"]</p>
                }
                <div class="acts"><code>/mcp</code><button type="button" class="btn" data-copy="/mcp"><Icon Name="copy" Sm />@L["Md.Copy"]</button></div>
                <div class="acts"><button class="btn ghost" disabled="@busy" title="@L["Ext.EnableHereHint"]" @onclick="() => Toggle(ls, sel.Name, false)">@L["Ext.TurnOff"]</button></div>
            </div>
        }
        @if (sel.Status == "disabled")
        {
            <div class="section"><p>@L["Ext.DisabledText"]</p></div>
        }
        <div class="section last">
            <div class="kv">
                <span>@L["Ext.Kv.Source"]</span><span>@sel.Origin</span>
                <span>@L["Ext.Kv.Transport"]</span><span>@(sel.Transport ?? "—")</span>
                @if (sel.Target is { } t)
                {
                    <span>@L["Ext.Kv.Target"]</span><span>@t</span>
                }
                <span>@L["Kv.Tools"]</span><span>@(sel.Tools?.Length.ToString() ?? (sel.Status == "failed" ? "0" : "—"))</span>
                <span>@L["Ext.Kv.Scope"]</span><span>@(sel.Scope is { } sc ? ScopeLabel(sc) : "—")</span>
                @if (sel.Version is { } v)
                {
                    <span>@L["Ext.Kv.Version"]</span><span>@v</span>
                }
            </div>
            @if (sel.Status == "connected" && sel.Transport is "http" or "sse")
            {
                @* mcp_clear_auth drops the token the CLI stored (--probe-cli mcp-auth): the next call signs in again. *@
                <div class="acts"><button class="btn" disabled="@busy" @onclick="() => SignOut(ls, sel.Name)">@L["Ext.SignOut"]</button></div>
            }
        </div>
        @if (sel.Tools is { Length: > 0 } tools)
        {
            <div class="section last">
                <h3>@L["Col.Tools"]</h3>
                <ul class="mcp-tools">
                    @foreach (var tl in tools)
                    {
                        <li><code>@tl.Name</code>@if (tl.ReadOnly)
                            {
                                <span class="tag">@L["Ext.Tool.ReadOnly"]</span>
                            }@if (tl.Destructive)
                            {
                                <span class="tag">@L["Ext.Tool.Destructive"]</span>
                            }@if (tl.OpenWorld)
                            {
                                <span class="tag">@L["Ext.Tool.OpenWorld"]</span>
                            }@if (tl.Description is { Length: > 0 } td)
                            {
                                <div class="d">@td</div>
                            }</li>
                    }
                </ul>
            </div>
        }
    </aside>
}

@if (Ui.InspectorOpen && (tab == "plugins" || Live is null) && options is { } opts && configuring is { } cid)
{
    <aside class="pane insp" aria-label="@L["Inspector"]">
        <div class="ph"><h2 class="ttl" title="@cid">@L["Ext.Plugins.OptionsTitle", cid.Split('@')[0]]</h2><span class="sub">@cid</span>@CloseInspector()</div>
        <div class="section last">
            @foreach (var o in opts)
            {
                var id = "opt-" + o.Key;
                <div class="field">
                    <label for="@id">@o.Title@if (o.Required)
                        {
                            <span class="tag">@L["Ext.Plugins.Required"]</span>
                        }@if (!o.Set)
                        {
                            <span class="tag">@L["Ext.Plugins.Unset"]</span>
                        }</label>
                    @if (o.Choices.Length > 0)
                    {
                        <div class="picks"><select id="@id" value="@Draft(o)" @onchange='e => optionDraft[o.Key] = e.Value?.ToString() ?? ""' disabled="@busy">
                            <option value=""></option>
                            @foreach (var c in o.Choices)
                            {
                                <option value="@c">@c</option>
                            }
                        </select></div>
                    }
                    else
                    {
                        <div class="input"><input id="@id" type="@(o.Sensitive ? "password" : o.Type == "number" ? "number" : "text")" value="@Draft(o)" @oninput='e => optionDraft[o.Key] = e.Value?.ToString() ?? ""'
                                                  placeholder="@(o.Sensitive && o.Set ? L["Ext.Plugins.SecretKept"].Value : null)" spellcheck="false" autocomplete="off" disabled="@busy" /></div>
                    }
                    @if (o.Description is { Length: > 0 } od)
                    {
                        <div class="d">@od</div>
                    }
                </div>
            }
            <div class="acts">
                <button class="btn primary" disabled="@(busy || optionDraft.Count == 0)" @onclick="() => SaveOptions(Live, Live?.Cwd ?? Home, cid)">@L["Ext.Plugins.Save"]</button>
                <button class="btn" @onclick="() => { configuring = null; options = null; }">@L["Action.Close"]</button>
            </div>
        </div>
    </aside>
}

@code {
    record Srv(string Name, string Status, string Short, string Origin, string Tag, string? Error, string? Transport, string? Target, Mcp.ToolInfo[]? Tools, string? Scope, string? Version);

    string tab = "mcp", filter = "";
    string? selected, note, refreshedFor, hooksNote;
    bool busy, focusAuth, readLive;   // readLive: the shown session was read with its process (mcp_status, hooks, rules)
    string[]? skillsRead;   // reload_skills, before the first message gives init.skills
    string query = "";   // the Skills / Agents / Hooks filter
    HashSet<string> expanded = [];   // skill (k:) and agent (a:) rows showing their whole description
    string? cursor;   // the focused row of the tab's table (Hooks, Permissions, Plugins, Skills, Agents)
    CancellationTokenSource? disarmIn;
    HookListing? hooks;
    HookRow? hookEditing;   // the row the form replaces; null = the form adds
    string hookEvent = "PreToolUse", hookMatcher = "", hookCommand = "", hookFile = "localSettings";
    int? hookTimeout;
    bool hookBlock;
    PermissionState? perms;
    string? permsNote;
    string ruleDraft = "", ruleBehavior = "allow", ruleFile = "localSettings";
    (string Server, string Url)? auth;   // sign-in in progress: its page stays one click away until the server connects
    CancellationTokenSource? authPoll;
    ElementReference authLink;

    // The session a link names (?session=, from inside it): its process starts if it has none, as the Context panel's does.
    // Without one, the most recent session that has a claude process: starting one here would be a side effect.
    LiveSession? Live => SessionQuery is { Length: > 0 } id ? Sessions.Get(id) : Sessions.All.LastOrDefault(s => s.HasProcess);
    static readonly string Home = Environment.GetFolderPath(Environment.SpecialFolder.UserProfile);

    string Link(string? session) => $"extensions?tab={tab}" + (session is { Length: > 0 } ? $"&session={Uri.EscapeDataString(session)}" : "");

    [SupplyParameterFromQuery(Name = "tab")] public string? TabQuery { get; set; }   // /mcp, /hooks typed in a Composer
    [SupplyParameterFromQuery(Name = "server")] public string? ServerQuery { get; set; }   // a failed MCP call's link in the thread
    [SupplyParameterFromQuery(Name = "session")] public string? SessionQuery { get; set; }   // the session the links come from

    protected override void OnInitialized()
    {
        if (TabQuery is "mcp" or "skills" or "agents" or "hooks" or "permissions" or "plugins") tab = TabQuery;
        if (ServerQuery is { Length: > 0 }) Select(ServerQuery);
        Sessions.Changed += OnChanged;
        Ui.Changed += OnChanged;
    }

    // mcp_status once per session shown, not again for the prerender; the switcher changes ?session= in place.
    protected override async Task OnParametersSetAsync()
    {
        if (!RendererInfo.IsInteractive) return;
        if (Live is null) { if (installed is null) await LoadPlugins(null, Home); }
        else if (SessionQuery is not { Length: > 0 }) Nav.NavigateTo(Link(Live.Id), replace: true);   // the session shown, named
        else if (Live.Id != refreshedFor) await Refresh();
    }

    // A session named by a link may have no process (stopped, or opened from history): the page asks before starting one.
    Task Start(LiveSession s) => Run(async () => { await s.RefreshMcp(); refreshedFor = null; await Refresh(); });

    async Task Armed(string key, Func<Task> act) { if (confirm != key) { Arm(key); return; } confirm = null; await act(); }
    void Disarm() => confirm = null;

    // An armed Remove/Uninstall disarms after 5 s too: WebKit never focuses a clicked button, so its blur never comes.
    void Arm(string key)
    {
        confirm = key;
        disarmIn?.Cancel();
        var ct = (disarmIn = new()).Token;
        _ = Task.Delay(5000, ct).ContinueWith(_ => InvokeAsync(() => { if (confirm == key) { confirm = null; StateHasChanged(); } }), ct, TaskContinuationOptions.OnlyOnRanToCompletion, TaskScheduler.Default);
    }

    bool Matches(string name, string? desc) => query.Trim() is not { Length: > 0 } q
        || name.Contains(q, StringComparison.OrdinalIgnoreCase) || desc?.Contains(q, StringComparison.OrdinalIgnoreCase) == true;

    // How a plugin stands in this session: off, failed to load, a server of it failing or waiting for sign-in, loaded, or
    // enabled after the session started (reload). Before the first message the session has not said what it loaded.
    RenderFragment PluginState(Plugins.Row p, LiveSession? s, List<Srv>? servers, string[]? skills, int rt)
    {
        var mine = servers?.Where(x => x.Origin == "plugin:" + p.Name).ToList() ?? [];
        if (!p.Enabled) return State("disabled");
        if (p.Errors.Length > 0 || s?.Init?.PluginErrors?.Any(e => e.Plugin == p.Name) == true) return Dot("fail", L["Ext.Plugins.State.Failed"]);
        if (mine.Where(x => x.Status == "failed").ToList() is [var ff, ..] fl) return ToServer(ff, Dot("fail", Strings.Plural(fl.Count, "Ext.Plugins.State.ServerFailing")), rt);
        if (mine.FirstOrDefault(x => x.Status == "needs-auth") is { } na) return ToServer(na, Dot("auth", L["Ext.State.NeedsAuth"]), rt);
        if (mine.Count > 0 && mine.All(x => x.Status == "disabled")) return ToServer(mine[0], Dot("off", Strings.Plural(mine.Count, "Ext.Plugins.State.ServersOff")), rt);
        if (s?.Init is { } i) return i.Plugins.Contains(p.Name) ? Dot("ok", L["Ext.Plugins.State.Loaded"]) : Dot("wait", L["Ext.Plugins.State.Reload"]);
        // Before the first message: loaded when the session already reports one of its servers or skills.
        if (mine.Any(x => x.Status == "connected") || skills?.Any(k => k.StartsWith(p.Name + ":")) == true || s is not null && hooks?.Rows.Any(h => h.Plugin == p.Id || h.Plugin == p.Name) == true)
            return Dot("ok", L["Ext.Plugins.State.Loaded"]);
        return Dot("wait", L["Ext.Plugins.State.On"]);
    }

    RenderFragment Dot(string cls, string text) => @<span class="ms @cls"><i></i>@text</span>;

    // The plugin's server, opened on the MCP tab with its inspector.
    RenderFragment ToServer(Srv m, RenderFragment state, int rt) =>
        @<button type="button" class="linkish" tabindex="@rt" title="@L["Ext.Plugins.ShowServer", m.Short]" @onclick='() => { Show("mcp"); Select(m.Name); }'>@state</button>;

    RenderFragment FindBox(int shown, int all) =>
        @<div class="findrow"><div class="input find"><Icon Name="search" Sm /><input type="search" aria-label="@L["Ext.Find"]" placeholder="@L["Ext.Find"]" @bind="query" @bind:event="oninput" spellcheck="false" autocomplete="off" /></div>@if (query.Trim().Length > 0)
            {
                <span class="d" role="status">@L["Ext.FindCount", shown, all]</span>
            }</div>;

    // The row that holds a table's one Tab stop: the one the keys last reached, while it is shown, else the first.
    string? StopOf(IEnumerable<string> keys) { var k = keys.ToList(); return cursor is not null && k.Contains(cursor) ? cursor : k.FirstOrDefault(); }

    void Expand(string key) { if (!expanded.Remove(key)) expanded.Add(key); }

    static string Slash(string path) => path.Replace('\\', '/');

    // The past session a ?session= names when it is not open here: its title and folder still name the page.
    PastSession? Past => Live is null && SessionQuery is { Length: > 0 } q ? TranscriptStore.ById(q) : null;

    // A long command or matcher wraps after its separators, not inside a word.
    static MarkupString Breaks(string s, char c) => new(string.Join(c + "<wbr>", s.Split(c).Select(Fmt.Enc)));

    // A hook told apart from its siblings: SessionStart (startup), PreToolUse (Bash)…
    static string HookName(HookRow h) => h.Matcher.Length > 0 ? $"{h.Event} ({h.Matcher})" : h.Event;

    // A command's description ends with where it comes from: "… (user)", "… (commit-commands)". Shown as a tag.
    static (string? Text, string? From) SplitSource(string? d) =>
        d is null ? (null, null)
        : System.Text.RegularExpressions.Regex.Match(d, @"^\(([^()]+)\)\s*(.*)$", System.Text.RegularExpressions.RegexOptions.Singleline) is { Success: true } lead ? (lead.Groups[2].Value, lead.Groups[1].Value)   // a plugin's: "(commit-commands) …"
        : System.Text.RegularExpressions.Regex.Match(d, @"^(.*?)\s*\(([\w.:@-]+)\)$", System.Text.RegularExpressions.RegexOptions.Singleline) is { Success: true } m ? (m.Groups[1].Value, m.Groups[2].Value)   // "… (user)"
        : (d, null);

    RenderFragment CloseInspector() =>
        @<button type="button" class="btn ghost" title="@L["Ext.CloseInspector"]" aria-label="@L["Action.Close"]" @onclick="() => Ui.InspectorOpen = false"><Icon Name="x" Sm /></button>;

    // Where a failed server is defined, so its error has a place to be fixed.
    string FailedWhere(Srv m) =>
        m.Origin.StartsWith("plugin:") ? L[installed?.Any(r => r.Name == m.Origin[7..] && r.HasOptions) == true ? "Ext.FailedWhere.PluginOptions" : "Ext.FailedWhere.Plugin", m.Origin[7..]]
        : m.Tag == "claude.ai" ? L["Ext.FailedWhere.Claude"]
        : m.Scope switch { "user" => L["Ext.FailedWhere.User"], "project" => L["Ext.FailedWhere.Project"], "local" => L["Ext.FailedWhere.Local"], _ => L["Ext.FailedWhere.Other"] };

    // A scope as the CLI writes it (user, project, local, dynamic, claudeai, managed…) in the page's words.
    static string ScopeLabel(string scope) => scope switch
    {
        "dynamic" => Strings.Get("Ext.Scope.Plugin"),
        "claudeai" => "claude.ai",
        "user" or "project" or "local" or "policy" => SourceTag(scope + "Settings"),
        _ => scope,
    };
    static string HookKey(HookRow h) => $"{h.Event}|{h.Source}|{h.Matcher}|{h.Command}";

    // Sessions.Changed is raised on the claude reader thread: touch component state on the renderer's dispatcher only.
    void OnChanged() => _ = InvokeAsync(async () =>
    {
        if (Live is { } l && (l.Id != refreshedFor || l.HasProcess && !readLive)) await Refresh();
        StateHasChanged();
    });

    async Task Refresh()
    {
        if (Live is not { } s) return;
        if (refreshedFor != s.Id)
        {
            if (refreshedFor is not null) selected = null;   // another session: its own failed server is the one to show
            (hooks, hooksNote, perms, permsNote, installed, markets, skillsRead, readLive) = (null, null, null, null, null, null, null, false);   // the previous session's (another folder) must not show meanwhile
            ResetHookForm();   // nor its hook stay the edit target
        }
        refreshedFor = s.Id;
        if (s.HasProcess)   // never started from here unasked: Start does that
        {
            readLive = true;
            await Run(s.RefreshMcp);
            if (selected is null && Servers(s) is { Count: > 0 } all)
                selected = (all.FirstOrDefault(x => x.Status == "failed") ?? all[0]).Name;
            if (s.Init is null) try { skillsRead = Events.Names(await s.Request("reload_skills"), "skills"); } catch (Exception) { }
            await LoadHooks(s);
            await LoadPerms(s);
        }
        await LoadPlugins(s, s.Cwd);
    }

    // get_hooks_listing reads the settings files on every call: asked again whenever the tab is opened.
    // A process that exited since Show must not be respawned by Request: the tab only reads.
    async Task LoadHooks(LiveSession s)
    {
        if (!s.HasProcess) return;
        HookListing? got = null;
        string? failed = null;
        try { got = Events.Hooks(await s.Request("get_hooks_listing")); }
        catch (Exception ex) { failed = L["Ext.Hooks.Failed", ex.Message.TrimEnd()]; }   // fire-and-forget from Show: nothing may escape
        if (s.Id != refreshedFor) return;   // Live moved to another session meanwhile: its Refresh loads its own hooks
        (hooks, hooksNote) = (got, failed);
        try { await InvokeAsync(StateHasChanged); } catch (ObjectDisposedException) { }
    }

    void EditHook(HookRow h) =>
        (hookEditing, hookEvent, hookMatcher, hookCommand, hookTimeout, hookBlock) = (h, h.Event, h.Edit!.Matcher, Events.Str(h.Edit.Config, "command") ?? h.Command, h.Timeout, h.BlocksOnFailure);

    void ResetHookForm() => (hookEditing, hookMatcher, hookCommand, hookTimeout, hookBlock) = (null, "", "", null, false);

    // `claude edit-hook` writes the settings file (the CLI's own writer and checks); a replace or remove names the row's
    // stored entry, so a hook changed on disk meanwhile is refused rather than overwritten. The session's listing follows
    // once its file watcher reloads the settings: listed again until it changed.
    async Task SaveHook(LiveSession s, HookRow? target, bool remove)
    {
        if (busy || !remove && hookCommand.Trim().Length == 0) return;
        busy = true;
        hooksNote = null;
        try
        {
            var matcher = hooks?.Catalog.FirstOrDefault(x => x.Name == hookEvent) is { Matcher: false } ? "" : hookMatcher.Trim();
            var edit = remove ? CliEdit.Hook("remove", target!.Source, target.Event, target.Edit!.Matcher, null, target)
                : CliEdit.Hook(target is null ? "add" : "replace", target?.Source ?? hookFile, hookEvent, matcher,
                    CliEdit.CommandHook(target?.Edit?.Config, hookCommand.Trim(), hookTimeout, hookBlock), target);
            var before = HookRows(hooks);
            if (await CliEdit.Run(perms?.Cwd ?? s.Cwd, "edit-hook", edit) is { } err) { hooksNote = L["Ext.Hooks.EditFailed", err]; return; }
            if (!remove || target == hookEditing) ResetHookForm();
            for (var i = 0; i < 20; i++)   // 10 s at most
            {
                await Task.Delay(500);
                await LoadHooks(s);
                if (hooks is null || HookRows(hooks) != before) break;
            }
        }
        catch (Exception ex) { hooksNote = L["Ext.Hooks.EditFailed", ex.Message]; }
        finally { busy = false; }
    }

    static string HookRows(HookListing? l) => string.Join("\n", l?.Rows.Select(r => $"{r.Event}|{r.Source}|{r.Matcher}|{r.Command}|{r.Timeout}|{r.BlocksOnFailure}") ?? []);

    // list_permission_rules: rules from every settings file plus session grants and --allowedTools, each with its source.
    async Task LoadPerms(LiveSession s)
    {
        if (!s.HasProcess) return;
        PermissionState? got = null;
        string? failed = null;
        try { got = PermissionRules.Parse(await s.Request("list_permission_rules")); }
        catch (Exception ex) { failed = L["Ext.Perm.Failed", ex.Message.TrimEnd()]; }
        if (s.Id != refreshedFor) return;
        (perms, permsNote) = (got, failed);
        try { await InvokeAsync(StateHasChanged); } catch (ObjectDisposedException) { }
    }

    // Writes the settings file the CLI reads for that source, then lists again until its file watcher shows the change.
    async Task EditRule(LiveSession s, string source, string behavior, string rule, bool add)
    {
        if (busy || rule.Length == 0) return;
        if (!PermissionRules.Valid(rule)) { permsNote = L["Ext.Perm.Invalid", rule]; return; }
        busy = true;
        permsNote = null;
        try
        {
            var cwd = perms?.Cwd ?? s.Cwd;
            var path = PermissionRules.FileOf(source, cwd, source == "localSettings" ? await LiveSession.GitRoot(cwd) : null, TranscriptStore.ConfigDir)
                       ?? throw new InvalidOperationException(source);
            PermissionRules.Save(path, behavior, rule, add);
            if (add) ruleDraft = "";
            for (var i = 0; i < 20; i++)   // 3 s on 2.1.296; 10 s at most
            {
                await Task.Delay(500);
                await LoadPerms(s);
                if (perms is null || perms.Rules.Any(r => r.Source == source && r.Behavior == behavior && r.Rule == rule) == add) break;
            }
        }
        catch (Exception ex) { permsNote = L["Ext.Perm.WriteFailed", ex.Message.TrimEnd()]; }
        finally { busy = false; }
    }

    // ---------- plugins: `claude plugin … --json` in the session's folder, then reload_plugins ----------

    List<Plugins.Row>? installed;
    List<Plugins.Listed> available = [];
    List<Plugins.Market>? markets;
    string? pluginsNote, pluginsDone, confirm;   // confirm: the uninstall/remove awaiting its second click
    string installDraft = "", installScope = "user", marketDraft = "";
    (Plugins.Outcome Outcome, string[] Args)? toAccept;   // an install whose marketplace command waits for a person
    string? configuring;
    List<Plugins.Option>? options;
    Dictionary<string, string> optionDraft = [];

    async Task LoadPlugins(LiveSession? s, string cwd)
    {
        string? failed = null;
        try
        {
            var (rows, avail) = await Plugins.List(cwd);
            var mk = await Plugins.Markets(cwd);
            if (s?.Id != refreshedFor) return;
            (installed, available, markets) = (rows, avail, mk);
            if (configuring is { } cid && !rows.Any(r => r.Id == cid)) (configuring, options) = (null, null);   // uninstalled meanwhile
        }
        catch (Exception ex) { failed = L["Ext.Plugins.Failed", ex.Message.TrimEnd()]; }
        pluginsNote = failed ?? pluginsNote;
        try { await InvokeAsync(StateHasChanged); } catch (ObjectDisposedException) { }
    }

    // The CLI writes the settings and caches; the running session only sees it after reload_plugins (a process that
    // exited is not respawned for it: the next one reads the disk anyway).
    async Task PluginAct(LiveSession? s, string cwd, params string[] args)
    {
        if (busy) return;
        busy = true;
        (pluginsNote, pluginsDone, confirm, toAccept) = (null, null, null, null);
        try
        {
            var r = await Plugins.Act(cwd, args);
            if (r.Ok) pluginsDone = r.Message + (s is { HasProcess: true } ? " " + await Reload(s) : "");
            else if (r is { Command: not null, CommandSha: not null }) toAccept = (r, args);
            else pluginsNote = r.Message;
            if (r.Ok && args[0] == "install") installDraft = "";
        }
        catch (Exception ex) { pluginsNote = L["Ext.Plugins.Failed", ex.Message.TrimEnd()]; }
        finally { busy = false; }
        await LoadPlugins(s, cwd);
    }

    // The person read the command: the same install again, bound to that command's sha (a changed one is refused again).
    Task Accept(LiveSession? s, string cwd) => toAccept is { } a ? PluginAct(s, cwd, [.. a.Args, "--accept-command", a.Outcome.CommandSha!]) : Task.CompletedTask;

    async Task<string> Reload(LiveSession s)
    {
        var (plugins, skills, agents, errors) = await s.ReloadPlugins();
        var text = L["Ext.Plugins.Reloaded", plugins, skills, agents].Value;
        return errors > 0 ? text + " " + L["Ext.Plugins.ReloadErrors", errors] : text;
    }

    Task ReloadNow(LiveSession s) => Run(async () => { pluginsDone = await Reload(s); });

    // Uninstall and remove ask for a second click on the same button: the row and its data go.
    async Task Confirmed(LiveSession? s, string cwd, string key, params string[] args)
    {
        if (confirm != key) { Arm(key); return; }
        await PluginAct(s, cwd, args);
    }

    async Task Configure(string cwd, string id)
    {
        (configuring, options, pluginsNote) = (id, null, null);
        optionDraft = [];
        Ui.InspectorOpen = true;
        try { options = await Plugins.Options(cwd, id); }
        catch (Exception ex) { (configuring, pluginsNote) = (null, L["Ext.Plugins.Failed", ex.Message.TrimEnd()]); }
    }

    // Only what was edited is sent: a sensitive option left empty keeps its saved value.
    async Task SaveOptions(LiveSession? s, string cwd, string id)
    {
        busy = true;
        (pluginsNote, pluginsDone) = (null, null);
        try
        {
            if (await Plugins.Save(cwd, id, optionDraft) is { } refused) { pluginsNote = refused; return; }
            optionDraft = [];
            options = await Plugins.Options(cwd, id);
            pluginsDone = L["Ext.Plugins.Saved"] + (s is { HasProcess: true } ? " " + await Reload(s) : "");
        }
        catch (Exception ex) { pluginsNote = L["Ext.Plugins.Failed", ex.Message.TrimEnd()]; }
        finally { busy = false; }
    }

    string Draft(Plugins.Option o) => optionDraft.TryGetValue(o.Key, out var v) ? v : o.Value;

    // The catalogue holds thousands of entries: the datalist offers the 30 most installed that match what is typed.
    IEnumerable<Plugins.Listed> Matches() =>
        available.Where(a => installDraft.Length == 0 || a.Id.Contains(installDraft, StringComparison.OrdinalIgnoreCase)).OrderByDescending(a => a.Installs).Take(30);

    RenderFragment PluginsTab(LiveSession? s, string cwd, List<Srv>? servers, string[]? skills) => __builder =>
    {
        @if (s is not null)
        {
            <div class="filters">
                <button class="btn" disabled="@(busy || !s.HasProcess)" @onclick="() => ReloadNow(s)"><Icon Name="refresh" Sm />@L["Ext.Plugins.Reload"]</button>
            </div>
        }
        <div role="status">@if (pluginsDone is not null)
            {
                <p class="lead">@pluginsDone</p>
            }</div>
        @if (pluginsNote is not null)
        {
            <div class="errbox" role="alert">@pluginsNote</div>
        }
        @foreach (var pe in s?.Init?.PluginErrors ?? [])
        {
            <div class="errbox" role="status" title="@pe.Path">@L["Ext.Plugins.LoadError", pe.Plugin, pe.Message]</div>
        }
        @if (toAccept is { } ta)
        {
            <div class="errbox" role="alert">@L["Ext.Plugins.Command", ta.Args[1]]<br /><code>@ta.Outcome.Command</code></div>
            <div class="acts">
                <button class="btn primary" disabled="@busy" @onclick="() => Accept(s, cwd)">@L["Ext.Plugins.Accept"]</button>
                <button class="btn" @onclick="() => toAccept = null">@L["Action.Cancel"]</button>
            </div>
        }
        @if (installed is null)
        {
            <p class="lead" role="status">@L["Ext.Plugins.Loading"]</p>
        }
        else if (installed.Count == 0)
        {
            <p class="lead">@L["Ext.Plugins.None"]</p>
        }
        else
        {
            @if (s is { Init: null })
            {
                <p class="lead">@L["Ext.Plugins.Lifecycle"]</p>
            }
            <table class="mcp plugins" aria-label="@L["Ext.Tab.Plugins"]">
                <thead><tr><th>@L["Ext.Col.Plugin"]</th><th>@L["Col.State"]</th><th class="opt">@L["Ext.Col.Scope"]</th><th class="num opt">@L["Ext.Col.McpServers"]</th>@if (skills is not null)
                    {
                        <th class="num opt">@L["Ext.Tab.Skills"]</th>
                    }<th class="num"><span class="vh">@L["Ext.Col.Actions"]</span></th></tr></thead>
                <tbody>
                    @{ var plstop = StopOf(installed.Select(x => x.Id + "|" + x.Scope)); }
                    @foreach (var p in installed)
                    {
                        var key = p.Id + "|" + p.Scope;
                        var editable = p.Scope is "user" or "project" or "local";
                        var rt = key == plstop ? 0 : -1;
                        <tr data-r tabindex="@rt" @onfocusin="() => cursor = key">
                            <td><div class="n">@p.Name</div><div class="d id" title="@($"{p.Id} · {p.Version}")">@p.Id · @p.Version</div>
                                @foreach (var e in p.Errors)
                                {
                                    <div class="errbox">@e</div>
                                }
                                @foreach (var n in p.Notes)
                                {
                                    <div class="d">@n</div>
                                }</td>
                            <td>@PluginState(p, s, servers, skills, rt)</td>
                            <td class="opt"><span class="tag">@ScopeLabel(p.Scope)</span></td>
                            <td class="num opt">@p.McpServers.Length</td>
                            @if (skills is not null)
                            {
                                <td class="num opt">@(p.Enabled ? skills.Count(k => k.StartsWith(p.Name + ":")) : "—")</td>
                            }
                            <td class="num rowacts">
                                @if (editable)
                                {
                                    <button class="toggle @(p.Enabled ? "on" : null)" tabindex="@rt" role="switch" aria-checked="@(p.Enabled ? "true" : "false")" aria-label="@($"{L["Ext.Plugins.Enable"]}: {p.Name}")"
                                            disabled="@busy" @onclick='() => PluginAct(s, cwd, p.Enabled ? "disable" : "enable", p.Id, "--scope", p.Scope)'><span class="sw"></span></button>
                                    @if (p.HasOptions)
                                    {
                                        <button class="btn" tabindex="@rt" disabled="@busy" aria-label="@($"{L["Ext.Plugins.Options"]}: {p.Name}")" @onclick="() => Configure(cwd, p.Id)">@L["Ext.Plugins.Options"]</button>
                                    }
                                    <button class="btn ghost" tabindex="@rt" disabled="@busy" aria-label="@($"{L["Ext.Plugins.Update"]}: {p.Name}")" @onclick='() => PluginAct(s, cwd, "update", p.Id, "--scope", p.Scope)'>@L["Ext.Plugins.Update"]</button>
                                    <button class="btn arm @(confirm == "u:" + key ? "danger" : "ghost")" tabindex="@rt" disabled="@busy" aria-label="@(confirm == "u:" + key ? L["Ext.ConfirmUninstallOf", p.Name] : $"{L["Ext.Plugins.Uninstall"]}: {p.Name}")" @onblur="Disarm" @onclick='() => Confirmed(s, cwd, "u:" + key, "uninstall", p.Id, "--scope", p.Scope)'>@(confirm == "u:" + key ? L["Ext.Plugins.ConfirmUninstall"] : L["Ext.Plugins.Uninstall"])</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="keys">@L["Ext.KeysRows"]</p>
        }
        <div class="field">
            <label for="plugin-install">@L["Ext.Plugins.Install"]</label>
            <div class="input"><input id="plugin-install" list="plugin-catalog" @bind="installDraft" @bind:event="oninput" placeholder="name@marketplace" spellcheck="false" autocomplete="off" disabled="@busy"
                                      @onkeydown='async e => { if (e.Key == "Enter" && installDraft.Trim().Length > 0) await PluginAct(s, cwd, "install", installDraft.Trim(), "--scope", installScope); }' /></div>
            <datalist id="plugin-catalog">
                @foreach (var a in Matches())
                {
                    <option value="@a.Id">@a.Description</option>
                }
            </datalist>
        </div>
        <div class="picks">
            <select aria-label="@L["Ext.Col.Scope"]" @bind="installScope" disabled="@busy">
                @foreach (var sc in Plugins.Scopes)
                {
                    <option value="@sc">@SourceTag(sc + "Settings")</option>
                }
            </select>
            <button class="btn primary" disabled="@(busy || installDraft.Trim().Length == 0)" @onclick='() => PluginAct(s, cwd, "install", installDraft.Trim(), "--scope", installScope)'><Icon Name="plus" Sm />@L["Ext.Plugins.InstallButton"]</button>
        </div>
        <h3>@L["Ext.Plugins.Markets"]</h3>
        @if (markets is { Count: > 0 } ms)
        {
            <table class="mcp" aria-label="@L["Ext.Plugins.Markets"]">
                <thead><tr><th>@L["Ext.Plugins.Market"]</th><th>@L["Ext.Col.Source"]</th><th class="num"><span class="vh">@L["Ext.Col.Actions"]</span></th></tr></thead>
                <tbody>
                    @{ var mstop = StopOf(ms.Select(x => "m:" + x.Name)); }
                    @foreach (var m in ms)
                    {
                        var mk = "m:" + m.Name;
                        var rt = mk == mstop ? 0 : -1;
                        <tr data-r tabindex="@rt" @onfocusin="() => cursor = mk">
                            <td><div class="n">@m.Name</div></td>
                            <td><code>@m.Where</code></td>
                            <td class="num rowacts">
                                <button class="btn ghost" tabindex="@rt" disabled="@busy" aria-label="@($"{L["Ext.Plugins.Update"]}: {m.Name}")" @onclick='() => PluginAct(s, cwd, "marketplace", "update", m.Name)'>@L["Ext.Plugins.Update"]</button>
                                <button class="btn arm @(confirm == "m:" + m.Name ? "danger" : "ghost")" tabindex="@rt" disabled="@busy" aria-label="@(confirm == "m:" + m.Name ? L["Ext.ConfirmRemoveOf", m.Name] : $"{L["Ext.Plugins.Remove"]}: {m.Name}")" @onblur="Disarm" @onclick='() => Confirmed(s, cwd, "m:" + m.Name, "marketplace", "remove", m.Name)'>@(confirm == "m:" + m.Name ? L["Ext.Plugins.ConfirmRemove"] : L["Ext.Plugins.Remove"])</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="keys">@L["Ext.KeysRows"]</p>
        }
        <div class="field">
            <label for="market-add">@L["Ext.Plugins.AddMarket"]</label>
            <div class="input"><input id="market-add" @bind="marketDraft" @bind:event="oninput" placeholder="owner/repo" spellcheck="false" autocomplete="off" disabled="@busy"
                                      @onkeydown='async e => { if (e.Key == "Enter" && marketDraft.Trim().Length > 0) { await PluginAct(s, cwd, "marketplace", "add", marketDraft.Trim()); if (pluginsNote is null) marketDraft = ""; } }' /></div>
        </div>
        <div class="picks">
            <button class="btn primary" disabled="@(busy || marketDraft.Trim().Length == 0)" @onclick='async () => { await PluginAct(s, cwd, "marketplace", "add", marketDraft.Trim()); if (pluginsNote is null) marketDraft = ""; }'><Icon Name="plus" Sm />@L["Ext.Plugins.AddMarketButton"]</button>
        </div>
    };

    void Show(string key)
    {
        tab = key;
        filter = "";   // the filters are per tab: an MCP state means nothing to the rules
        (confirm, query, cursor) = (null, "", null);
        expanded.Clear();
        Nav.NavigateTo(Link(SessionQuery), replace: true);   // reload and Back keep the tab
        if (key == "hooks" && Live is { } s) _ = LoadHooks(s);
        if (key == "permissions" && Live is { } p) _ = LoadPerms(p);
        if (key == "plugins" && Live is { } pl) _ = LoadPlugins(pl, pl.Cwd);
    }

    // userSettings / projectSettings / localSettings / pluginHook; anything else (policy…) as the CLI names it.
    static string SourceTag(string source) => source switch
    {
        "userSettings" => Strings.Get("Ext.Scope.User"),
        "projectSettings" => Strings.Get("Ext.Scope.Project"),
        "localSettings" => Strings.Get("Ext.Scope.Local"),
        "pluginHook" => Strings.Get("Ext.Scope.Plugin"),
        "session" => Strings.Get("Ext.Scope.Session"),
        "policySettings" => Strings.Get("Ext.Scope.Policy"),
        "cliArg" => Strings.Get("Ext.Scope.Cli"),
        _ => source,
    };

    Task Toggle(LiveSession s, string name, bool enabled) =>
        Run(async () => { await s.Request("mcp_toggle", new() { ["serverName"] = name, ["enabled"] = enabled }); await s.RefreshMcp(); });

    // A server that still fails answers with its error: shown as the note.
    Task Reconnect(LiveSession s, string name) =>
        Run(async () => { try { await s.Request("mcp_reconnect", new() { ["serverName"] = name }); } finally { await s.RefreshMcp(); } });

    // The CLI has no bulk reconnect ("/mcp reconnect all" is terminal-only): one mcp_reconnect per failed server, then
    // one mcp_status. A server that still fails is named in the note, the others carry on.
    Task ReconnectAll(LiveSession s, List<Srv> servers) => Run(async () =>
    {
        List<string> still = [];
        foreach (var m in servers.Where(x => x.Status == "failed"))
            try { await s.Request("mcp_reconnect", new() { ["serverName"] = m.Name }); }
            catch (ClaudeRequestException) { still.Add(m.Short); }
        await s.RefreshMcp();
        if (still.Count > 0) note = L["Ext.StillFailing", string.Join(", ", still)];
    });

    Task SignOut(LiveSession s, string name) =>
        Run(async () => { try { await s.Request("mcp_clear_auth", new() { ["serverName"] = name }); } finally { await s.RefreshMcp(); } });

    // mcp_authenticate answers at once with the sign-in page; the CLI then waits for the browser's redirect on its own
    // localhost port and reconnects the server itself (`--probe-cli mcp-auth`). The page is opened by a link, not
    // window.open: after the round-trip there is no user gesture left, so browsers and the desktop webview would block it.
    // A link with target=_blank opens a tab here and the system browser in the desktop shell (its on_new_window).
    Task SignIn(LiveSession s, string name) => Run(async () =>
    {
        authPoll?.Cancel();
        auth = null;
        Select(name);
        var start = McpAuthStart.Parse(await s.Request("mcp_authenticate", new() { ["serverName"] = name }));
        if (start.Url is null) { await s.RefreshMcp(); return; }   // the stored token was still valid
        if (!start.CallbackExpected) { note = L["Ext.AuthTerminal", name]; return; }   // nothing would reconnect it: see SignsInHere
        auth = (name, start.Url);
        focusAuth = true;
        _ = AwaitConnected(s, name, (authPoll = new()).Token);
    });

    // claude.ai connectors (config.type claudeai-proxy) answer mcp_authenticate with callbackExpected:false: the CLI takes
    // no redirect and reconnects nothing, so the server would stay needs-auth whatever the browser does. They keep the
    // /mcp terminal route only. The init brief has no config: its "claude.ai " name prefix (Tag) says the same.
    static bool SignsInHere(Srv m) => m.Transport != "claudeai-proxy" && m.Tag != "claude.ai";

    // mcp_status every 2 s until the server leaves needs-auth/pending, 5 minutes at most. Runs on the renderer's dispatcher.
    // Stops once the session has no process (stopped or crashed): RefreshMcp would spawn a new claude for it, without
    // the callback listener this sign-in waits on.
    async Task AwaitConnected(LiveSession s, string name, CancellationToken ct)
    {
        try
        {
            for (var i = 0; i < 150; i++)
            {
                await Task.Delay(2000, ct);
                if (!s.HasProcess) { auth = null; return; }
                await s.RefreshMcp();
                ct.ThrowIfCancellationRequested();   // a newer sign-in took over while mcp_status was in flight
                if (Servers(s).FirstOrDefault(x => x.Name == name)?.Status is not ("needs-auth" or "pending")) { auth = null; return; }
            }
            auth = null;
            note = L["Ext.AuthTimeout", name];
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { auth = null; note = L["Ext.ActionFailed", ex.Message.TrimEnd()]; }
        finally { if (!ct.IsCancellationRequested) StateHasChanged(); }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!focusAuth || auth is null) return;
        focusAuth = false;
        try { await authLink.FocusAsync(); }
        catch (Exception ex) when (ex is InvalidOperationException or Microsoft.JSInterop.JSException) { }   // inspector closed meanwhile
    }

    async Task Run(Func<Task> action)
    {
        busy = true; note = null;
        try { await action(); }
        catch (Exception ex) { note = L["Ext.ActionFailed", ex.Message.TrimEnd()]; }
        finally { busy = false; }
    }

    void Select(string name) { selected = name; Ui.InspectorOpen = true; }

    // mcp_status when available (error, transport, tools), else the init brief.
    static List<Srv> Servers(LiveSession s)
    {
        if (s.McpStatus is { } st && Events.Prop(st, "mcpServers") is { ValueKind: JsonValueKind.Array } arr)
            return arr.EnumerateArray().Select(m =>
            {
                var name = Events.Str(m, "name") ?? "";
                var scope = Events.Str(m, "scope");
                var cfg = Events.Prop(m, "config") ?? default;
                var (shortName, origin, tag) = Split(name, Events.Str(m, "source"), scope);
                return new Srv(name, Events.Str(m, "status") ?? "", shortName, origin, tag, Events.Str(m, "error"),
                    Events.Str(cfg, "type"), Target(cfg),
                    Events.Prop(m, "tools") is { ValueKind: JsonValueKind.Array } ? Mcp.Tools(m) : null,
                    scope, Events.Prop(m, "serverInfo") is { } si ? Events.Str(si, "version") : null);
            }).ToList();
        return (s.Init?.Mcp ?? []).Select(m =>
        {
            var (shortName, origin, tag) = Split(m.Name, null, null);
            return new Srv(m.Name, m.Status, shortName, origin, tag, null, null, null, null, null, null);
        }).ToList();
    }

    // url for http/sse, command line for stdio.
    static string? Target(JsonElement cfg)
    {
        if (Events.Str(cfg, "url") is { Length: > 0 } url) return url;
        if (Events.Str(cfg, "command") is not { } cmd) return null;
        return Events.Prop(cfg, "args") is { ValueKind: JsonValueKind.Array } a
            ? cmd + " " + string.Join(" ", a.EnumerateArray().Select(x => x.ToString())) : cmd;
    }

    // "plugin:github:github" → github / plugin:github; "claude.ai Gmail" → Gmail / claude.ai; else the scope.
    static (string Short, string Origin, string Tag) Split(string name, string? source, string? scope)
    {
        if (name.StartsWith("plugin:") && name.Split(':', 3) is [_, var p, var rest]) return (rest, "plugin:" + p, "plugin");
        if (name.StartsWith("claude.ai ")) return (name[10..], "claude.ai", "claude.ai");
        var origin = scope switch { "user" => Strings.Get("Ext.Scope.User"), "project" => Strings.Get("Ext.Scope.Project"), "local" => Strings.Get("Ext.Scope.Local"), _ => scope ?? source ?? "" };
        return (name, origin, source switch { null or "user" => Strings.Get("Ext.Scope.User"), "claudeai" => "claude.ai", _ => source });
    }

    internal static List<(string Name, string? Desc, string? Model)> Agents(LiveSession s) =>
        s.InitializeInfo is { } info && Events.Prop(info, "agents") is { ValueKind: JsonValueKind.Array } a
            ? a.EnumerateArray().Select(x => (Events.Str(x, "name") ?? "", Events.Str(x, "description"), Events.Str(x, "model"))).ToList()
            : (s.Init?.Agents ?? []).Select(n => (n, (string?)null, (string?)null)).ToList();

    static string? Describe(LiveSession s, string skill) =>
        s.InitializeInfo is { } info && Events.Prop(info, "commands") is { ValueKind: JsonValueKind.Array } c
            ? c.EnumerateArray().Where(x => Events.Str(x, "name") == skill).Select(x => Events.Str(x, "description")).FirstOrDefault()
            : null;

    RenderFragment Tab(string key, string label, int? n) =>
        @<button id="ext-tab-@key" role="tab" aria-selected="@(tab == key ? "true" : "false")" aria-controls="ext-panel" tabindex="@(tab == key ? 0 : -1)"
                 class="@(tab == key ? "on" : null)" @onclick="() => Show(key)">@label <b>@(n?.ToString() ?? "—")</b></button>;

    RenderFragment Filter(string key, string label, int n) =>
        @<button class="chip @(filter == key ? "on" : null)" aria-pressed="@(filter == key ? "true" : "false")" @onclick="() => SetFilter(key)">@label <b>@n</b></button>;

    // An MCP filter that hides the selected server moves the selection (and its inspector) to the first one it shows.
    void SetFilter(string key)
    {
        filter = key;
        if (tab == "mcp" && Live is { } s && Servers(s).Where(x => key == "" || x.Status == key).ToList() is var shown
            && !shown.Any(x => x.Name == selected)) selected = shown.FirstOrDefault()?.Name;
    }

    RenderFragment State(string status) => status switch
    {
        "connected" => @<span class="ms ok"><i></i>@L["Ext.State.Connected"]</span>,
        "needs-auth" => @<span class="ms auth"><i></i>@L["Ext.State.NeedsAuth"]</span>,
        "failed" => @<span class="ms fail"><i></i>@L["Ext.State.Failed"]</span>,
        "disabled" => @<span class="ms off"><i></i>@L["Ext.State.Disabled"]</span>,
        "pending" => @<span class="ms wait"><i></i>@L["Ext.State.Pending"]</span>,
        _ => @<span class="ms off"><i></i>@status</span>,
    };

    public void Dispose()
    {
        authPoll?.Cancel();
        Sessions.Changed -= OnChanged;
        Ui.Changed -= OnChanged;
    }
}
