@page "/extensions"
@implements IDisposable
@inject SessionManager Sessions
@inject UiState Ui

<PageTitle>@L["Nav.Extensions"] · Claude Code</PageTitle>

<div class="pane">
    <div class="ph"><h1 class="ttl">@L["Settings.Title"]</h1><span class="sub">@L["Nav.Extensions"]</span></div>
    <div class="ext">
        @if (Live is not { } s)
        {
            <div><h3>@L["Nav.Extensions"]</h3><p class="lead">@L["Ext.NoSession"]</p>
                <div class="acts" style="margin-top:14px"><a class="btn primary" href=""><Icon Name="plus" Sm />@L["Rail.NewSession"]</a></div></div>
        }
        else
        {
            var servers = Servers(s);
            var skills = s.Init?.Skills ?? [];
            var agents = Agents(s);
            var plugins = s.Init?.Plugins ?? [];
            <div><h3>@L["Nav.Extensions"]</h3><p class="lead">@L["Ext.Lead"]</p></div>
            <div class="subtabs" role="tablist" aria-label="@L["Nav.Extensions"]">
                @Tab("mcp", "MCP", servers.Count)
                @Tab("skills", L["Ext.Tab.Skills"], skills.Length)
                @Tab("agents", L["Ext.Tab.Agents"], agents.Count)
                @Tab("plugins", L["Ext.Tab.Plugins"], plugins.Length)
                @Tab("hooks", L["Ext.Tab.Hooks"], hooks?.Rows.Count ?? 0)
            </div>
            <div id="ext-panel" role="tabpanel" aria-labelledby="ext-tab-@tab">
            @if (tab == "mcp")
            {
                @if (note is not null)
                {
                    <div class="errbox" role="alert">@note</div>
                }
                <div class="filters">
                    @Filter("", L["Filter.All"], servers.Count)
                    @Filter("connected", L["Ext.Filter.Connected"], servers.Count(x => x.Status == "connected"))
                    @Filter("needs-auth", L["Ext.Filter.Auth"], servers.Count(x => x.Status == "needs-auth"))
                    @Filter("failed", L["Ext.Filter.Failed"], servers.Count(x => x.Status == "failed"))
                </div>
                <table class="mcp">
                    <thead><tr><th>@L["Ext.Col.Server"]</th><th>@L["Ext.Col.Source"]</th><th>@L["Col.State"]</th><th class="num">@L["Col.Tools"]</th><th class="num">@L["Ext.Col.ThisFolder"]</th></tr></thead>
                    <tbody>
                        @foreach (var m in servers.Where(x => filter == "" || x.Status == filter))
                        {
                            <tr class="@(m.Name == selected ? "sel" : null)" tabindex="0" @onclick="() => Select(m.Name)" @onkeydown='e => { if (e.Key is "Enter" or " ") Select(m.Name); }'>
                                <td><div class="n">@m.Short</div><div class="d">@m.Origin</div></td>
                                <td><span class="tag">@m.Tag</span></td>
                                <td>@State(m.Status)</td>
                                <td class="num">@(m.Status == "failed" ? m.Tools ?? 0 : m.Status == "connected" ? m.Tools?.ToString() ?? "—" : "—")</td>
                                <td class="num" @onclick:stopPropagation>
                                    @switch (m.Status)
                                    {
                                        case "failed":
                                            <button class="btn" disabled="@busy" @onclick="() => Reconnect(s, m.Name)">@L["Ext.Retry"]</button>
                                            break;
                                        case "connected" or "disabled":
                                            var on = m.Status == "connected";
                                            <button class="toggle @(on ? "on" : null)" role="switch" aria-checked="@(on ? "true" : "false")" aria-label="@($"{L["Ext.EnableHere"]}: {m.Short}")"
                                                    disabled="@busy" @onclick="() => Toggle(s, m.Name, !on)"><span class="sw"></span></button>
                                            break;
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else if (tab == "hooks")
            {
                <p class="lead">@L["Ext.Hooks.Lead", s.Cwd]</p>
                @if (hooksNote is not null)
                {
                    <div class="errbox" role="alert">@hooksNote</div>
                }
                else if (hooks is { Disabled: true })
                {
                    <div class="errbox" role="status">@L["Ext.Hooks.Disabled"]</div>
                }
                @if (hooks is { Rows.Count: 0 })
                {
                    <p class="lead">@L["Ext.Hooks.None"]</p>
                }
                else if (hooks is { } hl)
                {
                    <table class="mcp">
                        <thead><tr><th>@L["Ext.Col.Event"]</th><th>@L["Ext.Col.Matcher"]</th><th>@L["Ext.Col.Command"]</th><th>@L["Ext.Col.Source"]</th></tr></thead>
                        <tbody>
                            @foreach (var h in hl.Rows)
                            {
                                var meta = string.Join(" · ", new[] { h.Type, h.Timeout is { } t ? $"{t} s" : null, h.Display }.Where(x => !string.IsNullOrEmpty(x)));
                                <tr>
                                    <td><div class="n">@h.Event</div></td>
                                    <td><code>@(h.Matcher.Length > 0 ? h.Matcher : "—")</code></td>
                                    <td><code class="hookcmd">@h.Command</code><div class="d">@meta</div></td>
                                    <td><span class="tag">@SourceTag(h.Source)</span><div class="d">@(h.Plugin ?? h.SourceLabel)</div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            }
            else if (s.Init is null && tab != "agents")
            {
                <p class="lead">@L["Ext.AfterFirstMessage"]</p>
            }
            else if (tab == "skills")
            {
                <table class="mcp">
                    <thead><tr><th>@L["Ext.Col.Skill"]</th><th>@L["Ext.Col.Description"]</th></tr></thead>
                    <tbody>
                        @foreach (var k in skills)
                        {
                            var d = Describe(s, k);
                            <tr><td><div class="n">@k</div></td><td><span class="last" style="max-width:72ch" title="@d">@d</span></td></tr>
                        }
                    </tbody>
                </table>
            }
            else if (tab == "agents")
            {
                <table class="mcp">
                    <thead><tr><th>@L["Agent.Title"]</th><th>@L["Ext.Col.Description"]</th><th>@L["Model"]</th></tr></thead>
                    <tbody>
                        @foreach (var (name, desc, model) in agents)
                        {
                            <tr><td><div class="n">@name</div></td><td><span class="last" style="max-width:64ch" title="@desc">@desc</span></td><td><span class="tag">@(model ?? "—")</span></td></tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <table class="mcp">
                    <thead><tr><th>@L["Ext.Col.Plugin"]</th><th class="num">@L["Ext.Col.McpServers"]</th><th class="num">@L["Ext.Tab.Skills"]</th></tr></thead>
                    <tbody>
                        @foreach (var p in plugins)
                        {
                            <tr>
                                <td><div class="n">@p</div></td>
                                <td class="num">@servers.Count(x => x.Origin == "plugin:" + p)</td>
                                <td class="num">@skills.Count(k => k.StartsWith(p + ":"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            </div>
        }
    </div>
</div>

@if (Ui.InspectorOpen && tab == "mcp" && Live is { } ls && Servers(ls).FirstOrDefault(x => x.Name == selected) is { } sel)
{
    <aside class="pane insp" aria-label="@L["Inspector"]">
        <div class="ph"><h2 class="ttl" title="@sel.Short">@sel.Short</h2><span class="sub">@sel.Origin</span></div>
        @if (sel.Status == "failed")
        {
            <div class="section">
                <h3>@L["Ext.FailedTitle"]</h3>
                @if (sel.Error is { } err)
                {
                    <div class="errbox">@err.TrimEnd()</div>
                }
                <p>@L["Ext.FailedText"]</p>
                <div class="acts">
                    <button class="btn primary" disabled="@busy" @onclick="() => Reconnect(ls, sel.Name)"><Icon Name="refresh" Sm="true" />@L["Ext.Retry"]</button>
                </div>
            </div>
        }
        else if (sel.Status == "needs-auth")
        {
            <div class="section">
                <h3>@L["Ext.AuthTitle"]</h3>
                <p>@L["Ext.AuthText"]</p>
                <p>@L["Ext.AuthHow"]</p>
                <div class="acts"><code>/mcp</code><button type="button" class="btn" data-copy="/mcp"><Icon Name="copy" Sm />@L["Md.Copy"]</button></div>
            </div>
        }
        <div class="section last">
            <div class="kv">
                <span>@L["Ext.Kv.Source"]</span><span>@sel.Origin</span>
                <span>@L["Ext.Kv.Transport"]</span><span>@(sel.Transport ?? "—")</span>
                @if (sel.Target is { } t)
                {
                    <span>@L["Ext.Kv.Target"]</span><span>@t</span>
                }
                <span>@L["Kv.Tools"]</span><span>@(sel.Tools?.ToString() ?? (sel.Status == "failed" ? "0" : "—"))</span>
                <span>@L["Ext.Kv.Scope"]</span><span>@(sel.Scope ?? "—")</span>
                @if (sel.Version is { } v)
                {
                    <span>@L["Ext.Kv.Version"]</span><span>@v</span>
                }
            </div>
        </div>
    </aside>
}

@code {
    record Srv(string Name, string Status, string Short, string Origin, string Tag, string? Error, string? Transport, string? Target, int? Tools, string? Scope, string? Version);

    string tab = "mcp", filter = "";
    string? selected, note, refreshedFor, hooksNote;
    bool busy;
    (List<HookRow> Rows, bool Disabled)? hooks;

    // The most recent session that has a claude process: mcp_status needs one, and starting one here would be a side effect.
    LiveSession? Live => Sessions.All.LastOrDefault(s => s.HasProcess);

    protected override void OnInitialized()
    {
        Sessions.Changed += OnChanged;
        Ui.Changed += OnChanged;
        if (RendererInfo.IsInteractive) _ = Refresh();   // mcp_status once, not again for the prerender
    }

    // Sessions.Changed is raised on the claude reader thread: touch component state on the renderer's dispatcher only.
    void OnChanged() => _ = InvokeAsync(async () =>
    {
        if (Live?.Id != refreshedFor) await Refresh();
        StateHasChanged();
    });

    async Task Refresh()
    {
        if (Live is not { } s) return;
        refreshedFor = s.Id;
        await Run(s.RefreshMcp);
        if (selected is null && Servers(s) is { Count: > 0 } all)
            selected = (all.FirstOrDefault(x => x.Status == "failed") ?? all[0]).Name;
        await LoadHooks(s);
    }

    // get_hooks_listing reads the settings files on every call: asked again whenever the tab is opened.
    // A process that exited since Show must not be respawned by Request: the tab only reads.
    async Task LoadHooks(LiveSession s)
    {
        if (!s.HasProcess) return;
        try { hooks = Events.Hooks(await s.Request("get_hooks_listing")); hooksNote = null; }
        catch (Exception ex) { hooks = null; hooksNote = L["Ext.Hooks.Failed", ex.Message.TrimEnd()]; }   // fire-and-forget from Show: nothing may escape
        await InvokeAsync(StateHasChanged);
    }

    void Show(string key)
    {
        tab = key;
        if (key == "hooks" && Live is { } s) _ = LoadHooks(s);
    }

    // userSettings / projectSettings / localSettings / pluginHook; anything else (policy…) as the CLI names it.
    static string SourceTag(string source) => source switch
    {
        "userSettings" => Strings.Get("Ext.Scope.User"),
        "projectSettings" => Strings.Get("Ext.Scope.Project"),
        "localSettings" => Strings.Get("Ext.Scope.Local"),
        "pluginHook" => Strings.Get("Ext.Scope.Plugin"),
        _ => source,
    };

    Task Toggle(LiveSession s, string name, bool enabled) =>
        Run(async () => { await s.Request("mcp_toggle", new() { ["serverName"] = name, ["enabled"] = enabled }); await s.RefreshMcp(); });

    // A server that still fails answers with its error: shown as the note.
    Task Reconnect(LiveSession s, string name) =>
        Run(async () => { try { await s.Request("mcp_reconnect", new() { ["serverName"] = name }); } finally { await s.RefreshMcp(); } });

    async Task Run(Func<Task> action)
    {
        busy = true; note = null;
        try { await action(); }
        catch (Exception ex) { note = L["Ext.ActionFailed", ex.Message.TrimEnd()]; }
        finally { busy = false; }
    }

    void Select(string name) { selected = name; Ui.InspectorOpen = true; }

    // mcp_status when available (error, transport, tools), else the init brief.
    static List<Srv> Servers(LiveSession s)
    {
        if (s.McpStatus is { } st && Events.Prop(st, "mcpServers") is { ValueKind: JsonValueKind.Array } arr)
            return arr.EnumerateArray().Select(m =>
            {
                var name = Events.Str(m, "name") ?? "";
                var scope = Events.Str(m, "scope");
                var cfg = Events.Prop(m, "config") ?? default;
                var (shortName, origin, tag) = Split(name, Events.Str(m, "source"), scope);
                return new Srv(name, Events.Str(m, "status") ?? "", shortName, origin, tag, Events.Str(m, "error"),
                    Events.Str(cfg, "type"), Target(cfg),
                    Events.Prop(m, "tools") is { ValueKind: JsonValueKind.Array } t ? t.GetArrayLength() : null,
                    scope, Events.Prop(m, "serverInfo") is { } si ? Events.Str(si, "version") : null);
            }).ToList();
        return (s.Init?.Mcp ?? []).Select(m =>
        {
            var (shortName, origin, tag) = Split(m.Name, null, null);
            return new Srv(m.Name, m.Status, shortName, origin, tag, null, null, null, null, null, null);
        }).ToList();
    }

    // url for http/sse, command line for stdio.
    static string? Target(JsonElement cfg)
    {
        if (Events.Str(cfg, "url") is { Length: > 0 } url) return url;
        if (Events.Str(cfg, "command") is not { } cmd) return null;
        return Events.Prop(cfg, "args") is { ValueKind: JsonValueKind.Array } a
            ? cmd + " " + string.Join(" ", a.EnumerateArray().Select(x => x.ToString())) : cmd;
    }

    // "plugin:github:github" → github / plugin:github; "claude.ai Gmail" → Gmail / claude.ai; else the scope.
    static (string Short, string Origin, string Tag) Split(string name, string? source, string? scope)
    {
        if (name.StartsWith("plugin:") && name.Split(':', 3) is [_, var p, var rest]) return (rest, "plugin:" + p, "plugin");
        if (name.StartsWith("claude.ai ")) return (name[10..], "claude.ai", "claude.ai");
        var origin = scope switch { "user" => Strings.Get("Ext.Scope.User"), "project" => Strings.Get("Ext.Scope.Project"), "local" => Strings.Get("Ext.Scope.Local"), _ => scope ?? source ?? "" };
        return (name, origin, source switch { null or "user" => Strings.Get("Ext.Scope.User"), "claudeai" => "claude.ai", _ => source });
    }

    static List<(string Name, string? Desc, string? Model)> Agents(LiveSession s) =>
        s.InitializeInfo is { } info && Events.Prop(info, "agents") is { ValueKind: JsonValueKind.Array } a
            ? a.EnumerateArray().Select(x => (Events.Str(x, "name") ?? "", Events.Str(x, "description"), Events.Str(x, "model"))).ToList()
            : (s.Init?.Agents ?? []).Select(n => (n, (string?)null, (string?)null)).ToList();

    static string? Describe(LiveSession s, string skill) =>
        s.InitializeInfo is { } info && Events.Prop(info, "commands") is { ValueKind: JsonValueKind.Array } c
            ? c.EnumerateArray().Where(x => Events.Str(x, "name") == skill).Select(x => Events.Str(x, "description")).FirstOrDefault()
            : null;

    RenderFragment Tab(string key, string label, int n) =>
        @<button id="ext-tab-@key" role="tab" aria-selected="@(tab == key ? "true" : "false")" aria-controls="ext-panel" tabindex="@(tab == key ? 0 : -1)"
                 class="@(tab == key ? "on" : null)" @onclick="() => Show(key)">@label<b>@n</b></button>;

    RenderFragment Filter(string key, string label, int n) =>
        @<button class="chip @(filter == key ? "on" : null)" aria-pressed="@(filter == key ? "true" : "false")" @onclick="() => filter = key">@label <b>@n</b></button>;

    RenderFragment State(string status) => status switch
    {
        "connected" => @<span class="ms ok"><i></i>@L["Ext.State.Connected"]</span>,
        "needs-auth" => @<span class="ms auth"><i></i>@L["Ext.State.NeedsAuth"]</span>,
        "failed" => @<span class="ms fail"><i></i>@L["Ext.State.Failed"]</span>,
        "disabled" => @<span class="ms off"><i></i>@L["Ext.State.Disabled"]</span>,
        "pending" => @<span class="ms wait"><i></i>@L["Ext.State.Pending"]</span>,
        _ => @<span class="ms off"><i></i>@status</span>,
    };

    public void Dispose()
    {
        Sessions.Changed -= OnChanged;
        Ui.Changed -= OnChanged;
    }
}
