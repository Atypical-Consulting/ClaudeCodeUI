@page "/settings/appearance"
@inject IJSRuntime JS

<PageTitle>@L["Nav.Appearance"] · Claude Code</PageTitle>

<div class="pane">
    <div class="ph"><h1 class="ttl">@L["Settings.Title"]</h1><span class="sub">@L["Nav.Appearance"]</span></div>
    <div class="settings">
        <div><h3>@L["Nav.Appearance"]</h3><p class="lead">@((MarkupString)L["Appearance.Lead"].Value)</p></div>
        <div class="set-row">
            <div><label for="lang"><b>@L["Appearance.Language"]</b></label><span>@L["Appearance.LanguageHint"]</span></div>
            @* A plain POST form: choosing an option changes nothing until Apply, then /culture sets the cookie and reloads. *@
            <form class="lang" method="post" action="culture">
                <AntiforgeryToken />
                <select id="lang" name="c">
                    @foreach (var (c, name) in Languages)
                    {
                        <option value="@c" lang="@c" selected="@(c == culture)">@name</option>
                    }
                </select>
                <button class="btn" type="submit">@L["Appearance.Apply"]</button>
            </form>
        </div>
        <div class="set-row">
            <div><b>@L["Appearance.Theme"]</b><span>@L["Appearance.ThemeHint"]</span></div>
            <div class="themes">
                @foreach (var k in Themes)
                {
                    var n = L["Theme." + k].Value;
                    @* data-theme scopes the preview to the card's own tokens *@
                    <button class="tc @(k == theme ? "on" : null)" data-theme="@k" aria-pressed="@(k == theme ? "true" : "false")" aria-label="@L["Appearance.ThemeLabel", n]" @onclick="() => SetTheme(k)">
                        <div class="pv">
                            <div class="rl"><i></i><i></i><i></i><i></i></div>
                            <div class="bd">
                                <div class="ln"><span style="color:var(--read)">Read</span> <span style="color:var(--fg-2)">Store.cs</span></div>
                                <div class="ln"><span style="color:var(--edit)">Edit</span> <span style="color:var(--fg-2)">Home.razor</span></div>
                                <div class="ln"><span style="color:var(--syn-kw)">static</span> <span style="color:var(--syn-type)">Store</span> <span style="color:var(--syn-fn)">Load</span><span style="color:var(--fg-3)">(</span><span style="color:var(--syn-str)">"cwd"</span><span style="color:var(--fg-3)">)</span></div>
                                <div class="ln" style="color:var(--syn-com);font-style:italic">// @n.ToLowerInvariant()</div>
                                <span class="btnp">@L["Perm.Allow"]</span>
                            </div>
                        </div>
                        <div class="nm"><b>@n</b><span class="sw"><i style="background:var(--syn-kw)"></i><i style="background:var(--syn-str)"></i><i style="background:var(--syn-fn)"></i><i style="background:var(--syn-type)"></i></span></div>
                    </button>
                }
            </div>
        </div>
        <div class="set-row">
            <div><b>@L["Appearance.CodeSize"]</b><span>@L["Appearance.CodeSizeHint"]</span></div>
            <div>
                <div class="seg" role="group" aria-label="@L["Appearance.CodeSize"]">
                    @foreach (var px in Sizes)
                    {
                        var v = px + "px";
                        <button class="@(v == size ? "on" : null)" aria-pressed="@(v == size ? "true" : "false")" @onclick="() => SetSize(v)">@px</button>
                    }
                </div>
            </div>
        </div>
        <div class="set-row">
            <div><b>@L["Appearance.Preview"]</b><span>@L["Appearance.PreviewHint"]</span></div>
            <div class="sample md">@((MarkupString)Sample)</div>
        </div>
    </div>
</div>

@code {
    static readonly string[] Themes = ["graphite", "encre", "ristretto", "mousse", "contraste"];
    // Each language is named in itself.
    static readonly (string Code, string Name)[] Languages = [("en", "English"), ("fr", "Français")];
    readonly string culture = System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    static readonly int[] Sizes = [12, 13, 14, 15];
    string Sample => Md.Render($$"""
        ```csharp
        // {{L["Appearance.SampleComment"]}}
        Mood MoodFor(Session s) => s.State switch
        {
            State.WaitingPermission => Mood.Shocked,
            State.Running           => Mood.Excited,
            State.Crashed           => Mood.Ko,
            _                       => Mood.Happy,
        };
        ```
        """);

    string? theme, size;

    // localStorage is only reachable once the circuit is up.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        theme = await JS.InvokeAsync<string>("claudeUi.getTheme");
        size = await JS.InvokeAsync<string>("claudeUi.getCodeSize");
        StateHasChanged();
    }

    async Task SetTheme(string k)
    {
        theme = k;
        await JS.InvokeVoidAsync("claudeUi.setTheme", k);
    }

    async Task SetSize(string v)
    {
        size = v;
        await JS.InvokeVoidAsync("claudeUi.setCodeSize", v);
    }
}
