@page "/Error"
@attribute [ExcludeFromInteractiveRouting]
@attribute [Microsoft.AspNetCore.Antiforgery.RequireAntiforgeryToken(required: false)]
@using System.Diagnostics
@using Microsoft.AspNetCore.Diagnostics

<StatusScreen Code="500" Path="@path" RequestId="@requestId" />

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    string? requestId, path;

    protected override void OnInitialized()
    {
        requestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
        path = HttpContext?.Features.Get<IExceptionHandlerPathFeature>()?.Path;
    }
}
