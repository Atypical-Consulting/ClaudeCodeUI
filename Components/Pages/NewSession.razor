@page "/"
@using System.Diagnostics
@inject SessionManager Sessions
@inject NavigationManager Nav

<PageTitle>@L["Rail.NewSession"] · Claude Code</PageTitle>

<div class="pane">
    <div class="ph"><span class="ttl">@L["Rail.NewSession"]</span></div>
    <div class="start">
        @if (!claudeFound)
        {
            <div class="start-card">
                <div class="hello">
                    <div class="duck"><BlazorKawaii.Components.RubberDuck Mood="Mood.Ko" Size="88" Color="#FCCC0A" /></div>
                    <div><h3>@L["New.NotFound"]</h3><p>@((MarkupString)L["New.NotFoundText"].Value)</p></div>
                </div>
                <div class="field">
                    <label>@L["New.Step1"]</label>
                    <p>@L["New.Unix"] <code>curl -fsSL https://claude.ai/install.sh | bash</code></p>
                    <p>@L["New.Windows"] <code>irm https://claude.ai/install.ps1 | iex</code></p>
                    <p>@L["New.Guide"] <a href="https://docs.claude.com/en/docs/claude-code/setup" target="_blank" rel="noopener" style="color:var(--accent)">docs.claude.com</a></p>
                </div>
                <div class="field">
                    <label>@L["New.Step2"]</label>
                    <p>@((MarkupString)L["New.Step2Text"].Value)</p>
                </div>
                <div class="field">
                    <label>@L["New.Step3"]</label>
                    <p>@((MarkupString)L["New.Step3Text"].Value)</p>
                </div>
                <div class="row"><button class="btn primary" @onclick="() => claudeFound = ClaudeSession.OnPath()">@L["New.CheckAgain"]</button></div>
            </div>
        }
        else
        {
        <div class="start-card">
            <div class="hello">
                <div class="duck"><BlazorKawaii.Components.RubberDuck Mood="Mood.Happy" Size="88" Color="#FCCC0A" /></div>
                <div><h3>@L["New.Hello"]</h3><p>@L["New.HelloText"]</p></div>
            </div>
            <div class="field">
                <label for="cwd">@L["New.Folder"]</label>
                <div class="input"><Icon Name="folder" /><input id="cwd" value="@cwd" @onchange="e => SetCwd(e.Value?.ToString() ?? string.Empty)" spellcheck="false" autocomplete="off" /></div>
                @if (!exists)
                {
                    <div style="margin-top:8px;font-size:12.5px;color:var(--err-fg)">@L["New.NoFolder"]</div>
                }
                @if (recents.Count > 0)
                {
                    <div class="recents">
                        @foreach (var r in recents)
                        {
                            <button class="chip" title="@r" @onclick="() => SetCwd(r)">@Chip(r)</button>
                        }
                    </div>
                }
            </div>
            <div class="field">
                <label>Isolation</label>
                <div class="input" style="font-family:var(--sans)">
                    <button class="toggle @(Isolated ? "on" : null)" role="switch" aria-checked="@(Isolated ? "true" : "false")" disabled="@(branch is null)"
                            @onclick="() => worktree = !worktree"><span class="sw"></span>@L["New.Worktree"]</button>
                    @if (branch is null && RendererInfo.IsInteractive)
                    {
                        <span class="branch" style="margin-left:14px">@L["New.NotGit"]</span>
                    }
                    else if (Isolated && editing)
                    {
                        <span class="branch" style="margin-left:14px;flex:none"><Icon Name="branch" />worktree-</span>
                        <input value="@WtName" @onchange="SetName" aria-label="@L["New.WorktreeName"]" spellcheck="false" />
                        <button class="b btn ghost" @onclick="() => editing = false">OK</button>
                    }
                    else if (Isolated)
                    {
                        <span class="branch" style="margin-left:14px"><Icon Name="branch" />@L["New.WorktreeFrom", "worktree-" + WtName, branch]</span>
                        <button class="b btn ghost" @onclick="() => editing = true">@L["New.Edit"]</button>
                    }
                </div>
            </div>
            <div class="field">
                <label>Permissions</label>
                <div class="modes" role="radiogroup" aria-label="Permissions">
                    @foreach (var m in Modes)
                    {
                        <button class="mode @(mode == m ? "on" : null)" role="radio" aria-checked="@(mode == m ? "true" : "false")" @onclick="() => mode = m"><b>@m</b><span>@L["Mode." + m]</span></button>
                    }
                </div>
            </div>
            <div>
                <div class="box" style="max-width:none">
                    <textarea @bind="prompt" @bind:event="oninput" @onkeydown="Keys" placeholder="@L["New.Placeholder"]" aria-label="@L["New.FirstMessage"]"></textarea>
                    <div class="row"><button class="btn primary go" disabled="@(busy || !exists)" @onclick="Start">@L["New.Start"] <kbd>Ctrl ⏎</kbd></button></div>
                </div>
            </div>
            <div class="hint"><span><kbd>Ctrl K</kbd> @L["New.HintSwitch"]</span><span><kbd>Alt N</kbd> @L["New.HintNew"]</span><span><kbd>Ctrl I</kbd> @L["New.HintInspector"]</span></div>
        </div>
        }
    </div>
</div>

@code {
    // "default" is sent as "manual" by LiveSession. bypassPermissions / dontAsk are deliberately not offered.
    static readonly string[] Modes = ["default", "acceptEdits", "plan", "auto"];

    [SupplyParameterFromQuery(Name = "cwd")] public string? Query { get; set; }

    string cwd = Directory.GetCurrentDirectory(), prompt = "", mode = "default";
    string? branch, wtName, lastQuery;
    bool exists = true, worktree = true, editing, busy;
    List<string> recents = [];
    bool claudeFound = true;   // probed once interactive, not during the prerender

    bool Isolated => worktree && branch is not null;
    string WtName => wtName ?? (TranscriptStore.NameFrom(prompt) is { Length: > 0 } n ? n : "session");

    protected override void OnInitialized()
    {
        if (!RendererInfo.IsInteractive) return;
        claudeFound = ClaudeSession.OnPath();
        recents = TranscriptStore.Recent().Select(p => TranscriptStore.RootOf(p.Cwd)).Distinct(StringComparer.OrdinalIgnoreCase)
            .Where(Directory.Exists).Take(5).ToList();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Query is { Length: > 0 } q && q != lastQuery) { lastQuery = q; cwd = q; }
        await SetCwd(cwd);
    }

    async Task SetCwd(string value)
    {
        cwd = value.Trim().Trim('"');
        exists = Local(cwd);
        branch = exists && RendererInfo.IsInteractive ? await Branch(cwd) : null;   // no git process for the prerender
    }

    // Local absolute folders only: ?cwd= can come from any web page (prerender included), and a UNC path makes Windows authenticate to its host.
    static bool Local(string d) => Path.IsPathFullyQualified(d) && !d.StartsWith(@"\\") && !d.StartsWith("//") && Directory.Exists(d);

    // Current branch ("HEAD" when detached), null outside a git repo.
    static async Task<string?> Branch(string dir)
    {
        try
        {
            var psi = new ProcessStartInfo("git") { RedirectStandardOutput = true, RedirectStandardError = true, CreateNoWindow = true };
            foreach (var a in new[] { "-C", dir, "branch", "--show-current" }) psi.ArgumentList.Add(a);
            using var p = Process.Start(psi)!;
            var output = (await p.StandardOutput.ReadToEndAsync()).Trim();
            await p.WaitForExitAsync();
            return p.ExitCode != 0 ? null : output.Length > 0 ? output : "HEAD";
        }
        catch (Exception) { return null; }
    }

    // ~/repo/api; long paths keep their last two folders.
    internal static string Chip(string dir)
    {
        var s = TranscriptStore.Short(dir).Replace('\\', '/');
        return s.Length <= 32 ? s : "…/" + string.Join('/', s.Split('/')[^2..]);
    }

    void SetName(ChangeEventArgs e) => wtName = TranscriptStore.NameFrom(e.Value?.ToString() ?? "", 8) is { Length: > 0 } n ? n : null;

    async Task Keys(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && (e.CtrlKey || e.MetaKey)) await Start();
    }

    async Task Start()
    {
        if (busy) return;
        if (!(exists = Local(cwd))) return;
        busy = true;
        var name = Isolated ? WtName : TranscriptStore.NameFrom(prompt) is { Length: > 0 } n ? n : Path.GetFileName(Path.TrimEndingDirectorySeparator(cwd));
        var s = Sessions.Start(cwd, mode, name, Isolated ? WtName : null, null, null);
        if (prompt.Trim() is { Length: > 0 } text)
        {
            try { await s.Send(text); }
            catch (Exception ex) { Console.Error.WriteLine($"[{s.Id}] premier message : {ex.Message}"); }   // the session page shows the crash
        }
        Nav.NavigateTo($"session/{s.Id}");
    }
}
