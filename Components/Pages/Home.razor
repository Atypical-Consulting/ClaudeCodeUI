@using System.Text.Json
@implements IAsyncDisposable

<PageTitle>Claude Code</PageTitle>

<div class="chat">
    <header>
        <strong>Claude Code</strong>
        <input @bind="cwd" title="Working directory" disabled="@(session is not null)" />
        <select @bind="mode" title="Permission mode" disabled="@(session is not null)">
            <option>default</option>
            <option>acceptEdits</option>
            <option>plan</option>
            <option>auto</option>
        </select>
        <button @onclick="NewSession">New session</button>
    </header>

    <main>
        <div>
            @foreach (var e in entries)
            {
                @switch (e.Kind)
                {
                    case "tool":
                    case "tool-result":
                    case "tool-error":
                        <details class="entry @e.Kind">
                            <summary>@e.Title</summary>
                            <pre>@e.Body</pre>
                        </details>
                        break;
                    case "assistant":
                        <div class="assistant">@((MarkupString)Md.Render(e.Body))</div>
                        break;
                    default:
                        <div class="entry @e.Kind">@e.Body</div>
                        break;
                }
            }
            @foreach (var p in pending)
            {
                <div class="permission">
                    <div>Allow <strong>@p.Tool</strong>?</div>
                    <pre>@Pretty(p.Input)</pre>
                    <button @onclick="() => Answer(p, true)">Allow</button>
                    <button class="deny" @onclick="() => Answer(p, false)">Deny</button>
                </div>
            }
            @if (busy && pending.Count == 0) { <div class="entry meta">thinking…</div> }
        </div>
    </main>

    <form @onsubmit="Send">
        <textarea @bind="prompt" @bind:event="oninput" placeholder="Ask Claude… (Ctrl+Enter to send)" disabled="@busy" @onkeydown="OnKey"></textarea>
        @if (busy) { <button type="button" @onclick="() => session!.Interrupt()">Stop</button> }
        else { <button type="submit">Send</button> }
    </form>
</div>

@code {

    record Entry(string Kind, string Body, string Title = "");
    record Permission(string Id, string Tool, JsonElement Input);

    readonly List<Entry> entries = [];
    readonly List<Permission> pending = [];
    string cwd = Directory.GetCurrentDirectory();
    string mode = "default";
    string prompt = "";
    bool busy;
    ClaudeSession? session;

    async Task NewSession()
    {
        if (session is not null) await session.DisposeAsync();
        session = null;
        busy = false;
        entries.Clear();
        pending.Clear();
    }

    async Task OnKey(KeyboardEventArgs k)
    {
        if (k.Key == "Enter" && k.CtrlKey) await Send();
    }

    async Task Send()
    {
        if (busy || string.IsNullOrWhiteSpace(prompt)) return;
        var text = prompt;
        prompt = "";
        entries.Add(new("user", text));
        busy = true;
        session ??= Start();
        await session.SendUser(text);
    }

    ClaudeSession Start()
    {
        ClaudeSession s = null!;
        s = new(cwd, ["--permission-mode", mode == "default" ? "manual" : mode],
            evt => InvokeAsync(() => { Handle(evt); StateHasChanged(); }),
            (_, exit) => InvokeAsync(() =>
            {
                if (session != s) return; // a disposed session exiting is expected
                entries.Add(new("error", exit));
                session = null;
                busy = false;
                pending.Clear();
                StateHasChanged();
            }));
        return s;
    }

    async Task Answer(Permission p, bool allow)
    {
        pending.Remove(p);
        entries.Add(new("meta", $"{(allow ? "allowed" : "denied")} {p.Tool}"));
        await session!.Respond(p.Id, allow, p.Input);
    }

    public async ValueTask DisposeAsync()
    {
        if (session is not null) await session.DisposeAsync();
    }

    void Handle(JsonElement evt)
    {
        switch (Str(evt, "type"))
        {
            case "assistant":
                foreach (var c in evt.GetProperty("message").GetProperty("content").EnumerateArray())
                {
                    if (Str(c, "type") == "text")
                        entries.Add(new("assistant", Str(c, "text") ?? ""));
                    else if (Str(c, "type") == "tool_use")
                    {
                        var input = c.GetProperty("input");
                        var target = Str(input, "file_path") ?? Str(input, "command") ?? Str(input, "pattern") ?? Str(input, "description");
                        entries.Add(new("tool", Pretty(input), $"{Str(c, "name")}  {target}"));
                    }
                }
                break;

            case "user":
                if (evt.GetProperty("message").GetProperty("content") is { ValueKind: JsonValueKind.Array } blocks)
                    foreach (var c in blocks.EnumerateArray().Where(c => Str(c, "type") == "tool_result"))
                    {
                        var isErr = c.TryGetProperty("is_error", out var e) && e.ValueKind == JsonValueKind.True;
                        var body = ResultText(c.GetProperty("content"));
                        var first = body.Split('\n')[0];
                        entries.Add(new(isErr ? "tool-error" : "tool-result", body, first.Length > 100 ? first[..100] + "…" : first));
                    }
                break;

            case "control_request" when Str(evt.GetProperty("request"), "subtype") == "can_use_tool":
                var req = evt.GetProperty("request");
                pending.Add(new(Str(evt, "request_id")!, Str(req, "tool_name")!, req.GetProperty("input")));
                break;

            case "control_cancel_request":
                pending.RemoveAll(p => p.Id == Str(evt, "request_id"));
                break;

            case "result":
                busy = false;
                var cost = evt.TryGetProperty("total_cost_usd", out var c2) ? $" · ${c2.GetDouble():0.0000}" : "";
                var ms = evt.TryGetProperty("duration_ms", out var d) ? $" · {d.GetInt32() / 1000.0:0.0}s" : "";
                entries.Add(new("meta", $"{Str(evt, "subtype")}{ms}{cost}"));
                break;
        }
    }

    static string? Str(JsonElement e, string name) =>
        e.ValueKind == JsonValueKind.Object && e.TryGetProperty(name, out var v) && v.ValueKind == JsonValueKind.String ? v.GetString() : null;

    static string Pretty(JsonElement e) => JsonSerializer.Serialize(e, new JsonSerializerOptions { WriteIndented = true });

    static string ResultText(JsonElement content) => content.ValueKind switch
    {
        JsonValueKind.String => content.GetString()!,
        JsonValueKind.Array => string.Join("\n", content.EnumerateArray().Select(b => Str(b, "text") ?? $"[{Str(b, "type")}]")),
        _ => content.ToString(),
    };
}
