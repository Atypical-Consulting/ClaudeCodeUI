@page "/worktrees"
@implements IDisposable
@inject WorktreeService Wt
@inject SessionManager Sessions
@inject UiState Ui
@inject NavigationManager Nav

<PageTitle>Worktrees · Claude Code</PageTitle>

<div class="pane">
    <div class="ph">
        <h1 class="ttl">Worktrees</h1>
        @if (rows is not null)
        {
            <span class="sub">@Plural(repos.Count, "Wt.Repos") · @Items(rows) · @SizeOf(rows)</span>
        }
        <span class="end"><button class="btn" disabled="@scanning" @onclick="() => Scan(true)"><Icon Name="refresh" Sm="true" />@L["Wt.Refresh"]</button></span>
    </div>
    <div class="wt">
        @if (rows is null)
        {
            <div class="wt-head"><div><h3>@L["Wt.Scanning"]</h3><p>@L["Wt.ScanningText"]</p></div></div>
        }
        else
        {
            var safe = rows.Where(w => w.State is WtState.Safe or WtState.Orphan).ToList();
            var check = rows.Count(w => w.State == WtState.Check);
            <div class="wt-head"><div>
                @if (safe.Count == 0)
                {
                    <h3>@L["Wt.NothingToClean"]</h3>
                }
                else
                {
                    <h3>@(safe.Any(w => w.BranchOnly) ? L["Wt.SafeMixed", Items(safe)] : safe.Count == 1 ? L["Wt.Safe1"] : L["Wt.SafeN", safe.Count])</h3>
                }
                <p>@(safe.Count > 0 ? L["Wt.Recoverable", SizeOf(safe)] + " " : "")@(check switch { 0 => L["Wt.Check0"], 1 => L["Wt.Check1"], _ => L["Wt.CheckN", check] })@L["Wt.NothingActive"]</p>
            </div></div>
            @foreach (var r in unignored)
            {
                <div class="guard"><Icon Name="shield" Sm="true" /><span>@((MarkupString)L["Wt.Unignored", $"<b title=\"{Enc(r)}\">{Enc(Path.GetFileName(r))}</b>"].Value)</span></div>
            }
            @foreach (var e in errors)
            {
                <div class="errbox" role="alert">@e</div>
            }
            <div class="filters">
                <button class="chip @(filter is null ? "on" : null)" aria-pressed="@(filter is null ? "true" : "false")" @onclick="() => filter = null">@L["Filter.All"] <b>@rows.Count</b></button>
                <button class="chip @(filter == WtState.Safe ? "on" : null)" aria-pressed="@(filter == WtState.Safe ? "true" : "false")" @onclick="() => filter = WtState.Safe"><span class="state st-safe"><i></i></span>@L["Wt.Filter.Safe"] <b>@Count(WtState.Safe)</b></button>
                <button class="chip @(filter == WtState.Orphan ? "on" : null)" aria-pressed="@(filter == WtState.Orphan ? "true" : "false")" @onclick="() => filter = WtState.Orphan">@L["Wt.Filter.Orphan"] <b>@Count(WtState.Orphan)</b></button>
                <button class="chip @(filter == WtState.Check ? "on" : null)" aria-pressed="@(filter == WtState.Check ? "true" : "false")" @onclick="() => filter = WtState.Check">@L["Wt.State.Check"] <b>@Count(WtState.Check)</b></button>
                <button class="chip @(filter == WtState.Active ? "on" : null)" aria-pressed="@(filter == WtState.Active ? "true" : "false")" @onclick="() => filter = WtState.Active">@L["Wt.Filter.Active"] <b>@Count(WtState.Active)</b></button>
            </div>
            <table class="wtt">
                <thead><tr><th>Worktree</th><th>@L["Col.State"]</th><th>@L["Wt.Col.Why"]</th><th class="num">@L["Wt.Col.Size"]</th><th><span class="vh">@L["Col.Actions"]</span></th></tr></thead>
                <tbody>
                    @foreach (var (title, states) in groups)
                    {
                        var g = rows.Where(w => states.Contains(w.State) && (filter is null || w.State == filter)).ToList();
                        if (g.Count == 0) continue;
                        <tr class="grp-row"><td colspan="5">@L[title]</td></tr>
                        @foreach (var w in g)
                        {
                            <tr class="@(w.Path == selected || plan.Contains(w.Path) ? "sel" : w.State == WtState.Orphan ? "dim" : null)" @key="w.Path">
                                <td><div class="n">@(w.Name)@if (w.BranchOnly) { <span class="tag" style="margin-left:6px">@L["Wt.BranchTag"]</span> }</div><div class="branch"><Icon Name="branch" />@(w.BranchOnly ? "" : (w.Branch ?? (w.State == WtState.Orphan ? L["Wt.BranchMissing"] : L["Wt.Detached"])) + " · ")@Path.GetFileName(w.Repo)</div></td>
                                <td><span class="state st-@Css(w.State)"><i></i>@WorktreeService.Label(w.State)</span></td>
                                <td class="why" title="@w.Path">@((MarkupString)w.Why)</td>
                                <td class="num">@(w.State == WtState.Orphan || w.BranchOnly ? "—" : sizes.TryGetValue(w.Path, out var sz) ? Fmt.Size(sz) : "…")</td>
                                <td><div class="rowacts">
                                    @if (WorktreeService.Cleanable(w))
                                    {
                                        @if (plan.Contains(w.Path))
                                        {
                                            <button class="btn ghost" disabled="@running" aria-label="@($"{L["Wt.Unplan"]} {w.Name}")" @onclick="() => plan.Remove(w.Path)">@L["Wt.Unplan"]</button>
                                        }
                                        else
                                        {
                                            <button class="btn" disabled="@running" aria-label="@($"{(w.State == WtState.Orphan ? L["Wt.Prune"] : L["Wt.Delete"])} {w.Name}")" @onclick="() => Add(w)">@(w.State == WtState.Orphan ? L["Wt.Prune"] : L["Wt.Delete"])</button>
                                        }
                                    }
                                    else if (w.State == WtState.Active)
                                    {
                                        if (SessionOf(w) is { } s)
                                        {
                                            <button class="btn" aria-label="@($"{L["Wt.Go"]} {w.Name}")" @onclick='() => Nav.NavigateTo($"session/{s.Id}")'>@L["Wt.Go"]</button>
                                        }
                                    }
                                    else if (w.Unpushed > 0 && w.Dirty == 0 && w.Branch is not null && !w.BranchOnly)
                                    {
                                        <button class="btn" disabled="@running" aria-label="@($"{L["Wt.Push"]} {w.Name}")" @onclick="() => { selected = w.Path; push = w; pushResult = null; }">@L["Wt.Push"]</button>
                                    }
                                    else if (!w.BranchOnly)
                                    {
                                        <button class="btn" aria-label="@($"{L["Action.Open"]} {w.Name}")" @onclick='() => Nav.NavigateTo("?cwd=" + Uri.EscapeDataString(Path.GetFullPath(w.Path)))'>@L["Action.Open"]</button>
                                    }
                                </div></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@if (Ui.InspectorOpen)
{
    var chosen = rows?.Where(w => plan.Contains(w.Path)).ToList() ?? [];
    <aside class="pane insp" aria-label="@L["Inspector"]">
        <div class="ph"><h2 class="ttl">@L["Wt.Cleanup"]</h2><span class="sub">@Items(chosen)@(chosen.Count > 0 ? " · " + SizeOf(chosen) : "")</span></div>
        @if (push is { } pw)
        {
            <div class="section">
                <h3>@L["Wt.PushTitle", pw.Name]</h3>
                <p>@((MarkupString)(pw.Unpushed == 1 ? L["Wt.Unpushed1", Enc(pw.Branch)] : L["Wt.UnpushedN", pw.Unpushed, Enc(pw.Branch)]).Value)</p>
                <div class="cmdlog" role="status">@CmdLog([new(pw.Path, $"git push -u origin {pw.Branch}", pushResult)])</div>
                <div class="acts">
                    @if (pushResult != "ok")
                    {
                        <button class="btn primary" disabled="@running" @onclick="() => Push(pw)">@L["Wt.Push"]</button>
                    }
                    <button class="btn ghost" @onclick="() => { push = null; selected = null; }">@(pushResult == "ok" ? L["Action.Close"] : L["Action.Cancel"])</button>
                </div>
            </div>
        }
        <div class="section">
            <h3>@L["Wt.WhatHappens"]</h3>
            @if (chosen.Count == 0 && log.Count == 0)
            {
                <p>@L["Wt.NothingPlanned"]</p>
                var all = rows?.Where(w => w.State is WtState.Safe or WtState.Orphan).ToList() ?? [];
                @if (all.Count > 0)
                {
                    <div class="acts"><button class="btn" @onclick="() => plan.UnionWith(all.Select(w => w.Path))">@L["Wt.AddSafe", Items(all)]</button></div>
                }
            }
            else
            {
                @if (chosen.Count > 0)
                {
                    <div class="plan">
                        @foreach (var w in chosen)
                        {
                            <div class="it"><Icon Name="check" Sm="true" /><div><div class="n">@w.Name</div><div class="w">@What(w)</div></div><span class="sz">@(w.State == WtState.Orphan || w.BranchOnly ? "—" : sizes.TryGetValue(w.Path, out var sz) ? Fmt.Size(sz) : "…")</span></div>
                        }
                    </div>
                }
                <div class="cmdlog">@CmdLog(log.Count > 0 ? log : Preview(chosen))</div>
                <div class="guard"><Icon Name="shield" Sm="true" /><span>@((MarkupString)L["Wt.NeverForce"].Value)</span></div>
                <div class="acts">
                    @if (log.Count == 0)
                    {
                        <button class="btn primary" disabled="@(running || chosen.Count == 0)" @onclick="() => Run(chosen)">@L["Wt.CleanN", Items(chosen)]</button>
                        <button class="btn ghost" @onclick="() => plan.Clear()">@L["Action.Cancel"]</button>
                    }
                    else
                    {
                        <button class="btn" disabled="@running" @onclick="() => { log.Clear(); plan.Clear(); }">@L["Action.Close"]</button>
                    }
                </div>
            }
        </div>
    </aside>
}

@code {
    static readonly (string, WtState[])[] groups = [("Wt.Group.Go", [WtState.Safe, WtState.Orphan]), ("Wt.State.Check", [WtState.Check]), ("Wt.Filter.Active", [WtState.Active])];   // titles are resource keys

    record LogLine(string Repo, string Cmd, string? Result);

    List<WorktreeInfo>? rows;
    IReadOnlyList<string> repos = [];
    List<string> unignored = [], errors = [];
    readonly System.Collections.Concurrent.ConcurrentDictionary<string, long> sizes = new();
    readonly HashSet<string> plan = [];
    readonly List<LogLine> log = [];
    WtState? filter;
    string? selected, pushResult;
    WorktreeInfo? push;
    bool scanning, running;
    readonly CancellationTokenSource cts = new();

    protected override void OnInitialized() => Ui.Changed += Refresh;
    protected override Task OnInitializedAsync() => RendererInfo.IsInteractive ? Scan(false) : Task.CompletedTask;   // not twice: prerender shows "Scanning"
    void Refresh() => InvokeAsync(StateHasChanged);

    async Task Scan(bool refresh)
    {
        if (scanning) return;
        scanning = true;
        try
        {
            var ct = cts.Token;
            repos = await Wt.DiscoverReposAsync(refresh, ct);
            var found = new List<WorktreeInfo>();
            List<string> bad = [], errs = [];
            foreach (var r in repos)
            {
                try
                {
                    var list = await Wt.ScanAsync(r, ct);
                    found.AddRange(list);
                    if (list.Count > 0 && !await Wt.IgnoresWorktreesAsync(r, ct)) bad.Add(r);
                }
                catch (InvalidOperationException e) { errs.Add(L["Wt.RepoError", Home(r), e.Message]); }
            }
            (rows, unignored, errors) = (found, bad, errs);
            if (refresh) sizes.Clear();
            plan.RemoveWhere(p => !found.Any(w => w.Path == p && WorktreeService.Cleanable(w)));
            foreach (var w in found.Where(w => w.State != WtState.Orphan && !w.BranchOnly && !sizes.ContainsKey(w.Path))) _ = Measure(w.Path, ct);
        }
        catch (OperationCanceledException) { }
        catch (InvalidOperationException e) { (rows, unignored, errors) = ([], [], [e.Message]); }   // git missing: no repo can be resolved
        finally { scanning = false; }
    }

    async Task Measure(string path, CancellationToken ct)
    {
        try { sizes[path] = await Wt.SizeAsync(path, ct); await InvokeAsync(StateHasChanged); }
        catch (Exception) { }
    }

    void Add(WorktreeInfo w)
    {
        log.Clear();
        plan.Add(w.Path);
    }

    // .cmdlog is white-space:pre: built as one encoded string, "# repo" comments and results dimmed.
    static MarkupString CmdLog(IEnumerable<LogLine> lines)
    {
        var enc = System.Text.Encodings.Web.HtmlEncoder.Default;
        var sb = new System.Text.StringBuilder();
        foreach (var g in lines.GroupBy(l => l.Repo))
        {
            if (sb.Length > 0) sb.Append('\n');
            sb.Append($"<span class=\"c\"># {enc.Encode(Short(Home(g.Key)))}</span>");
            foreach (var l in g)
            {
                sb.Append('\n').Append(enc.Encode(l.Cmd));
                if (l.Result is not null) sb.Append($"\n<span class=\"c\">→ {enc.Encode(l.Result)}</span>");
            }
        }
        return new(sb.ToString());
    }

    IEnumerable<LogLine> Preview(List<WorktreeInfo> chosen) => Wt.Plan(chosen).Select(s => new LogLine(s.Repo, s.Display, null));

    async Task Run(List<WorktreeInfo> chosen)
    {
        if (running) return;
        var steps = Wt.Plan(chosen);
        running = true;
        log.Clear();
        try
        {
            await foreach (var (step, exit, output) in Wt.RunAsync(steps, cts.Token))
            {
                var first = output.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                log.Add(new(step.Repo, step.Display, exit switch
                {
                    0 => first.Length > 0 && step.GitArgs[1] == "prune" ? string.Join(" · ", first) : "ok",
                    -1 => output,
                    _ => L["Wt.ExitOutput", exit, string.Join(" · ", first)],
                }));
                StateHasChanged();
            }
        }
        catch (OperationCanceledException) { }
        catch (InvalidOperationException e) { log.Add(new(chosen[0].Repo, "git", e.Message)); }
        finally { running = false; }
        plan.Clear();
        await Scan(false);
    }

    async Task Push(WorktreeInfo w)
    {
        if (running) return;
        running = true;
        pushResult = "…";
        var exit = -1;
        try
        {
            exit = await Wt.PushAsync(w);
            pushResult = exit == 0 ? "ok" : $"exit {exit}";
        }
        catch (InvalidOperationException e) { pushResult = e.Message; }
        finally { running = false; }
        if (exit == 0) await Scan(false);
    }

    LiveSession? SessionOf(WorktreeInfo w) => Sessions.All.FirstOrDefault(s => s.HasProcess && Path.GetFullPath(s.Cwd).Replace('\\', '/').StartsWith(w.Path, StringComparison.OrdinalIgnoreCase));

    // "5 worktrees + 21 branches": branch-only rows are not worktrees.
    string Items(IReadOnlyCollection<WorktreeInfo> ws)
    {
        var b = ws.Count(w => w.BranchOnly);
        var n = ws.Count - b;
        return b == 0 ? Plural(n, "Wt.Worktrees") : n == 0 ? Plural(b, "Wt.Branches") : Plural(n, "Wt.Worktrees") + " + " + Plural(b, "Wt.Branches");
    }

    int Count(WtState s) => rows!.Count(w => w.State == s);

    string SizeOf(IEnumerable<WorktreeInfo> ws)
    {
        var known = ws.Where(w => w.State != WtState.Orphan && !w.BranchOnly).ToList();
        return known.All(w => sizes.ContainsKey(w.Path)) ? Fmt.Size(known.Sum(w => sizes[w.Path])) : "…";
    }

    string What(WorktreeInfo w) => w.BranchOnly ? L["Wt.What.BranchOnly"] : w.State == WtState.Orphan ? L["Wt.What.RefOnly"]
        : (w.Locked ? L["Wt.What.Unlock"] : "") + L[w.Branch is null ? "Wt.What.Detached"
        : w.SquashMerged && !w.Merged ? "Wt.What.FolderOnly" : "Wt.What.FolderAndBranch"];

    static string Css(WtState s) => s switch { WtState.Safe => "safe", WtState.Orphan => "orphan", WtState.Active => "active", _ => "check" };

    // <key>1 for one, <key>N otherwise ("0 dépôt" in French is singular, "0 repositories" in English: <key>0).
    string Plural(int n, string key) => L[key + (n switch { 0 => "0", 1 => "1", _ => "N" }), n];

    static string Enc(string? s) => System.Text.Encodings.Web.HtmlEncoder.Default.Encode(s ?? "");

    static string Short(string path) => path.Length > 48 ? "…" + path[^47..] : path;   // .cmdlog does not wrap

    static string Home(string path)
    {
        var home = Environment.GetFolderPath(Environment.SpecialFolder.UserProfile).Replace('\\', '/');
        return path.StartsWith(home, StringComparison.OrdinalIgnoreCase) ? "~" + path[home.Length..] : path;
    }

    public void Dispose()
    {
        Ui.Changed -= Refresh;
        cts.Cancel();
    }
}
