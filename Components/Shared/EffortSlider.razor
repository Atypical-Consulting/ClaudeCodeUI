@* Ordered levels on a native range (arrows, Home/End, touch and AT come for free), their names as clickable ticks under it.
   Equal columns keep each tick centred under its thumb position (app.css). *@
<span class="effort-slider" style="--n:@Reach;--k:@Reach">
    <input type="range" id="@Id" min="0" max="@(Reach - 1)" step="1" value="@Shown" style="--p:@P" aria-label="@Label"
           aria-valuetext="@(Shown >= 0 ? Name(Levels[Shown]) : null)"
           @oninput="e => Drag(int.Parse((string)e.Value!))" @onchange="e => Pick(int.Parse((string)e.Value!))" />
    @* The range already carries name and value for AT and the keyboard: the ticks are a mouse shortcut. *@
    @for (var i = 0; i < Reach; i++)
    {
        var n = i;
        <button type="button" tabindex="-1" aria-hidden="true" class="@(n == Shown ? "on" : null)" @onclick="() => Pick(n)">@Name(Levels[n])</button>
    }
</span>

@code {
    static int seq;
    [Parameter] public IReadOnlyList<string> Levels { get; set; } = [];
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public Func<string, string> Name { get; set; } = s => s;
    [Parameter] public string Id { get; set; } = "effort-" + Interlocked.Increment(ref seq);
    [Parameter] public string? Label { get; set; }

    int? drag;   // the thumb while dragging: the fill and the tick follow it before the change commits

    int Reach => Levels.Count;
    int Shown => drag ?? Index(Levels, Value, Reach);
    string P => Reach > 1 ? (Math.Max(Shown, 0) / (double)(Reach - 1)).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture) : "0";
    // -1 for a value the range does not hold (unknown effort): no tick lights up.
    internal static int Index(IReadOnlyList<string> stops, string value, int reach) => stops.Take(reach).ToList().IndexOf(value);

    // Dragged back to where it started, release fires no change: drop drag now, or it would mask every later Value.
    void Drag(int i) => drag = i == Index(Levels, Value, Reach) ? null : i;

    async Task Pick(int i)
    {
        if (i < 0 || i >= Reach) return;
        drag = i;
        if (Levels[i] != Value) await ValueChanged.InvokeAsync(Levels[i]);
        drag = null;   // the parent has applied it (or reported the failure): show its Value again
    }
}
