@* Ordered levels on a native range (arrows, Home/End, touch and AT come for free), their names as clickable ticks under it.
   An optional last stop (ultracode in the Composer) can be shown but unreachable: the range then ends one column short,
   so neither drag nor keyboard can land on it. Equal columns keep each tick centred under its thumb position (app.css). *@
<span class="effort-slider" style="--n:@Stops.Count;--k:@Reach">
    <input type="range" id="@Id" min="0" max="@(Reach - 1)" step="1" value="@Shown" style="--p:@P" aria-label="@Label"
           aria-valuetext="@(Shown >= 0 ? Text(Shown) : null)" aria-describedby="@(Blocked ? Id + "-why" : null)"
           @oninput="e => drag = int.Parse((string)e.Value!)" @onchange="e => Pick(int.Parse((string)e.Value!))" />
    @* The range already carries name and value for AT and the keyboard: the ticks are a mouse shortcut. The unreachable
       stop is not `disabled`, which would swallow its title tooltip; Pick ignores it. *@
    @for (var i = 0; i < Stops.Count; i++)
    {
        var n = i;
        var off = n >= Reach;
        <button type="button" tabindex="-1" aria-hidden="true" class="@(n == Shown ? "on" : off ? "off" : null)"
                title="@(n == Levels.Count ? SpecialTitle : null)" @onclick="() => Pick(n)">
            @if (n == Levels.Count && SpecialIcon is { } ic) { <Icon Name="@ic" Sm /> }@Text(n)
        </button>
    }
    @if (Blocked) { <span class="vh" id="@(Id + "-why")">@SpecialTitle</span> }
</span>

@code {
    static int seq;
    [Parameter] public IReadOnlyList<string> Levels { get; set; } = [];
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public Func<string, string> Name { get; set; } = s => s;
    [Parameter] public string Id { get; set; } = "effort-" + Interlocked.Increment(ref seq);
    [Parameter] public string? Label { get; set; }
    // The trailing stop: its value is also its label (a product name, not translated).
    [Parameter] public string? Special { get; set; }
    [Parameter] public string? SpecialIcon { get; set; }
    [Parameter] public bool SpecialEnabled { get; set; } = true;
    [Parameter] public string? SpecialTitle { get; set; }   // the hint, or why it is unavailable

    int? drag;   // the thumb while dragging: the fill and the tick follow it before the change commits

    IReadOnlyList<string> Stops => Special is null ? Levels : [.. Levels, Special];
    bool Blocked => Special is not null && !SpecialEnabled;
    int Reach => Blocked ? Levels.Count : Stops.Count;
    int Shown => drag ?? Index(Stops, Value, Reach);
    string P => Reach > 1 ? (Math.Max(Shown, 0) / (double)(Reach - 1)).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture) : "0";
    string Text(int i) => i == Levels.Count ? Special! : Name(Levels[i]);

    // -1 for a value the range does not hold (unknown effort, or the unreachable stop): no tick lights up.
    internal static int Index(IReadOnlyList<string> stops, string value, int reach) => stops.Take(reach).ToList().IndexOf(value);

    async Task Pick(int i)
    {
        if (i < 0 || i >= Reach) return;
        drag = i;
        if (Stops[i] != Value) await ValueChanged.InvokeAsync(Stops[i]);
        drag = null;   // the parent has applied it (or reported the failure): show its Value again
    }
}
