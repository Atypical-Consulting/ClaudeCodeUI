@* Rendered once per text change; .cb wrapping and highlighting hooks come from Md.Render and app.js. *@

<div class="prose md">@html</div>

@code {
    [Parameter] public string Text { get; set; } = "";
    string? text;
    MarkupString html;

    protected override void OnParametersSet()
    {
        if (text == Text) return;
        text = Text;
        html = new MarkupString(Md.Render(Text));
    }
}
