<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/highlight/vs2015.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["ClaudeCodeUI.styles.css"]" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["lib/highlight/highlight.min.js"]"></script>
    <script>
        // Highlight code blocks as Blazor adds them; .hljs marks already-processed ones.
        new MutationObserver(() => document.querySelectorAll('pre code:not(.hljs)').forEach(el => hljs.highlightElement(el)))
            .observe(document.body, { childList: true, subtree: true });
    </script>
</body>

</html>
