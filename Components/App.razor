<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <script>(function () { var d = document.documentElement, t = localStorage.getItem('claude-ui.theme'); d.dataset.theme = ['graphite', 'encre', 'ristretto', 'mousse', 'contraste'].includes(t) ? t : 'graphite'; d.style.setProperty('--code-size', localStorage.getItem('claude-ui.code-size') || '13px'); })()</script>
    <link rel="icon" type="image/png" href="@Assets["favicon.png"]" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["ClaudeCodeUI.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["lib/highlight/highlight.min.js"]"></script>
    <script src="@Assets["app.js"]"></script>
</body>

</html>
