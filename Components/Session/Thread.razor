@* Top-level items only, grouped by ThreadBlocks: consecutive tools form a Ledger (the latest one open),
   consecutive Agent calls a Workflow, consecutive hooks one row, a Workflow call its own card. *@
@inject IJSRuntime JS
@inject SessionManager Sessions
@inject NavigationManager Nav
@inject UiState Ui
@implements IDisposable

@* role=log wraps the blocks only: finished blocks are announced as they are added; the token-by-token stream is hidden
   until it lands as a TextItem. StatusLine and CrashBanner are their own live regions, so they sit outside the log. *@
<div class="thread" @ref="el">
<div role="log" aria-live="polite" aria-relevant="additions">
    @{ var blocks = Blocks(); var last = blocks.OfType<ThreadBlocks.Run>().LastOrDefault(r => !r.Agents); DateTime? day = null; }
    @foreach (var b in blocks)
    {
        @* Times (Appearance): a divider when the day changes, but none above a thread that starts today. *@
        if (stamps && (b switch { UserItem u => u.At, TextItem t => t.At, _ => null }) is { } dated && dated.ToLocalTime().Date is var d && d != day)
        {
            if (day is not null || d != DateTime.Today)
            {
                <div class="day" role="separator">@d.ToString("D", System.Globalization.CultureInfo.CurrentCulture)</div>
            }
            day = d;
        }
        switch (b)
        {
            case UserItem u:
                <div class="you"><div class="w">@L["Thread.You", Fmt.Time(u.At)]@if (Session.CanRewind(u))
                    {
                        <button type="button" class="rw-btn" aria-haspopup="dialog" aria-label="@L["Rewind.ActionLabel", Fmt.Time(u.At)]" @onclick="() => rewind!.Open(u)"><Icon Name="undo" Sm />@L["Rewind.Action"]</button>
                    }</div>@if (u.Ultracode)
                    {
                        <span class="ultra-chip"><Icon Name="agents" Sm />ultracode</span>
                    }<span class="tx">@u.Text</span>@if (u.Images is { Count: > 0 } imgs)
                    {
                        <ul class="thumbs" aria-label="@L["Composer.Images"]">
                            @for (var i = 0; i < imgs.Count; i++)
                            {
                                <li>@if (imgs[i].Document)
                                    {
                                        <span class="miss" title="@imgs[i].Name"><Icon Name="paperclip" Sm />@(imgs[i].Name ?? L["Composer.Document", i + 1])</span>
                                    }
                                    else if (imgs[i].Url is { } url)
                                    {
                                        <img src="@url" alt="@L["Composer.ImageAlt", i + 1]" loading="lazy" />
                                    }
                                    else
                                    {
                                        <span class="miss"><Icon Name="paperclip" Sm />@L["Thread.ImageMissing", i + 1]</span>
                                    }</li>
                            }
                        </ul>
                    }</div>
                break;
            case TextItem { Uuid: { } at } t:
                @* Always rendered (disabled while a turn runs) so the thread does not shift at each turn's start and end. *@
                <div class="said" id="m-@at">
                    @if (stamps && t.At is { } ta)
                    {
                        <time class="stamp" datetime="@ta.ToString("o")">@Fmt.Time(ta)</time>
                    }
                    <Markdown Text="@t.Markdown" />
                    <span class="said-acts">
                        <button type="button" class="btn ghost fork-here" aria-pressed="@(marked.Contains(at) ? "true" : "false")" aria-label="@L["Bookmark.Of", Gist(t.Markdown)]"
                                @onclick="() => Mark(at, t.Markdown)">@L["Bookmark.Add"]</button>
                        <button type="button" class="btn ghost fork-here" data-copy="@t.Markdown" aria-label="@L["Thread.CopyOf", Gist(t.Markdown)]"><Icon Name="copy" Sm />@L["Md.Copy"]</button>
                        <button class="btn ghost fork-here" title="@L["Session.ForkHint"]" aria-label="@L["Session.ForkHereOf", Gist(t.Markdown)]"
                                disabled="@(!Session.CanFork)" @onclick="() => Fork(at)"><Icon Name="branch" Sm />@L["Session.ForkHere"]</button>
                    </span>
                </div>
                break;
            case TextItem t:
                @if (stamps && t.At is { } tb)
                {
                    <time class="stamp" datetime="@tb.ToString("o")">@Fmt.Time(tb)</time>
                }
                <Markdown Text="@t.Markdown" />
                break;
            case ThoughtItem th when thoughts:
                <details class="fold thought"><summary><Icon Name="right" Sm Class="chev" />@L["Thread.Thinking"]</summary><Markdown Text="@th.Text" /></details>
                break;
            case CompactItem c:
                @* The CLI's "Compacted chat": what was summarized away, and the summary the conversation goes on from. *@
                <details class="fold compact"><summary><Icon Name="right" Sm Class="chev" /><Icon Name="compress" Sm />@L["Thread.Compacted"]
                    <small>@string.Join(" · ", new[] { Strings.Name("Thread.Compact.", c.Trigger), c.PreTokens > 0 ? L["Thread.CompactTokens", Fmt.Tokens(c.PreTokens), Fmt.Tokens(c.PostTokens)].Value : null, c.DurationMs > 0 ? Fmt.Dur(TimeSpan.FromMilliseconds(c.DurationMs)) : null }.Where(x => !string.IsNullOrEmpty(x)))</small></summary>
                    @if (c.Summary is { } sum)
                    {
                        <Markdown Text="@sum" />
                    }
                    else
                    {
                        <p class="prose">@L["Thread.CompactNoSummary"]</p>
                    }
                </details>
                break;
            case FallbackItem f:
                <p class="notice warn">@f.Text@if (Session.Items.OfType<UserItem>().FirstOrDefault(x => x.Uuid == f.Retry) is { } ru && Session.CanRewind(ru))
                    {
                        @* The refused message back in the composer, conversation (and files) rewound to before it: the CLI's "Edit prompt and retry". *@
                        <button type="button" class="btn ghost" aria-haspopup="dialog" @onclick="() => rewind!.Open(ru)"><Icon Name="undo" Sm />@L["Thread.EditRetry"]</button>
                    }</p>
                break;
            case ApiErrorItem e:
                <ApiErrorCard Error="e.Error" Session="Session" />
                break;
            case ResumedItem:
                <p class="notice">@L["Thread.Resumed"]</p>
                break;
            case ScheduledItem sc:
                @* The terminal's "Running scheduled task (time)" line, with the prompt the task ran. *@
                <p class="notice"><Icon Name="refresh" Sm /> @L["Thread.Scheduled", Fmt.Time(sc.At)] <q>@sc.Prompt</q></p>
                break;
            case NoticeItem n:
                <p class="notice @(n.Notice.Color is "error" or "warning" ? "bad" : null)">@n.Notice.Text</p>
                break;
            case ThreadBlocks.Hooks h:
                <HookActivity Hooks="h.Items" />
                break;
            case ToolItem { Name: ToolKinds.SendFile } sf:
                <FileCard @key="sf.Id" Session="Session" Tool="sf" />
                break;
            case ToolItem w:
                <WorkflowCard @key="w.Id" Tool="w" />
                break;
            case ThreadBlocks.Run { Agents: true } r:
                <Workflow @key="r.Tools[0].Id" Session="Session" Agents="r.Tools" />
                break;
            case ThreadBlocks.Run r:
                <Ledger @key="r.Tools[0].Id" Session="Session" Tools="r.Tools" Expanded="r == last" />
                break;
        }
    }
    <StreamingTail Session="Session" />
</div>
    <CrashBanner Session="Session" />
</div>
@* Outside the scroller: busy/idle stays visible while reading earlier output. app.js shows .jump on new output when scrolled up. *@
<div class="dock">
    <button type="button" class="btn jump" hidden><Icon Name="down" Sm />@L["Thread.JumpLatest"]</button>
    <Ticker Active="Session.Status == SessionStatus.Running"><StatusLine Session="Session" /></Ticker>
</div>
<RewindDialog @ref="rewind" Session="Session" />

@code {
    [Parameter] public LiveSession Session { get; set; } = null!;
    ElementReference el;
    int prompts;
    RewindDialog? rewind;
    // Appearance toggles, read once per mount (two file probes, not one per block per render).
    readonly bool stamps = AppFlag.Timestamps.On, thoughts = AppFlag.Thinking.On;

    // Rebuilt only when Items is replaced: tool state changes in place and does not move blocks.
    System.Collections.Immutable.ImmutableList<Item>? blocksOf;
    List<object> blocks = [];
    (LiveSession, int)? scrolled;

    void Fork(string at) => Nav.NavigateTo($"session/{Sessions.Fork(Session, at).Id}");

    // Bookmarked replies of this session (Bookmarks.cs); the context panel lists them.
    HashSet<string> marked = [];
    protected override void OnInitialized()
    {
        marked = [.. Bookmarks.Of(Session.Id).Select(b => b.Uuid)];
        Ui.Rewind += AskedRewind;
    }

    void AskedRewind(UserItem u) => _ = InvokeAsync(() => rewind!.Open(u));

    public void Dispose() => Ui.Rewind -= AskedRewind;

    void Mark(string uuid, string md)
    {
        try { if (Bookmarks.Toggle(Session.Id, uuid, Gist(md))) marked.Add(uuid); else marked.Remove(uuid); }
        catch (Exception e) when (e is IOException or UnauthorizedAccessException) { Console.Error.WriteLine($"[{Session.Id}] bookmark: {e.Message}"); }
    }

    // The start of a reply, so each "Fork from here" button has a distinct accessible name.
    static string Gist(string md)
    {
        var s = string.Join(' ', System.Text.RegularExpressions.Regex.Replace(md, @"[*_`#>]", "").Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries));   // markdown marks are noise in a label
        return s.Length > 60 ? s[..60] + "…" : s;
    }

    List<object> Blocks()
    {
        var items = Session.Items;
        if (blocksOf == items) return blocks;
        blocksOf = items;
        // Hidden thoughts must not split a Ledger into runs with nothing visible between them.
        return blocks = ThreadBlocks.Of(thoughts ? items : items.Where(i => i is not ThoughtItem));
    }

    // Keep the thread pinned to the bottom while it grows, unless the user scrolled up (app.js claudeUi.scrollEnd).
    // StreamingTail pins it while text streams; here only after a change of the session, not after a selection.
    // A new prompt brings it back down: the user wants to see what they just sent and the reply.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (scrolled == (Session, Session.Version)) return;
        scrolled = (Session, Session.Version);
        var n = Session.Items.Count(i => i is UserItem);
        var force = n > prompts;
        prompts = n;
        try { await JS.InvokeVoidAsync("claudeUi.scrollEnd", el, force); }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
    }
}
