@inject SessionManager Sessions

@* Always-present live region: its text changes are announced. Ticking counters are aria-hidden so the
   reader is not interrupted every second. Without a visible .status it is taken out of the flow (app.css). *@
<div role="status" class="status-live">
@switch (Session.Status)
{
    case SessionStatus.Starting:
        <div class="status"><span class="spin"></span>@L["Status.StartingClaude"]</div>
        break;
    case SessionStatus.Running when TurnAgents() is { Count: > 0 } agents && agents.Any(a => a.State == ToolState.Running):
        <div class="status"><span class="spin"></span>@L["Status.AgentsWorking"] <small>@L["OfN", agents.Count(a => a.State == ToolState.Done), agents.Count]</small></div>
        break;
    case SessionStatus.Running when Session.Items.LastOrDefault() is ToolItem { State: ToolState.Running } tool:
        <div class="status"><span class="spin"></span>@L["Status.ToolRunning", tool.Name] <small aria-hidden="true">@Elapsed</small></div>
        break;
    case SessionStatus.Running:
        <div class="status"><span class="spin"></span>@L["Status.Writing"] <small aria-hidden="true">@Elapsed@(Session.ThinkingTokens > 0 ? " · " + L["Status.Thinking", Fmt.Tokens(Session.ThinkingTokens)] : "")</small></div>
        break;
    case SessionStatus.Waiting:
        <div class="status wait"><span class="dot wait"></span>@L["Status.Paused", What]</div>
        break;
    case SessionStatus.Exited when Sessions.RunningElsewhere(Session.Id):
        <div class="status wait"><span class="dot wait"></span>@L["Status.ElsewhereLine"]</div>
        break;
    case SessionStatus.Exited:
        <div class="status"><span class="dot exited"></span>@L["Status.HistoryLine", Session.Mode]</div>
        break;
    case SessionStatus.Idle when Session.LastResultSubtype == LiveSession.Interrupted:
        <div class="status"><Icon Name="stop" Sm />@L["Status.Interrupted"] <small>@(Session.LastTurn is { } t ? Fmt.Dur(t) : "")</small></div>
        break;
    case SessionStatus.Idle when Session.LastResultSubtype?.StartsWith("error") == true:
        <div class="status c-err-fg" title="@Session.LastResultSubtype">@L[Session.LastResultSubtype switch
        {
            "error_max_turns" => "Status.Err.MaxTurns",
            "error_max_budget_usd" => "Status.Err.Budget",
            "error_during_execution" => "Status.Err.Execution",
            _ => "Status.TurnError",
        }]</div>
        break;
    case SessionStatus.Idle when Session.LastTurn is not null:
        <span class="sr-only">@L["Status.TurnDone"]</span>
        break;
}
</div>

@code {
    [Parameter] public LiveSession Session { get; set; } = null!;

    string Elapsed => Session.TurnStartedAt is { } t ? Fmt.Dur(DateTimeOffset.Now - t) : "";

    string What => Session.Pending.FirstOrDefault()?.Tool switch
    {
        { } n when ToolKinds.IsEdit(n) => L["Status.WhatEdit"],
        { } n when ToolKinds.IsShell(n) => L["Status.WhatCommand"],
        _ => L["Status.WhatTool"],
    };

    // Agent calls of the current turn (after the last user message).
    List<ToolItem> TurnAgents()
    {
        var items = Session.Items;
        var from = items.FindLastIndex(i => i is UserItem) + 1;
        return items.Skip(from).OfType<ToolItem>().Where(t => t.ParentToolUseId is null && ToolKinds.IsAgent(t.Name)).ToList();
    }
}
