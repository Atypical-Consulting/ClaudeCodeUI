@inject UiState Ui
@inject SessionManager Sessions
@inject NavigationManager Nav

<div class="ph">
    <h1 class="ttl" tabindex="-1" title="@Session.Name">@Session.Name</h1>
    @* The short facts first so the ellipsis eats the path, whose full form is in the title and the Copy button. *@
    <span class="sub" title="@Session.Cwd">@string.Join(" · ", new[] { Session.Branch, Session.Repo, Strings.Name("Mode.Name.", Session.Mode), TranscriptStore.Short(Session.Cwd) }.Where(x => !string.IsNullOrEmpty(x)))</span>
    @if (Session.AddDirs.Count > 0)
    {
        <span class="sub dirs-n" title="@string.Join("\n", Session.AddDirs)">@Strings.Plural(Session.AddDirs.Count, "Dirs.Count")</span>
    }
    @if (Session.Cwd.Length > 0)
    {
        <button type="button" class="btn ghost" data-copy="@Session.Cwd" title="@L["Session.CopyCwd"]" aria-label="@L["Session.CopyCwd"]"><Icon Name="copy" Sm />@L["Md.Copy"]</button>
    }
    <span class="end">
        <button class="btn ghost" title="@L["Session.ForkHint"]" aria-label="@L["Session.Fork"]" disabled="@(!Session.CanFork)" @onclick="Fork"><Icon Name="branch" Sm />@L["Session.ForkShort"]</button>
        @if (Session.Status != SessionStatus.Exited)
        {
            <button class="btn ghost" title="@L["Session.StopHint"]" @onclick="Stop"><Icon Name="x" Sm />@L["Session.Stop"]</button>
        }
        <button class="btn ghost" title="@L["Inspector"] (@Strings.Kbd("Ctrl I"))" aria-label="@L["Inspector"]" aria-pressed="@(Ui.InspectorOpen ? "true" : "false")" @onclick="() => Ui.InspectorOpen = !Ui.InspectorOpen"><Icon Name="panel" Sm /></button></span>
</div>

@code {
    [Parameter] public LiveSession Session { get; set; } = null!;

    async Task Stop()
    {
        await Sessions.Stop(Session.Id);
        Nav.NavigateTo("overview");
    }

    void Fork() => Nav.NavigateTo($"session/{Sessions.Fork(Session).Id}");
}
