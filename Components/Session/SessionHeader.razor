@inject UiState Ui

<div class="ph">
    <h1 class="ttl" tabindex="-1">@Session.Name</h1>
    <span class="sub">@string.Join(" · ", new[] { Session.Branch, Session.Repo, Session.Mode }.Where(x => !string.IsNullOrEmpty(x)))</span>
    <span class="end"><button class="btn ghost" title="@L["Inspector"] (Ctrl I)" aria-label="@L["Inspector"]" aria-pressed="@(Ui.InspectorOpen ? "true" : "false")" @onclick="() => Ui.InspectorOpen = !Ui.InspectorOpen"><Icon Name="panel" Sm /></button></span>
</div>

@code {
    [Parameter] public LiveSession Session { get; set; } = null!;
}
