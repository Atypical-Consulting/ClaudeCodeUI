@* Consecutive Agent tool calls (subagents). Their own tools carry parent_tool_use_id = the Agent call id.
   No phases, workflow name or per-agent cost: the CLI does not provide them. *@
@inject UiState Ui

<Ticker Active="Agents.Any(a => a.EndedAt is null)">
<div class="wf">
    <div class="wh"><Icon Name="agents" /><b>@L["Workflow.Subagents"]</b><span class="tag">@L["Workflow.Tag"]</span><span class="r">@Head</span></div>
    @foreach (var a in Agents)
    {
        var isOpen = open.Contains(a.Id);
        <button type="button" @key="a.Id" class="agent @(Ui.SelectedToolId == a.Id ? "sel" : null)" aria-expanded="@(isOpen ? "true" : "false")" @onclick="() => Click(a)">
            <Icon Name="@(isOpen ? "down" : "right")" Sm Class="chev" />
            @if (a.State == ToolState.Done)
            {
                <span class="dot done"></span>
            }
            else
            {
                <span class="dot @(a.State switch { ToolState.Running => "run", ToolState.Waiting => "wait", _ => "err" })"></span>
            }
            <span class="nm">@(Events.Str(a.Input, "description") ?? L["Agent.Title"]) <small>@Events.Str(a.Input, "subagent_type")</small></span>
            <span class="m">@State(a)</span>
        </button>
        @if (isOpen && Children(a) is { Count: > 0 } kids)
        {
            <div @key="a.Id + '/'" class="subrun">
                @foreach (var t in kids)
                {
                    <div class="sl"><span style="color:@ToolKinds.Color(t.Name)">@t.Name</span><span class="p">@ToolKinds.Target(t.Name, t.Input, Session.Cwd)</span>@ToolRow.Meta(t)</div>
                }
            </div>
        }
    }
</div>
</Ticker>

@code {
    [Parameter] public LiveSession Session { get; set; } = null!;
    [Parameter] public IReadOnlyList<ToolItem> Agents { get; set; } = [];

    readonly HashSet<string> open = [];

    void Click(ToolItem a)
    {
        if (!open.Remove(a.Id)) open.Add(a.Id);
        Ui.SelectedToolId = a.Id;
    }

    List<ToolItem> Children(ToolItem a) =>
        Session.Children[a.Id].OfType<ToolItem>().Where(t => t.Name != "SubagentHandback").ToList();

    static TimeSpan Elapsed(ToolItem t) => (t.EndedAt ?? DateTimeOffset.Now) - t.StartedAt;

    string Head
    {
        get
        {
            var n = Strings.Plural(Agents.Count, "Agents");
            var d = Agents.Max(a => a.EndedAt ?? DateTimeOffset.Now) - Agents.Min(a => a.StartedAt);
            return $"{n} · {Fmt.Dur(d)}";
        }
    }

    static string State(ToolItem a)
    {
        var tokens = a.Tokens > 0 ? Strings.Get("Workflow.Tokens", Fmt.Tokens(a.Tokens)) + " · " : "";
        return tokens + a.State switch
        {
            ToolState.Running => Strings.Get("Status.Running") + " · " + Fmt.Dur(Elapsed(a)),
            ToolState.Done => Strings.Get("Tool.Done") + " · " + Fmt.Dur(Elapsed(a)),
            ToolState.Waiting => Strings.Get("Tool.Waiting"),
            ToolState.Denied => Strings.Get("Tool.Denied"),
            _ => Strings.Get("Tool.Error"),
        };
    }
}
