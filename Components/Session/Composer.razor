@* Prompt box with the per-turn settings: permission mode (set_permission_mode), model (set_model), effort / fast / ultracode (apply_flag_settings), "/" commands,
   "@" file mentions (the CLI reads the mentioned file itself), ↑ ↓ prompt history (this session, then past sessions of the same folder).
   Sent during a turn, a message waits as a chip until the CLI starts it (command_lifecycle), or is cancelled (cancel_async_message). *@
@inject IJSRuntime JS
@implements IDisposable

<section class="composer rich" aria-label="@L["Composer.Label"]" @onkeydown='e => { if (e.Key == "Escape") menuOpen = modeOpen = false; }'>
    @if (modeOpen)
    {
        <div class="shield" @onclick="CloseModeToTrigger"></div>
        <ModeMenu Session="Session" OnClose="CloseModeToTrigger" OnEscape="CloseModeToTrigger" />
    }
    else if (menuOpen)
    {
        <div class="shield" @onclick="CloseMenuToTrigger"></div>
        <ModelMenu Session="Session" OnClose="CloseMenuToTrigger" OnEscape="CloseMenuToTrigger" />
    }
    else if (SlashQuery is { } sq)
    {
        <SlashPopover @ref="slash" Session="Session" Query="@sq" OnPick="Pick" />
    }
    else if (MentionQuery is { } mq)
    {
        @* No @key needed: SessionPage keys its pane by session, so another session gets a new Composer and a new scan.
           OnReady is a no-op on purpose: invoking an EventCallback built here re-renders the Composer (aria-activedescendant). *@
        <MentionPopover @ref="mention" Session="Session" Query="@mq" OnPick="PickMention" OnReady="() => { }" />
    }
    <div aria-live="polite">
        @if (!Session.Queued.IsEmpty)
        {
            <ul class="queued" aria-label="@L["Composer.QueuedList"]">
                @foreach (var q in Session.Queued)
                {
                    <li @key="q.Uuid" class="qchip">
                        <span class="tag" title="@L["Composer.QueueHint"]">@L["Composer.Queued"]</span>
                        <span class="qt" title="@q.Text">@q.Text</span>
                        <button type="button" class="btn ghost" aria-label="@L["Composer.CancelQueued", q.Text]" title="@L["Composer.CancelQueued", q.Text]" @onclick="() => Cancel(q)"><Icon Name="x" Sm /></button>
                    </li>
                }
            </ul>
        }
    </div>
    <div class="box" @ref="box">
        @if (images.Count > 0)
        {
            <ul class="thumbs" aria-label="@L["Composer.Images"]">
                @for (var i = 0; i < images.Count; i++)
                {
                    var n = i;
                    <li>
                        <img src="@images[n].Url" alt="@L["Composer.ImageAlt", n + 1]" />
                        <button type="button" class="x" title="@L["Composer.RemoveImage", n + 1]" aria-label="@L["Composer.RemoveImage", n + 1]" @onclick="() => Remove(n)"><Icon Name="x" Sm /></button>
                    </li>
                }
            </ul>
        }
        <textarea @ref="area" @bind="text" @bind:event="oninput" @bind:after="history.Reset" @onkeydown="Key" placeholder="@Placeholder" disabled="@crashed"
                  aria-label="@L["Composer.Label"]" aria-keyshortcuts="ArrowUp ArrowDown" aria-describedby="composer-history"
                  aria-autocomplete="@(SlashOpen || MentionOpen ? "list" : null)" aria-controls="@(SlashOpen ? "slash-list" : MentionOpen ? "mention-list" : null)" aria-activedescendant="@(SlashOpen ? slash!.ActiveId : MentionOpen ? mention!.ActiveId : null)"></textarea>
        <div class="tools-row">
            <span class="tools">
            @if (crashed)
            {
                <span class="chip" title="@L["Composer.PermissionMode"]">@Strings.Name("Mode.Name.", Session.Mode)</span>
            }
            else
            {
                <button class="chip @(LiveSession.Risky(Session.Mode) ? "risk" : null)" @ref="modeBtn" title="@L["Composer.PermissionMode"]" aria-label="@L["Composer.PermissionMode"]: @Strings.Name("Mode.Name.", Session.Mode)"
                        aria-haspopup="listbox" aria-expanded="@(modeOpen ? "true" : "false")" @onclick="() => { modeOpen = !modeOpen; menuOpen = false; }">@Strings.Name("Mode.Name.", Session.Mode)<Icon Name="down" /></button>
            }
            @* Paste and drop (app.js claudeUi.images) hand files to this InputFile, which streams them in chunks: images never
               ride in one hub message, so they do not depend on MaximumReceiveMessageSize (Program.cs). *@
            <button type="button" class="pick" @ref="attachBtn" disabled="@crashed" title="@L["Composer.Attach"]" aria-label="@L["Composer.Attach"]"><Icon Name="paperclip" /></button>
            <InputFile @ref="picker" OnChange="AddImages" multiple accept="image/png,image/jpeg,image/gif,image/webp" hidden tabindex="-1" />
            @if (models.Count > 0 && !crashed)
            {
                <button class="pick model" @ref="pickBtn" title="@L["Model"]" aria-label="@($"{L["Model"]}: {ModelLabel}")" aria-haspopup="listbox" aria-expanded="@(menuOpen ? "true" : "false")" @onclick="() => { menuOpen = !menuOpen; modeOpen = false; }">
                    <Icon Name="cpu" />@ModelLabel @if (Session.ContextWindow is { } w) {<small>@Fmt.Tokens(w)</small>}<Icon Name="down" />
                </button>
            }
            else
            {
                <span class="pick dis" aria-disabled="true"><Icon Name="cpu" />@(Session.Model ?? L["Model"])</span>
            }
            @if (model is { } m && Events.Prop(m, "supportsEffort") is { ValueKind: JsonValueKind.True } && Events.Prop(m, "supportedEffortLevels") is { ValueKind: JsonValueKind.Array } levels && !crashed)
            {
                <span class="effort" title="@L["Composer.Effort"]" role="group" aria-label="@L["Composer.Effort"]">
                    @foreach (var l in levels.EnumerateArray().Select(x => x.GetString() ?? ""))
                    {
                        <button class="@(l == Effort ? "on" : null)" aria-pressed="@((l == Effort) ? "true" : "false")" @onclick="() => SetEffort(l)">@Strings.Name("Effort.", l)</button>
                    }
                </span>
            }
            @if (FastOk)
            {
                <button class="pick @(Session.FastModeState == "on" ? "on" : null)" aria-pressed="@((Session.FastModeState == "on") ? "true" : "false")" title="@L["Composer.FastMode"]" @onclick="ToggleFast"><Icon Name="zap" />@L["Composer.Fast"]</button>
            }
            else
            {
                <button type="button" class="pick dis" aria-disabled="true" title="@(FastReason is { } r ? L["Composer.FastUnavailableWhy", r] : L["Composer.FastUnavailable"])"><Icon Name="zap" />@L["Composer.Fast"]</button>
            }
            @if (ultraAvailable == false || crashed)
            {
                <button type="button" class="pick dis" aria-disabled="true" title="@L["Composer.UltraUnavailable"]"><Icon Name="agents" />Ultracode</button>
            }
            else
            {
                <button class="pick @(Session.Ultracode ? "on" : null)" aria-pressed="@(Session.Ultracode ? "true" : "false")" title="@L["Composer.UltraHint"]" @onclick="() => Run(() => Session.SetUltracode(!Session.Ultracode))"><Icon Name="agents" />Ultracode</button>
            }
            </span>
            <span class="sends">
                @if (Session.Status == SessionStatus.Running)
                {
                    @if (ultraTurn) { <span class="tag acc">ultracode</span> }
                    @if (!string.IsNullOrWhiteSpace(text))
                    {
                        <button class="btn go primary" title="@L["Composer.QueueHint"]" @onclick="Send">@L["Composer.Queue"] <kbd>@Strings.Kbd("Ctrl ⏎")</kbd></button>
                    }
                    <button class="btn go" @onclick="() => Run(Session.Interrupt)"><Icon Name="stop" Sm />@(ultraTurn ? L["Composer.StopWorkflow"] : L["Composer.Interrupt"]) <kbd>@L["Key.Esc"]</kbd></button>
                }
                else if (crashed)
                {
                    <button class="btn go" disabled>@L["Composer.Send"]</button>
                }
                else if (Session.Pending.Count is var n and > 0)
                {
                    @* Sending answers the pending requests with a denial first: say so on the button itself. *@
                    <button class="btn go danger" title="@L["Composer.DenyAndSendHint"]" disabled="@(string.IsNullOrWhiteSpace(text) && images.Count == 0)" @onclick="Send">@L["Composer.DenyAndSend", n] <kbd>@Strings.Kbd("Ctrl ⏎")</kbd></button>
                }
                else
                {
                    <button class="btn go @(string.IsNullOrWhiteSpace(text) && images.Count == 0 ? null : "primary")" disabled="@(string.IsNullOrWhiteSpace(text) && images.Count == 0)" @onclick="Send">@L["Composer.Send"] <kbd>@Strings.Kbd("Ctrl ⏎")</kbd></button>
                }
            </span>
        </div>
    </div>
    <div class="meta">
        <Ticker Active="Session.TurnStartedAt is not null">@if (Turn is { } d) { <span>@L["Composer.Turn"] <b>@Fmt.Dur(d)</b></span> }</Ticker>
        <span>@L["Composer.Session"] <b>@Fmt.Cost(Session.CostUsd, 4)</b></span>
        <span>@L["Kv.Tools"] <b>@Session.ToolCount</b></span>
        <span id="composer-history" role="status">@(history.Index >= 0 ? L["Composer.History", history.Index + 1, history.Count] : "")</span>
        @if (Session.ContextTokens > 0) { <span>@L["Composer.Context"] <b>@Fmt.Tokens(Session.ContextTokens)</b>@(Session.ContextWindow is { } cw ? " / " + Fmt.Tokens(cw) : "")</span> }
        @* One live region, so an error is announced. *@
        <span class="r @(error is not null ? "c-err-fg" : null)" role="status">
            @if (error is not null)
            {
                @error
            }
            else if (Session.Ultracode && Session.Status != SessionStatus.Running)
            {
                <span class="tag acc">ultracode</span> @L["Composer.UltraThisTurn"]
            }
            else
            {
                @* StatusLine announces the turn outcome: shown here, not announced twice. *@
                <span aria-hidden="true">@(Session.Status == SessionStatus.Running || Session.LastResultSubtype is null or "success" ? "" : Session.LastResultSubtype == LiveSession.Interrupted ? L["Composer.Interrupted"] : L["Composer.TurnError"])</span>
            }
        </span>
    </div>
</section>

@code {
    [Parameter] public LiveSession Session { get; set; } = null!;

    ElementReference area, box, attachBtn;
    InputFile? picker;
    readonly PromptHistory history = new();
    DotNetObjectReference<Composer>? self;
    IReadOnlyList<string>? past;   // prompts of past sessions in this cwd (the Composer is keyed by session)
    SlashPopover? slash;
    MentionPopover? mention;
    bool SlashOpen => !menuOpen && !modeOpen && SlashQuery is not null && slash?.Open == true;
    // The draft lives on the session: it survives navigation, reloads and reconnects.
    string text { get => Session.Draft; set => Session.Draft = value; }
    IReadOnlyList<UserImage> images { get => Session.DraftImages; set => Session.DraftImages = value; }
    bool menuOpen, modeOpen, slashDismissed, mentionDismissed, settingsAsked, reading;
    string? recalled;  // the prompt Recall put in the box, kept to tell an untouched recall from an edit
    bool? ultraAvailable;
    string? appliedEffort, error;
    List<JsonElement> models = [];
    JsonElement? model;

    bool crashed => Session.Status == SessionStatus.Crashed;
    bool ultraTurn => Session.Status == SessionStatus.Running && Session.Items.LastOrDefault(i => i is UserItem) is UserItem { Ultracode: true };
    string? Effort => appliedEffort ?? Session.Effort;
    string ModelLabel => model is { } m ? Events.Str(m, "displayName") ?? Session.Model ?? "" : Session.Model ?? L["Model"];
    TimeSpan? Turn => Session.TurnStartedAt is { } t ? DateTimeOffset.Now - t : Session.LastTurn;

    // While a name is being typed after "/" (no space yet).
    // A recalled "/command" (history.Index >= 0) must not open the popover that would take the arrows.
    string? SlashQuery => !slashDismissed && history.Index < 0 && text.StartsWith('/') && !text.Any(char.IsWhiteSpace) ? text : null;

    // While a path is being typed after an "@" that starts the last word (FileIndex.Query).
    // Not over an untouched recalled prompt: Send trims, so "fix @src/Foo.cs " comes back as a live query,
    // and an open picker would take ArrowUp/ArrowDown from the recall chain. The first edit opens it.
    string? MentionQuery => !mentionDismissed && !menuOpen && !modeOpen && SlashQuery is null && text != recalled ? FileIndex.Query(text) : null;
    bool MentionOpen => MentionQuery is not null && mention is { Open: true };

    bool FastOk => Session.FastModeState == "on" && model is { } m && Events.Prop(m, "supportsFastMode") is { ValueKind: JsonValueKind.True };
    string? FastReason => Session.FastModeReason switch
    {
        null => null,
        "sdk_opt_in_required" => L["Composer.FastSdkOptIn"],
        "extra_usage_disabled" => L["Composer.FastExtraUsage"],
        var r => r,
    };

    string Placeholder => Session.Status switch
    {
        SessionStatus.Crashed => L["Composer.PhCrashed"],
        SessionStatus.Waiting => L["Composer.PhWaiting"],
        SessionStatus.Exited => L["Composer.PhHistory"],
        SessionStatus.Running when ultraTurn => L["Composer.PhWorkflow"],
        SessionStatus.Running => L["Composer.PhRunning"],
        _ => L["Composer.PhIdle"],
    };

    protected override void OnParametersSet()
    {
        models = [.. ModelMenu.Models(Session)];
        model = ModelMenu.Current(Session);
        // ultracodeAvailable and the applied effort live in get_settings: read once the process answered initialize.
        if (!settingsAsked && Session.HasProcess && Session.InitializeInfo is not null)
        {
            settingsAsked = true;
            _ = ReadSettings();
        }
    }

    async Task ReadSettings()
    {
        try
        {
            if (Events.Prop(await Session.Request("get_settings"), "applied") is { } a)
            {
                ultraAvailable = Events.Prop(a, "ultracodeAvailable") is { ValueKind: JsonValueKind.True or JsonValueKind.False } u ? u.GetBoolean() : null;
                appliedEffort = Events.Str(a, "effort");
            }
        }
        catch (Exception ex) { Console.Error.WriteLine($"[{Session.Id}] get_settings : {ex.Message}"); }
        await InvokeAsync(StateHasChanged);
    }

    async Task SetEffort(string level)
    {
        await Run(() => Session.SetEffort(level));
        await ReadSettings();
    }

    Task ToggleFast() => Run(() => Session.SetFast(Session.FastModeState != "on"));

    async Task Run(Func<Task> action)
    {
        error = null;
        try { await action(); }
        catch (Exception ex) { error = L["Composer.ActionFailed", ex.Message]; }
    }

    ElementReference pickBtn, modeBtn;

    async Task CloseModeToTrigger()
    {
        modeOpen = false;
        StateHasChanged();
        await JS.InvokeVoidAsync("claudeUi.focus", modeBtn);
    }

    async Task CloseMenuToTrigger()
    {
        menuOpen = false;
        StateHasChanged();
        await JS.InvokeVoidAsync("claudeUi.focus", pickBtn);
    }

    async Task Send()
    {
        var t = text.Trim();
        if (t.Length == 0 && images.Count == 0 || reading || crashed) return;
        var imgs = images;
        text = "";
        images = [];
        recalled = null;
        history.Reset();
        menuOpen = modeOpen = false;
        // "Ou explique à Claude ce que tu veux à la place…": the pending tools are refused, then the message follows.
        await Run(async () =>
        {
            foreach (var p in Session.Pending) await Session.Answer(p, Decision.Deny);
            await Session.Send(t, imgs);
        });
        if (error is not null)   // never lose the prompt to a failed send
        {
            if (text.Length == 0) text = t;
            if (images.Count == 0) images = imgs;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        self = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("claudeUi.images", box, picker?.Element, attachBtn);
        await JS.InvokeVoidAsync("claudeUi.history", area, self);
    }

    // Picked, pasted or dropped files. The type comes from the bytes (Images.Sniff); each one is read whole, up to MaxBytes.
    async Task AddImages(InputFileChangeEventArgs e)
    {
        error = null;
        reading = true;
        try
        {
            foreach (var f in e.GetMultipleFiles(int.MaxValue))
            {
                if (images.Count >= Images.MaxCount) { error = L["Composer.ImageTooMany", Images.MaxCount]; break; }
                if (f.Size > Images.MaxBytes) { error = L["Composer.ImageTooBig", f.Name, Fmt.Size(f.Size), Fmt.Size(Images.MaxBytes)]; continue; }
                var bytes = new MemoryStream((int)f.Size);
                try
                {
                    await using var s = f.OpenReadStream(Images.MaxBytes);
                    await s.CopyToAsync(bytes);
                }
                catch (Exception ex) when (ex is IOException or JSException or TaskCanceledException) { error = L["Composer.ActionFailed", ex.Message]; continue; }
                if (Images.From(bytes.ToArray()) is { } img) images = [.. images, img];
                else error = L["Composer.ImageType", f.Name];
            }
        }
        finally { reading = false; }
    }

    async Task Remove(int i)
    {
        images = [.. images.Where((_, j) => j != i)];
        await JS.InvokeVoidAsync("claudeUi.focus", area);   // the removed button took the focus with it
    }

    // The chip leaves on the CLI's command_lifecycle frame; the focus goes back to the prompt.
    async Task Cancel(QueuedMessage q)
    {
        await Run(() => Session.Cancel(q));
        await JS.InvokeVoidAsync("claudeUi.focus", area);
    }

    async Task Pick(string name)
    {
        text = $"/{name} ";
        await JS.InvokeVoidAsync("claudeUi.focus", area);
    }

    async Task PickMention(string path)
    {
        text = FileIndex.Insert(text, path);
        await JS.InvokeVoidAsync("claudeUi.focus", area);
    }

    // ↑ (step 1) / ↓ (step -1) from app.js, caret on the first / last line and no popover open.
    [JSInvokable]
    public void Recall(int step, string current)
    {
        if (history.Index == -1 && step > 0)
        {
            // ponytail: past prompts read once per session (≤ 10 transcripts, synchronous); re-read if they go stale.
            past ??= TranscriptStore.Prompts(Session.Cwd, Session.Id);
            // image-only messages have no text to recall
            history.Load(Session.Items.OfType<UserItem>().Select(u => u.Text).Where(t => t.Length > 0).Reverse().Concat(past));
        }
        if (history.Move(step, current) is not { } t) return;
        text = recalled = t;
        StateHasChanged();
    }

    public void Dispose()
    {
        // Leaving mid-walk (navigation, reload, reconnect): Session.Draft holds the recalled prompt; give the typed draft back.
        if (history.Draft is { } d) text = d;
        self?.Dispose();
    }

    async Task Key(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && (e.CtrlKey || e.MetaKey)) { await Send(); return; }
        if (e.Key == "Escape") { slashDismissed = SlashQuery is not null; mentionDismissed = MentionQuery is not null; return; }   // the menu closes on .composer
        if (!text.StartsWith('/')) slashDismissed = false;
        if (FileIndex.Query(text) is null) mentionDismissed = false;
        if (MentionOpen)
        {
            switch (e.Key)
            {
                case "ArrowDown" or "ArrowUp": mention!.Key(e.Key); break;
                case "Tab" when !e.ShiftKey: await mention!.Pick(); break;   // the browser moved the focus; PickMention puts it back
            }
            return;
        }
        if (slash is not { Open: true } || SlashQuery is null) return;
        switch (e.Key)
        {
            case "ArrowDown": slash.Move(1); break;
            case "ArrowUp": slash.Move(-1); break;
            case "Tab": await slash.Pick(); break;   // the browser moved the focus; Pick puts it back
        }
    }
}
