@* Prompt box with the per-turn settings: model (set_model), effort / fast / ultracode (apply_flag_settings), "/" commands. *@
@inject IJSRuntime JS

<div class="composer rich" @onkeydown='e => { if (e.Key == "Escape") menuOpen = false; }'>
    @if (menuOpen)
    {
        <div class="shield" @onclick="() => menuOpen = false"></div>
        <ModelMenu Session="Session" OnClose="() => menuOpen = false" OnEscape="CloseMenuToTrigger" />
    }
    else if (SlashQuery is { } sq)
    {
        <SlashPopover @ref="slash" Session="Session" Query="@sq" OnPick="Pick" />
    }
    <div class="box">
        <textarea @ref="area" @bind="text" @bind:event="oninput" @onkeydown="Key" placeholder="@Placeholder" disabled="@crashed" aria-label="@L["Composer.Label"]"></textarea>
        <div class="tools-row">
            <span class="chip" title="@L["Composer.PermissionMode"]">@Session.Mode</span>
            @if (models.Count > 0 && !crashed)
            {
                <button class="pick" @ref="pickBtn" aria-haspopup="listbox" aria-expanded="@(menuOpen ? "true" : "false")" @onclick="() => menuOpen = !menuOpen">
                    <Icon Name="cpu" />@ModelLabel @if (Session.ContextWindow is { } w) {<small>@Fmt.Tokens(w)</small>}<Icon Name="down" />
                </button>
            }
            else
            {
                <span class="pick dis" aria-disabled="true"><Icon Name="cpu" />@(Session.Model ?? L["Model"])</span>
            }
            @if (model is { } m && Events.Prop(m, "supportsEffort") is { ValueKind: JsonValueKind.True } && Events.Prop(m, "supportedEffortLevels") is { ValueKind: JsonValueKind.Array } levels && !crashed)
            {
                <span class="effort" title="Effort" role="group" aria-label="Effort">
                    @foreach (var l in levels.EnumerateArray().Select(x => x.GetString() ?? ""))
                    {
                        <button class="@(l == Effort ? "on" : null)" aria-pressed="@((l == Effort) ? "true" : "false")" @onclick="() => SetEffort(l)">@l</button>
                    }
                </span>
            }
            @if (FastOk)
            {
                <button class="pick @(Session.FastModeState == "on" ? "on" : null)" aria-pressed="@((Session.FastModeState == "on") ? "true" : "false")" title="@L["Composer.FastMode"]" @onclick="ToggleFast"><Icon Name="zap" />@L["Composer.Fast"]</button>
            }
            else
            {
                <span class="pick dis" aria-disabled="true" title="@(FastReason is { } r ? L["Composer.FastUnavailableWhy", r] : L["Composer.FastUnavailable"])"><Icon Name="zap" />@L["Composer.Fast"]</span>
            }
            @if (ultraAvailable == false || crashed)
            {
                <span class="pick dis" aria-disabled="true" title="@L["Composer.UltraUnavailable"]"><Icon Name="agents" />Ultracode</span>
            }
            else
            {
                <button class="pick @(Session.Ultracode ? "on" : null)" aria-pressed="@(Session.Ultracode ? "true" : "false")" title="@L["Composer.UltraHint"]" @onclick="() => Run(() => Session.SetUltracode(!Session.Ultracode))"><Icon Name="agents" />Ultracode</button>
            }
            <span style="margin-left:auto;display:inline-flex;gap:8px;align-items:center">
                @if (Session.Status == SessionStatus.Running)
                {
                    @if (ultraTurn) { <span class="tag acc">ultracode</span> }
                    <button class="btn go" @onclick="() => Run(Session.Interrupt)"><Icon Name="stop" Sm />@(ultraTurn ? L["Composer.StopWorkflow"] : L["Composer.Interrupt"]) <kbd>@L["Key.Esc"]</kbd></button>
                }
                else if (crashed)
                {
                    <button class="btn go" disabled>@L["Composer.Send"]</button>
                }
                else
                {
                    <button class="btn go @(string.IsNullOrWhiteSpace(text) ? null : "primary")" @onclick="Send">@L["Composer.Send"] <kbd>Ctrl ⏎</kbd></button>
                }
            </span>
        </div>
    </div>
    <div class="meta">
        @if (Turn is { } d) { <span>@L["Composer.Turn"] <b>@Fmt.Dur(d)</b></span> }
        <span>session <b>@Fmt.Cost(Session.CostUsd, 4)</b></span>
        <span>@L["Kv.Tools"] <b>@Session.ToolCount</b></span>
        @if (Session.ContextTokens > 0) { <span>@L["Composer.Context"] <b>@Fmt.Tokens(Session.ContextTokens)</b>@(Session.ContextWindow is { } cw ? " / " + Fmt.Tokens(cw) : "")</span> }
        @if (error is not null)
        {
            <span class="r" role="alert" style="color:var(--err-fg)">@error</span>
        }
        else if (Session.Ultracode && Session.Status != SessionStatus.Running)
        {
            <span class="r"><span class="tag acc">ultracode</span> @L["Composer.UltraThisTurn"]</span>
        }
        else
        {
            <span class="r">@(Session.Status == SessionStatus.Running || Session.LastResultSubtype is null or "success" ? "claude · stream-json" : Session.LastResultSubtype == "interrompu" ? L["Composer.Interrupted"] : Session.LastResultSubtype)</span>
        }
    </div>
</div>

@code {
    [Parameter] public LiveSession Session { get; set; } = null!;

    ElementReference area;
    SlashPopover? slash;
    string text = "";
    bool menuOpen, slashDismissed, settingsAsked;
    bool? ultraAvailable;
    string? appliedEffort, error;
    List<JsonElement> models = [];
    JsonElement? model;

    bool crashed => Session.Status == SessionStatus.Crashed;
    bool ultraTurn => Session.Status == SessionStatus.Running && Session.Items.LastOrDefault(i => i is UserItem) is UserItem { Ultracode: true };
    string? Effort => appliedEffort ?? Session.Effort;
    string ModelLabel => model is { } m ? Events.Str(m, "displayName") ?? Session.Model ?? "" : Session.Model ?? L["Model"];
    TimeSpan? Turn => Session.TurnStartedAt is { } t ? DateTimeOffset.Now - t : Session.LastTurn;

    // While a name is being typed after "/" (no space yet).
    string? SlashQuery => !slashDismissed && text.StartsWith('/') && !text.Any(char.IsWhiteSpace) ? text : null;

    bool FastOk => Session.FastModeState == "on" && model is { } m && Events.Prop(m, "supportsFastMode") is { ValueKind: JsonValueKind.True };
    string? FastReason => Session.FastModeReason switch
    {
        null => null,
        "sdk_opt_in_required" => L["Composer.FastSdkOptIn"],
        "extra_usage_disabled" => L["Composer.FastExtraUsage"],
        var r => r,
    };

    string Placeholder => Session.Status switch
    {
        SessionStatus.Crashed => L["Composer.PhCrashed"],
        SessionStatus.Waiting => L["Composer.PhWaiting"],
        SessionStatus.Running when ultraTurn => L["Composer.PhWorkflow"],
        SessionStatus.Running => L["Composer.PhRunning"],
        _ => L["Composer.PhIdle"],
    };

    protected override void OnParametersSet()
    {
        models = [.. ModelMenu.Models(Session)];
        model = ModelMenu.Current(Session);
        // ultracodeAvailable and the applied effort live in get_settings: read once the process answered initialize.
        if (!settingsAsked && Session.HasProcess && Session.InitializeInfo is not null)
        {
            settingsAsked = true;
            _ = ReadSettings();
        }
    }

    async Task ReadSettings()
    {
        try
        {
            if (Events.Prop(await Session.Request("get_settings"), "applied") is { } a)
            {
                ultraAvailable = Events.Prop(a, "ultracodeAvailable") is { ValueKind: JsonValueKind.True or JsonValueKind.False } u ? u.GetBoolean() : null;
                appliedEffort = Events.Str(a, "effort");
            }
        }
        catch (Exception ex) { Console.Error.WriteLine($"[{Session.Id}] get_settings : {ex.Message}"); }
        await InvokeAsync(StateHasChanged);
    }

    async Task SetEffort(string level)
    {
        await Run(() => Session.SetEffort(level));
        await ReadSettings();
    }

    Task ToggleFast() => Run(() => Session.SetFast(Session.FastModeState != "on"));

    async Task Run(Func<Task> action)
    {
        error = null;
        try { await action(); }
        catch (Exception ex) { error = ex.Message; }
    }

    ElementReference pickBtn;

    async Task CloseMenuToTrigger()
    {
        menuOpen = false;
        StateHasChanged();
        await JS.InvokeVoidAsync("claudeUi.focus", pickBtn);
    }

    async Task Send()
    {
        var t = text.Trim();
        if (t.Length == 0 || Session.Status is SessionStatus.Running or SessionStatus.Crashed) return;
        text = "";
        menuOpen = false;
        // "Ou explique à Claude ce que tu veux à la place…": the pending tools are refused, then the message follows.
        await Run(async () =>
        {
            foreach (var p in Session.Pending) await Session.Answer(p, Decision.Deny);
            await Session.Send(t);
        });
    }

    async Task Pick(string name)
    {
        text = $"/{name} ";
        await JS.InvokeVoidAsync("claudeUi.focus", area);
    }

    async Task Key(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && (e.CtrlKey || e.MetaKey)) { await Send(); return; }
        if (e.Key == "Escape") { slashDismissed = SlashQuery is not null; return; }   // the menu closes on .composer
        if (!text.StartsWith('/')) slashDismissed = false;
        if (slash is not { Open: true } || SlashQuery is null) return;
        switch (e.Key)
        {
            case "ArrowDown": slash.Move(1); break;
            case "ArrowUp": slash.Move(-1); break;
            case "Tab": await slash.Pick(); break;   // the browser moved the focus; Pick puts it back
        }
    }
}
