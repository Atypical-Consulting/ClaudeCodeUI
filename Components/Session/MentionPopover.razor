@* "@" mentions: the session's subagents ("@agent-<name>", which the CLI runs as that agent: verified on claude 2.1.296),
   then files and folders of the session cwd (FileIndex), filtered by Query. Same shell as SlashPopover;
   the Composer relays ↑ ↓ Tab via Key / Pick. The cwd is scanned once per opening, off the circuit's thread. *@
@implements IDisposable

@if (index is null || matches.Count > 0 || Query.Length > 0)
{
    <div class="pop slash">
        <div class="sh">
            <span>@L["Mention.Title"]</span>
            <span>@(index is null ? L["Mention.Scanning"] : index.Truncated ? L["Mention.Truncated", index.Paths.Length] : "") <kbd>↑</kbd> <kbd>↓</kbd> <kbd>Tab</kbd></span>
        </div>
        <div id="mention-list" role="listbox" aria-label="@L["Mention.Title"]" aria-busy="@(index is null ? "true" : "false")">
        @for (var i = 0; i < matches.Count; i++)
        {
            var (p, n) = (matches[i], i);
            var agent = agents.GetValueOrDefault(p);
            var name = FileIndex.Name(p);
            var hit = Query.Length > 0 ? name.IndexOf(Query, StringComparison.OrdinalIgnoreCase) : -1;
            <div id="mention-opt-@n" class="si @(n == sel ? "on" : null)" role="option" aria-selected="@((n == sel) ? "true" : "false")" @onmousedown:preventDefault @onclick="() => OnPick.InvokeAsync(p)">
                <b title="@p">@if (hit >= 0) {@name[..hit]<mark>@name.Substring(hit, Query.Length)</mark>@name[(hit + Query.Length)..]} else {@name}</b>
                @if (agent is not null)
                {
                    <span title="@agent">@agent</span>
                }
                else
                {
                    <span title="@p">@p[..^name.Length]</span>
                }
                <span></span>
            </div>
        }
        @if (index is not null && matches.Count == 0)
        {
            <div class="si" aria-hidden="true"><span>@L["Mention.NoMatch"]</span></div>
        }
        </div>
    </div>
}

@code {
    [Parameter] public LiveSession Session { get; set; } = null!;
    [Parameter] public string Query { get; set; } = "";
    [Parameter] public EventCallback<string> OnPick { get; set; }
    [Parameter] public EventCallback OnReady { get; set; }   // the scan finished: the Composer re-renders its aria-activedescendant

    readonly CancellationTokenSource cts = new();
    Dictionary<string, string> agents = [];   // "agent-<name>" → its description
    FileIndex.Index? index;
    List<string> matches = [];
    string? q;
    int sel;

    public bool Open => matches.Count > 0;
    public string? ActiveId => Open ? $"mention-opt-{sel}" : null;
    public void Key(string key) { sel = ListNav.Next(key, sel, matches.Count); StateHasChanged(); }
    public Task Pick() => Open ? OnPick.InvokeAsync(matches[sel]) : Task.CompletedTask;

    protected override async Task OnInitializedAsync()
    {
        agents = Agents(Session);
        Refilter();
        try { index = await FileIndex.Scan(Session.Cwd, cts.Token); }
        catch (OperationCanceledException) { return; }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[{Session.Id}] file index: {ex.Message}");
            index = new([], false);
        }
        Refilter();
        await OnReady.InvokeAsync();
    }

    // Only on a new Query: the parent re-renders every ~50 ms while a turn streams, and a filter over 20k paths costs ms.
    protected override void OnParametersSet()
    {
        if (Query == q) return;
        q = Query;
        sel = 0;
        Refilter();
    }

    // A query ranks agents with the files: a long agent name loosely matches many queries and must not take Tab from a real hit.
    void Refilter()
    {
        var paths = index?.Paths ?? [];
        var found = Query.Length == 0 ? FileIndex.Filter(agents.Keys, "", 3) : [];
        matches = [.. found, .. FileIndex.Filter(Query.Length == 0 ? paths : agents.Keys.Concat(paths), Query, FileIndex.MaxResults - found.Count)];
        if (sel >= matches.Count) sel = 0;
    }

    // initialize's agents carry a description; init's are names only (a session resumed before its first answer has neither).
    // The CLI only reads @agent-[\w:.@-]+ (bundle a_n): a name with a space ("stripe:Company Researcher") cannot be mentioned.
    static Dictionary<string, string> Agents(LiveSession s) =>
        (s.InitializeInfo is { } info && Events.Prop(info, "agents") is { ValueKind: System.Text.Json.JsonValueKind.Array } a
            ? a.EnumerateArray().Where(x => Events.Str(x, "name") is not null).DistinctBy(x => Events.Str(x, "name")).ToDictionary(x => "agent-" + Events.Str(x, "name"), x => Events.Str(x, "description") ?? "")
            : (s.Init?.Agents ?? []).Distinct().ToDictionary(n => "agent-" + n, _ => ""))
        .Where(kv => System.Text.RegularExpressions.Regex.IsMatch(kv.Key, @"^agent-[\w:.@-]+$")).ToDictionary();

    public void Dispose()
    {
        matches = [];   // the Composer's @ref outlives this instance until the next popover renders: no stale ActiveId
        cts.Cancel();
        cts.Dispose();
    }
}
