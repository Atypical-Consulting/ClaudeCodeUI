@* A running Bash command or subagent: move it to the background (Ctrl B in the terminal), or stop a subagent.
   A background shell is stopped from TasksPanel. *@

@if (Tool.State == ToolState.Running && (Shell || Agent))
{
    @if (!Tool.Background)
    {
        <button type="button" class="btn ghost" disabled="@busy" title="@L["Task.BackgroundHint"]" @onclick="() => Do(() => Session.Background(Tool))"><Icon Name="down" Sm />@L["Task.Background"]</button>
    }
    @if (Agent && Tool.TaskId is { } id)
    {
        <button type="button" class="btn ghost" disabled="@busy" @onclick="() => Do(() => Session.StopTask(id))"><Icon Name="stop" Sm />@L["Bg.Stop"]</button>
    }
    @if (error is not null) { <span class="c-err-fg" role="alert">@error</span> }
}

@code {
    [Parameter] public LiveSession Session { get; set; } = null!;
    [Parameter] public ToolItem Tool { get; set; } = null!;
    bool busy;
    string? error;

    bool Shell => ToolKinds.IsShell(Tool.Name);
    bool Agent => ToolKinds.IsAgent(Tool.Name);

    async Task Do(Func<Task> action)
    {
        busy = true;
        error = null;
        try { await action(); }
        catch (Exception ex) { error = L["Composer.ActionFailed", ex.Message]; }
        finally { busy = false; }
    }
}
