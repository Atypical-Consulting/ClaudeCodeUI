@* The text being streamed. Renders on its own (the page skips text-only notifies), one text node per paragraph:
   a render only resends the paragraph being written. *@
@implements IDisposable
@inject IJSRuntime JS

@if (text.Length > 0)
{
    <div class="prose md" aria-hidden="true" @ref="el"><p class="stream">@foreach (var part in Parts()) { @part }<span class="caret"></span></p></div>
}

@code {
    [Parameter] public LiveSession Session { get; set; } = null!;
    string text = "";
    ElementReference el;
    LiveSession? subscribed;   // the page reuses this component across sessions: follow the parameter

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(subscribed, Session))
        {
            if (subscribed is not null) subscribed.Changed -= Refresh;
            subscribed = Session;
            Session.Changed += Refresh;
        }
        text = Session.StreamingText;
    }

    void Refresh() => InvokeAsync(() =>
    {
        var t = Session.StreamingText;   // same instance until a delta arrives
        if (ReferenceEquals(t, text)) return;
        text = t;
        StateHasChanged();
    });

    // Completed paragraphs keep their exact text (so their frame diffs as unchanged); only the last one grows.
    IEnumerable<string> Parts()
    {
        var start = 0;
        for (int i; (i = text.IndexOf("\n\n", start, StringComparison.Ordinal)) >= 0; start = i + 2) yield return text[start..(i + 2)];
        yield return text[start..];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (text.Length == 0) return;
        try { await JS.InvokeVoidAsync("claudeUi.scrollEnd", el); }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
    }

    public void Dispose()
    {
        if (subscribed is not null) subscribed.Changed -= Refresh;
    }
}
