@if (Session.Status == SessionStatus.Crashed)
{
    <div class="crash">
        <div class="duck"><Duck Mood="Mood.Ko" Size="72" /></div>
        <div>
            <h4>@L["Crash.Title"]</h4>
            <p>@L["Crash.Text"]</p>
            <pre>@Session.ExitText</pre>
            <div class="acts" style="justify-content:flex-start">
                <button class="btn primary" disabled="@restarting" @onclick="Restart"><Icon Name="refresh" Sm />@L["Crash.Restart"]</button>
                <button class="btn" data-copy="@Session.ExitText">@L["Error.Copy"]</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public LiveSession Session { get; set; } = null!;
    bool restarting;

    async Task Restart()
    {
        restarting = true;
        try { await Session.Restart(); }
        catch (Exception ex) { Console.Error.WriteLine($"[{Session.Id}] relance : {ex.Message}"); }   // the session shows Crashed with the reason
        finally { restarting = false; }
    }
}
