@if (Session.Status == SessionStatus.Crashed)
{
    <div class="crash" role="alert">
        <div class="duck" aria-hidden="true"><Duck Mood="Mood.Ko" Size="72" /></div>
        <div>
            <h2>@L[Session.StartFailed ? "Crash.StartFailed.Title" : "Crash.Title"]</h2>
            <p>@L[Session.StartFailed ? "Crash.StartFailed.Text" : "Crash.Text"]</p>
            <pre>@Session.ExitText</pre>
            <div class="acts">
                <button class="btn primary" disabled="@restarting" aria-busy="@(restarting ? "true" : null)" @onclick="Restart">@if (restarting) { <span class="spin" aria-hidden="true"></span> } else { <Icon Name="refresh" Sm /> }@L["Crash.Restart"]</button>
                <button class="btn" data-copy="@Session.ExitText">@L["Error.Copy"]</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public LiveSession Session { get; set; } = null!;
    bool restarting;

    async Task Restart()
    {
        restarting = true;
        try { await Session.Restart(); }
        catch (Exception ex) { Console.Error.WriteLine($"[{Session.Id}] relance : {ex.Message}"); }   // the session shows Crashed with the reason
        finally { restarting = false; }
    }
}
