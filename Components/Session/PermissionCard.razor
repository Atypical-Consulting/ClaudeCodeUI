@* can_use_tool for this session. ⏎ / Maj ⏎ / Suppr arrive through UiState.Key (app.js forwards them while focus is inside [data-permission]). *@
@implements IDisposable
@inject SessionManager Sessions
@inject UiState Ui
@inject IJSRuntime JS

<div class="ph"><span class="ttl">Permission</span><span class="sub">@Permission.Tool</span>
    <span class="end"><span class="pill wait">@L["OfN", queue.FindIndex(x => x.P == Permission) + 1, queue.Count]</span></span>
</div>
<div style="flex:1;min-height:0;overflow:auto">
    <div class="section" data-permission tabindex="-1" role="group" aria-label="@Title" @ref="card">
        <h3>@Title</h3>
        @if (Events.Str(Permission.Input, "description") is { Length: > 0 } d)
        {
            <p>@d</p>
        }
        @if (diff is not null)
        {
            <DiffView Path="@ToolKinds.Target(Permission.Input, Session.Cwd)" Lines="diff" />
        }
        else if (ToolKinds.IsShell(Permission.Tool))
        {
            <pre class="cmd">@Events.Str(Permission.Input, "command")</pre>
        }
        else
        {
            <Markdown Text="@($"```json\n{ToolDetail.Pretty(Permission.Input)}\n```")" />
        }
        <div class="acts">
            <button class="btn primary" disabled="@answered" @onclick="() => Answer(Decision.Allow)">@L["Perm.Allow"] <kbd>⏎</kbd></button>
            @if (CanAllowSession)
            {
                <button class="btn" disabled="@answered" @onclick="() => Answer(Decision.AllowSession)">@L["Perm.WholeSession"]</button>
            }
            <button class="btn danger" disabled="@answered" @onclick="() => Answer(Decision.Deny)">@L["Perm.Deny"]</button>
        </div>
        @if (CanAllowSession)
        {
            <p style="font-size:12px">@L["Perm.WholeSession"] · @SessionGrant</p>
        }
        @if (error is not null)
        {
            <div class="errbox">@error</div>
        }
        <p style="font-size:12px;color:var(--fg-4)"><kbd>⏎</kbd> @L["Perm.HintAllow"] · @if (CanAllowSession) {<kbd>@L["Key.ShiftEnter"]</kbd><text> @L["Perm.HintSession"] · </text>}<kbd>@L["Key.Del"]</kbd> @L["Perm.HintDeny"]<span class="perm-off"> · @L["Perm.HintFocus"]</span></p>
    </div>
    @if (queue.Where(x => x.P != Permission).ToList() is { Count: > 0 } others)
    {
        <div class="section" style="border-bottom:0">
            <span class="cap">@L["Perm.AlsoWaiting"]</span>
            @foreach (var (s, p) in others)
            {
                <a class="q" href="session/@s.Id" style="grid-template-columns:auto 52px minmax(0,1fr);padding:0;border:0">
                    <span class="dot wait"></span>
                    <span style="color:@ToolKinds.Color(p.Tool)">@p.Tool</span>
                    <span class="p" style="color:var(--fg-2)">@s.Name · <span style="color:var(--fg)">@ToolKinds.Target(p.Input, s.Cwd)</span></span>
                </a>
            }
        </div>
    }
</div>

@code {
    [Parameter] public LiveSession Session { get; set; } = null!;
    [Parameter] public PendingPermission Permission { get; set; } = null!;

    List<(LiveSession S, PendingPermission P)> queue = [];
    IReadOnlyList<DiffLine>? diff;
    PendingPermission? shown;
    ElementReference card;
    bool answered, arm;
    string? error;

    // "Toute la session": a setMode suggestion goes through set_permission_mode; others are echoed as updatedPermissions.
    bool CanAllowSession => Permission.Suggestions is { ValueKind: JsonValueKind.Array } s && s.GetArrayLength() > 0;

    string File => Path.GetFileName(Events.Str(Permission.Input, "file_path") ?? "");
    string Title => Permission.Tool switch
    {
        "Edit" or "MultiEdit" => L["Perm.Edit", File],
        "Write" => System.IO.File.Exists(Events.Str(Permission.Input, "file_path")) ? L["Perm.Overwrite", File] : L["Perm.Create", File],
        var t when ToolKinds.IsShell(t) => L["Perm.Run"],
        var t => L["Perm.AllowTool", t],
    };

    protected override void OnInitialized()
    {
        Sessions.Changed += Refresh;
        Ui.Key += OnKey;
    }

    protected override void OnParametersSet()
    {
        queue = [.. Sessions.DecisionQueue];
        if (shown == Permission) return;
        shown = Permission;
        answered = false;
        arm = true;
        error = null;
        diff = ToolKinds.IsEdit(Permission.Tool) ? EditDiff.FromInput(Permission.Tool, Permission.Input) : null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!arm) return;
        arm = false;
        await JS.InvokeVoidAsync("claudeUi.armPermission", card);
    }

    // What "Whole session" grants, as LiveSession.Answer sends it: a setMode wins, else the rules and directories.
    string SessionGrant
    {
        get
        {
            var sg = Permission.Suggestions!.Value.EnumerateArray().ToList();
            if (Events.Str(sg.FirstOrDefault(x => Events.Str(x, "type") == "setMode"), "mode") is { } mode) return L["Perm.GrantMode", mode];
            var parts = sg.SelectMany(x => Events.Prop(x, Events.Str(x, "type") == "addDirectories" ? "directories" : "rules") is { ValueKind: JsonValueKind.Array } a
                ? a.EnumerateArray().Select(v => v.ValueKind == JsonValueKind.String ? v.GetString()!
                    : Events.Str(v, "toolName") + (Events.Str(v, "ruleContent") is { Length: > 0 } c ? $"({c})" : ""))
                : []);
            return L["Perm.GrantRules", string.Join(", ", parts)];
        }
    }

    async Task Answer(Decision d)
    {
        if (answered || (d == Decision.AllowSession && !CanAllowSession)) return;
        answered = true;
        try { await Session.Answer(Permission, d); }
        catch (Exception ex) { error = ex.Message; answered = false; }
    }

    void OnKey(string key) => InvokeAsync(async () =>
    {
        switch (key)
        {
            case "Enter": await Answer(Decision.Allow); break;
            case "Shift+Enter": await Answer(Decision.AllowSession); break;
            case "Delete": await Answer(Decision.Deny); break;
            default: return;
        }
        StateHasChanged();
    });

    void Refresh() => InvokeAsync(() => { queue = [.. Sessions.DecisionQueue]; StateHasChanged(); });

    public void Dispose()
    {
        Sessions.Changed -= Refresh;
        Ui.Key -= OnKey;
    }
}
