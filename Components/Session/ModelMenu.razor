@* Model picker (not in the mockup): initialize.models, chosen with set_model. Reuses the .pop.slash / .si styles. *@

@inject IJSRuntime JS

<div class="pop slash menu" role="listbox" aria-label="@L["Model"]" @ref="list" tabindex="0" aria-activedescendant="mm-opt-@sel"
     @onkeydown="Key" @onkeydown:preventDefault>
    <div class="sh"><span>@L["Model"]</span><span>@error</span></div>
    @{ var cur = Current(Session) is { } c ? Events.Str(c, "value") : null; }
    @for (var i = 0; i < models.Count; i++)
    {
        var m = models[i];
        var value = Events.Str(m, "value") ?? "";
        var current = value == cur;
        <div id="mm-opt-@i" class="si @(current ? "on" : null) @(i == sel ? "kb" : null)" role="option" aria-selected="@(current ? "true" : "false")" @onclick="() => Pick(value)">
            <b>@(Events.Str(m, "displayName") ?? value)</b>
            <span title="@Events.Str(m, "description")">@Events.Str(m, "description")</span>
            @if (current) { <span class="tag acc">@L["Model.Current"]</span> } else { <span></span> }
        </div>
    }
</div>

@code {
    [Parameter] public LiveSession Session { get; set; } = null!;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnEscape { get; set; }
    string? error;
    int sel;
    ElementReference list;
    List<JsonElement> models = [];

    // The active option starts on the current model; it is a keyboard cursor only (hover does not move it).
    protected override void OnInitialized()
    {
        models = [.. Models(Session)];
        var cur = Current(Session) is { } c ? Events.Str(c, "value") : null;
        sel = Math.Max(0, models.FindIndex(m => Events.Str(m, "value") == cur));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await JS.InvokeVoidAsync("claudeUi.focus", list);
        await JS.InvokeVoidAsync("claudeUi.reveal", list, $"mm-opt-{sel}");
    }

    async Task Key(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Enter" or " ":
                if (sel >= 0 && sel < models.Count) await Pick(Events.Str(models[sel], "value") ?? "");
                break;
            case "Escape" or "Tab":
                await OnEscape.InvokeAsync();
                break;
            default:
                sel = ListNav.Next(e.Key, sel, models.Count);
                break;
        }
    }

    async Task Pick(string value)
    {
        try
        {
            await Session.SetModel(value);
            await OnClose.InvokeAsync();
        }
        catch (Exception ex) { error = L["Model.SetFailed", ex.Message]; }
    }

    public static IEnumerable<JsonElement> Models(LiveSession s) =>
        s.InitializeInfo is { } info && Events.Prop(info, "models") is { ValueKind: JsonValueKind.Array } a ? a.EnumerateArray() : [];

    // Session.Model is a launch alias ("haiku"), a set_model value or the resolved id from init ("claude-haiku-5-5").
    public static JsonElement? Current(LiveSession s)
    {
        var ms = Models(s).ToList();
        if (ms.FirstOrDefault(m => Events.Str(m, "value") == s.Model) is { ValueKind: JsonValueKind.Object } byValue) return byValue;
        var resolved = ms.Where(m => s.Model is { } x && Events.Str(m, "resolvedModel") is { } r && x.StartsWith(r, StringComparison.OrdinalIgnoreCase)).ToList();
        return resolved.FirstOrDefault(m => Events.Str(m, "value") != "default") is { ValueKind: JsonValueKind.Object } r2 ? r2
             : resolved.FirstOrDefault() is { ValueKind: JsonValueKind.Object } r3 ? r3 : null;
    }
}
