@* Model picker (not in the mockup): initialize.models, chosen with set_model. Reuses the .pop.slash / .si styles.
   Then the advisor (/advisor, when the CLI offers it), the output style (/output-style: initialize.available_output_styles)
   and "set as default", in the same keyboard list. *@

@inject IJSRuntime JS

<div class="pop slash menu">
    <div class="sh"><span>@L["Model"]</span><span role="status" class="@(error is null ? null : "c-err-fg")">@(error ?? note)</span></div>
    <div role="listbox" aria-label="@L["Model"]" @ref="list" tabindex="0" aria-activedescendant="mm-opt-@sel"
         @onkeydown="Key" @onkeydown:preventDefault>
    @{ var cur = Current(Session) is { } c ? Events.Str(c, "value") : null; }
    @for (var i = 0; i < models.Count; i++)
    {
        var m = models[i];
        var value = Events.Str(m, "value") ?? "";
        var current = value == cur;
        <div id="mm-opt-@i" class="si @(current ? "on" : null) @(i == sel ? "kb" : null)" role="option" aria-selected="@(current ? "true" : "false")" @onclick="() => Pick(value)">
            <b title="@(Events.Str(m, "displayName") ?? value)">@(Events.Str(m, "displayName") ?? value)</b>
            <span title="@Events.Str(m, "description")">@Events.Str(m, "description")</span>
            @if (current) { <span class="tag acc">@L["Model.Current"]</span> } else { <span></span> }
        </div>
    }
    @if (advisors.Count > 0)
    {
        <div role="group" aria-labelledby="mm-adv">
            <div class="gh" id="mm-adv" role="presentation" title="@L["Model.AdvisorHint"]">@L["Model.Advisor"]</div>
            @for (var j = 0; j < advisors.Count; j++)
            {
                var a = advisors[j];
                var n = models.Count + j;
                var on = a == "off" ? Session.Advisor is null : Resolved(a) is { } r && r == Session.Advisor;
                <div id="mm-opt-@n" class="si @(on ? "on" : null) @(n == sel ? "kb" : null)" role="option" aria-selected="@(on ? "true" : "false")" @onclick="() => PickAdvisor(a)">
                    <b>@(a == "off" ? L["Model.AdvisorOff"].Value : Label(a))</b><span></span>
                    @if (on) { <span class="tag acc">@L["Model.Current"]</span> } else { <span></span> }
                </div>
            }
        </div>
    }
    @if (styles.Count > 0)
    {
        <div role="group" aria-labelledby="mm-style">
            <div class="gh" id="mm-style" role="presentation" title="@L["Model.StyleHint"]">@L["Model.Style"]</div>
            @for (var j = 0; j < styles.Count; j++)
            {
                var st = styles[j];
                var n = models.Count + advisors.Count + j;
                var on = st == (Session.OutputStyle ?? "default");
                <div id="mm-opt-@n" class="si @(on ? "on" : null) @(n == sel ? "kb" : null)" role="option" aria-selected="@(on ? "true" : "false")" @onclick="() => PickStyle(st)">
                    <b>@st</b><span></span>
                    @if (on) { <span class="tag acc">@L["Model.Current"]</span> } else { <span></span> }
                </div>
            }
        </div>
    }
    @if (cur is not null)
    {
        var d = models.Count + advisors.Count + styles.Count;
        <div id="mm-opt-@d" class="si @(d == sel ? "kb" : null)" role="option" aria-selected="false" @onclick="SetDefault">
            <b>@L["Model.SetDefault"]</b>
            <span>@(Session.Effort is { } e ? $"{Label(cur)} · {Strings.Name("Effort.", e)}" : Label(cur))</span><span></span>
        </div>
    }
    </div>
    @if (Session.ContextTokens > 0)
    {
        @* The prompt cache is per model: the next turn re-reads the whole conversation at full price. *@
        <p class="mm-cache">@L["Model.CacheHint"]</p>
    }
</div>

@code {
    [Parameter] public LiveSession Session { get; set; } = null!;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnEscape { get; set; }
    string? error, note;
    int sel;
    ElementReference list;
    List<JsonElement> models = [];
    List<string> advisors = [];
    List<string> styles = [];
    int Count => models.Count + advisors.Count + styles.Count + (Current(Session) is null ? 0 : 1);

    // The active option starts on the current model; it is a keyboard cursor only (hover does not move it).
    protected override void OnInitialized()
    {
        models = [.. Models(Session)];
        advisors = [.. Advisors(Session)];
        styles = [.. Session.InitializeInfo is { } info ? Events.Names(info, "available_output_styles") : []];
        var cur = Current(Session) is { } c ? Events.Str(c, "value") : null;
        sel = Math.Max(0, models.FindIndex(m => Events.Str(m, "value") == cur));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await JS.InvokeVoidAsync("claudeUi.focus", list);
        await JS.InvokeVoidAsync("claudeUi.reveal", list, $"mm-opt-{sel}");
    }

    async Task Key(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Enter" or " ":
                if (sel < models.Count) await Pick(Events.Str(models[sel], "value") ?? "");
                else if (sel < models.Count + advisors.Count) await PickAdvisor(advisors[sel - models.Count]);
                else if (sel < models.Count + advisors.Count + styles.Count) await PickStyle(styles[sel - models.Count - advisors.Count]);
                else await SetDefault();
                break;
            case "Escape" or "Tab":
                await OnEscape.InvokeAsync();
                break;
            default:
                sel = ListNav.Next(e.Key, sel, Count);
                break;
        }
    }

    async Task Pick(string value)
    {
        try
        {
            await Session.SetModel(value);
            await OnClose.InvokeAsync();
        }
        catch (Exception ex) { error = L["Model.SetFailed", ex.Message]; }
    }

    async Task PickAdvisor(string a)
    {
        try
        {
            await Session.SetAdvisor(a == "off" ? null : a);
            if (a != "off" && Session.Advisor is null) { error = L["Model.AdvisorRefused", Label(a)]; return; }   // weaker than the model
            await OnClose.InvokeAsync();
        }
        catch (Exception ex) { error = L["Model.SetFailed", ex.Message]; }
    }

    async Task PickStyle(string style)
    {
        try
        {
            await Session.SetOutputStyle(style);
            await OnClose.InvokeAsync();
        }
        catch (Exception ex) { error = L["Model.SetFailed", ex.Message]; }
    }

    async Task SetDefault()
    {
        if (Current(Session) is not { } c || Events.Str(c, "value") is not { } v) return;
        error = note = null;
        try
        {
            await Session.SetDefault(v, Session.Effort);
            note = Session.Effort == "max" ? L["Model.DefaultSetNoMax"] : L["Model.DefaultSet"];
        }
        catch (Exception ex) { error = L["Model.DefaultFailed", ex.Message]; }
    }

    string Label(string value) => models.FirstOrDefault(m => Events.Str(m, "value") == value) is { ValueKind: JsonValueKind.Object } m ? Events.Str(m, "displayName") ?? value : value;
    string? Resolved(string value) => models.FirstOrDefault(m => Events.Str(m, "value") == value) is { ValueKind: JsonValueKind.Object } m ? Events.Str(m, "resolvedModel") : null;

    public static IEnumerable<JsonElement> Models(LiveSession s) =>
        s.InitializeInfo is { } info && Events.Prop(info, "models") is { ValueKind: JsonValueKind.Array } a ? a.EnumerateArray() : [];

    // The /advisor command's argumentHint lists the advisor models ("[fable|opus|sonnet|off]" on 2.1.296); no command, no
    // advisor (a gate the CLI decides).
    public static IEnumerable<string> Advisors(LiveSession s) =>
        s.InitializeInfo is { } info && Events.Prop(info, "commands") is { ValueKind: JsonValueKind.Array } a
        && a.EnumerateArray().FirstOrDefault(c => Events.Str(c, "name") == "advisor") is { ValueKind: JsonValueKind.Object } adv
        && Events.Str(adv, "argumentHint") is { } hint
            ? hint.Trim('[', ']', '<', '>', ' ').Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries) : [];

    // Session.Model is a launch alias ("haiku"), a set_model value or the resolved id from init ("claude-haiku-5-5").
    public static JsonElement? Current(LiveSession s)
    {
        var ms = Models(s).ToList();
        if (ms.FirstOrDefault(m => Events.Str(m, "value") == s.Model) is { ValueKind: JsonValueKind.Object } byValue) return byValue;
        var resolved = ms.Where(m => s.Model is { } x && Events.Str(m, "resolvedModel") is { } r && x.StartsWith(r, StringComparison.OrdinalIgnoreCase)).ToList();
        return resolved.FirstOrDefault(m => Events.Str(m, "value") != "default") is { ValueKind: JsonValueKind.Object } r2 ? r2
             : resolved.FirstOrDefault() is { ValueKind: JsonValueKind.Object } r3 ? r3 : null;
    }
}
