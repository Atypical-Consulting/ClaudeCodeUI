@* The .pane.insp column: the pending permission (shown even when Ctrl I hid the pane: it blocks the turn) with the
   selected agent or tool under it, else the selected agent or tool, else the context. *@
@implements IDisposable
@inject UiState Ui

@if (Ui.InspectorOpen || Session.Pending.Count > 0)
{
    var p = Session.Pending.FirstOrDefault();
    <aside class="pane insp" aria-label="@L["Inspector"]">
        @if (p is not null)
        {
            <PermissionCard @key="p.RequestId" Session="Session" Permission="p" />
        }
        @if (Selected is { } t && t.Id != p?.ToolUseId)
        {
            if (ToolKinds.IsAgent(t.Name))
            {
                <AgentPanel @key="t.Id" Session="Session" Agent="t" />
            }
            else
            {
                <ToolDetail @key="t.Id" Session="Session" Tool="t" />
            }
        }
        else if (p is null && (Session.Context is not null || Session.HasProcess))
        {
            <ContextPanel Session="Session" />
        }
        else if (p is null)
        {
            <div class="ph"><h2 class="ttl">@L["Inspector"]</h2></div>
            <div class="section" style="border-bottom:0"><p>@L["Ctx.SelectRow"]</p></div>
        }
    </aside>
}

@code {
    [Parameter] public LiveSession Session { get; set; } = null!;

    ToolItem? Selected => Session.Tool(Ui.SelectedToolId);

    protected override void OnInitialized() => Ui.Changed += Refresh;
    void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => Ui.Changed -= Refresh;
}
