@* The .pane.insp column: pending permission, else the selected agent or tool, else the context. Hidden by Ctrl I. *@
@implements IDisposable
@inject UiState Ui

@if (Ui.InspectorOpen)
{
    <aside class="pane insp" aria-label="@L["Inspector"]">
        @if (Session.Pending.FirstOrDefault() is { } p)
        {
            <PermissionCard @key="p.RequestId" Session="Session" Permission="p" />
        }
        else if (Selected is { } t && ToolKinds.IsAgent(t.Name))
        {
            <AgentPanel @key="t.Id" Session="Session" Agent="t" />
        }
        else if (Selected is { } tool)
        {
            <ToolDetail @key="tool.Id" Session="Session" Tool="tool" />
        }
        else if (Session.Context is not null || Session.HasProcess)
        {
            <ContextPanel Session="Session" />
        }
        else
        {
            <div class="ph"><h2 class="ttl">@L["Inspector"]</h2></div>
            <div class="section" style="border-bottom:0"><p>@L["Ctx.SelectRow"]</p></div>
        }
    </aside>
}

@code {
    [Parameter] public LiveSession Session { get; set; } = null!;

    ToolItem? Selected => Ui.SelectedToolId is { } id ? Session.Items.OfType<ToolItem>().LastOrDefault(t => t.Id == id) : null;

    protected override void OnInitialized() => Ui.Changed += Refresh;
    void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => Ui.Changed -= Refresh;
}
