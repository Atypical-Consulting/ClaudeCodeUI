@implements IDisposable
@* get_context_usage, refreshed when the session goes idle after a turn, then the session's memory files. *@

@{
    var c = Session.Context;
    long max = c is { } x1 ? Long(x1, "maxTokens") : Session.ContextWindow ?? 0;
    long total = c is { } x2 ? Long(x2, "totalTokens") : Session.ContextTokens;
}
<div class="ph"><h2 class="ttl">@L["Ctx.Title"]</h2>
    @if (max > 0)
    {
        <span class="sub">@Fmt.Tokens(total) / @Fmt.Tokens(max) · @Fmt.Pct(total / (double)max)</span>
    }
</div>
<div class="scroll">
    @if (c is { } ctx && max > 0)
    {
        var rows = Rows(ctx);
        var mcpTools = Events.Prop(ctx, "mcpTools") is { ValueKind: JsonValueKind.Array } mt ? mt.EnumerateArray().Where(t => Events.Prop(t, "isLoaded") is { ValueKind: JsonValueKind.True }).ToList() : [];
        var mcpTokens = rows.Where(r => r.Mcp).Sum(r => r.Tokens);
        <div class="section">
            <div class="ctx">
                <div class="ctxbar" aria-hidden="true">
                    @foreach (var r in rows)
                    {
                        <i style="width:@((r.Tokens * 100.0 / max).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;background:@r.Color"></i>
                    }
                </div>
                <div class="legend">
                    @foreach (var r in rows.GroupBy(r => r.Label))
                    {
                        <i style="background:@r.First().Color"></i><span>@r.Key</span><span>@Fmt.Tokens(r.Sum(x => x.Tokens))</span>
                    }
                    <i style="background:var(--seam)"></i><span>@L["Ctx.Free"]</span><span>@Fmt.Tokens(Math.Max(0, max - total))</span>
                </div>
            </div>
            <div class="acts">
                <button class="btn" disabled="@(compacting || Session.Status is not (SessionStatus.Idle or SessionStatus.Exited))" @onclick="Compact"><Icon Name="compress" Sm />@L["Ctx.CompactNow"]</button>
                @if (Events.Prop(ctx, "isAutoCompactEnabled") is { ValueKind: JsonValueKind.True } && Long(ctx, "autoCompactThreshold") is > 0 and var th)
                {
                    <span class="why" title="@L["Ctx.AutoTitle"]">@L["Ctx.Auto", Fmt.Pct(th / (double)max)]</span>
                    @* /autocompact <tokens|auto>: the CLI saves the window for the model (modelSettings) and answers in the thread. *@
                    <span class="picks"><select aria-label="@L["Ctx.Window"]" title="@L["Ctx.WindowHint"]" disabled="@(compacting || Session.Status is not (SessionStatus.Idle or SessionStatus.Exited))" @bind:get="string.Empty" @bind:set="SetWindow">
                        <option value="">@L["Ctx.Window"]</option>
                        @foreach (var w in Windows)
                        {
                            <option value="@w">@(w == "auto" ? L["Ctx.WindowAuto"] : Fmt.Tokens(long.Parse(w)))</option>
                        }
                    </select></span>
                }
            </div>
            @if (error is not null)
            {
                <div class="errbox" role="alert">@error</div>
            }
        </div>
        @if (mcpTools.Count > 0)
        {
            <div class="section">
                <span class="cap">@L["Ctx.McpWeight", Fmt.Tokens(mcpTokens)]</span>
                @{ int n = mcpTools.Count, k = mcpTools.Select(t => Events.Str(t, "serverName")).Distinct().Count(); }
                <p>@L[n == 1 ? "Ctx.Loaded1" : "Ctx.LoadedN", Strings.Plural(n, "Tools"), Strings.Plural(k, "Ctx.Servers")] @L["Ctx.DisableHint"]</p>
                <div><a class="btn" href="extensions">@L["Ctx.ManageMcp"]</a></div>
            </div>
        }
    }
    else
    {
        <div class="section"><p>@L[Session.HasProcess ? "Ctx.Unknown" : "Ctx.NoProcess"]</p></div>
    }
    @if (Session.ContextTokens > 0 && Session.CacheRead + Session.CacheWrite > 0)
    {
        @* The last API call's usage: what of its prompt came from the prompt cache, and what it (re)wrote there. *@
        <div class="section">
            <span class="cap">@L["Ctx.Cache"]</span>
            <p title="@L["Ctx.CacheHint"]">@L["Ctx.CacheLine", Fmt.Pct(Session.CacheRead / (double)Session.ContextTokens), Fmt.Tokens(Session.CacheWrite)]</p>
        </div>
    }
    <div class="section">
        @* /cd: LiveSession.SetCwd. A folder the CLI never trusted asks first, as the terminal does. *@
        <span class="cap" id="cwd-cap">@L["Cwd.Label"]</span>
        <p class="cwd-now" title="@Session.Cwd"><PickFolder Start="@Session.Cwd" OnPick="MoveTo" OnError="m => cwdNote = m"
                       Disabled="@(moving || Session.Status is SessionStatus.Starting or SessionStatus.Running or SessionStatus.Waiting)" /> @TranscriptStore.Short(Session.Cwd)</p>
        @if (trust is { } t)
        {
            <p role="alert">@L["Cwd.Trust", t]</p>
            <div class="acts">
                <button type="button" class="btn primary" disabled="@moving" @onclick="() => MoveTo(t, t)">@L["New.Trust"]</button>
                <button type="button" class="btn ghost" @onclick="() => trust = null">@L["Action.Cancel"]</button>
            </div>
        }
        @if (cwdNote is not null)
        {
            <p role="status">@cwdNote</p>
        }
    </div>
    <div class="section">
        <label class="cap" for="ctx-add-dir">@L["Dirs.Label"]</label>
        <p>@L["Dirs.LiveHint"]</p>
        @* Idle, or no process (the folder then goes into --add-dir at the next launch): the only states the probe covers. *@
        <ExtraDirs Id="ctx-add-dir" Dirs="Session.AddDirs" Cwd="@Session.Cwd" OnAdd="Session.AddDir"
                   Confirm="@(LiveSession.Risky(Session.Mode) ? L["Dirs.ConfirmRisky", Strings.Name("Mode.Name.", Session.Mode)].Value : null)"
                   Disabled="Session.Status is SessionStatus.Starting or SessionStatus.Running or SessionStatus.Waiting" />
    </div>
    @if (Bookmarks.Of(Session.Id) is { Count: > 0 } marks)
    {
        @* Bookmarked replies (Thread): a link scrolls the thread to the reply (its id is m-<uuid>). *@
        <div class="section">
            <span class="cap" id="bm-cap">@L["Bookmark.Title"]</span>
            <ul class="bms" aria-labelledby="bm-cap">
                @foreach (var b in marks)
                {
                    <li><a href="@($"session/{Session.Id}#m-{b.Uuid}")">@b.Gist</a></li>
                }
            </ul>
        </div>
    }
    <MemoryPanel Session="Session" />
    <StatusPanel Session="Session" />
</div>

@code {
    [Parameter] public LiveSession Session { get; set; } = null!;

    // A reply bookmarked in the thread shows up here at once.
    protected override void OnInitialized() => Bookmarks.Changed += Refresh;
    void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => Bookmarks.Changed -= Refresh;
    DateTimeOffset? refreshedFor;
    string? trust, cwdNote;
    bool moving;

    async Task MoveTo(string path) => await MoveTo(path, null);

    async Task MoveTo(string path, string? trusted)
    {
        moving = true;
        cwdNote = null;
        try
        {
            trust = await Session.SetCwd(path, trusted);
            if (trust is null) cwdNote = L["Cwd.Moved", TranscriptStore.Short(Session.Cwd)];
        }
        catch (Exception ex) { trust = null; cwdNote = L["Session.ActionFailed", ex.Message.TrimEnd()]; }
        finally { moving = false; }
    }
    bool refreshed;
    string? error;

    record Row(string Label, string Color, long Tokens, bool Mcp);

    // Used categories only ("deferred" tools are not in the context, "buffer" and "free" count as libre).
    static List<Row> Rows(JsonElement ctx)
    {
        var mcp = Events.Prop(ctx, "mcpTools") is { ValueKind: JsonValueKind.Array } mt ? mt.EnumerateArray().Count(t => Events.Prop(t, "isLoaded") is { ValueKind: JsonValueKind.True }) : 0;
        return Events.Prop(ctx, "categories") is { ValueKind: JsonValueKind.Array } cats
        ? [.. cats.EnumerateArray().Where(k => Events.Str(k, "kind") == "used" && Long(k, "tokens") > 0).Select(k => (Events.Str(k, "name") ?? "") switch
            {
                "System prompt" => new Row(Strings.Get("Ctx.Cat.SystemPrompt"), "var(--fg-4)", Long(k, "tokens"), false),
                "System tools" => new Row(Strings.Get("Ctx.Cat.SystemTools"), "var(--syn-fn)", Long(k, "tokens"), false),
                var n when n.StartsWith("MCP") => new Row(mcp > 0 ? Strings.Get("Ctx.Cat.McpN", mcp) : Strings.Get("Ctx.Cat.Mcp"), "var(--syn-kw)", Long(k, "tokens"), true),
                "Memory files" => new Row(Strings.Get("Ctx.Cat.Memory"), "var(--syn-attr)", Long(k, "tokens"), false),
                "Custom agents" => new Row(Strings.Get("Ctx.Cat.Agents"), "var(--syn-type)", Long(k, "tokens"), false),
                "Skills" => new Row(Strings.Get("Ctx.Cat.Skills"), "var(--syn-num)", Long(k, "tokens"), false),
                "Messages" => new Row(Strings.Get("Ctx.Cat.Messages"), "var(--syn-str)", Long(k, "tokens"), false),
                var n => new Row(n, "var(--fg-3)", Long(k, "tokens"), false),
            })]
        : [];
    }

    static long Long(JsonElement e, string name) => Events.Prop(e, name) is { ValueKind: JsonValueKind.Number } n ? (long)n.GetDouble() : 0;

    protected override void OnParametersSet()
    {
        if (!Session.HasProcess || Session.Status != SessionStatus.Idle || (refreshed && refreshedFor == Session.LastResultAt)) return;
        refreshed = true;
        refreshedFor = Session.LastResultAt;
        _ = Session.RefreshContext().ContinueWith(t => Console.Error.WriteLine($"[{Session.Id}] get_context_usage : {t.Exception?.InnerException?.Message}"), TaskContinuationOptions.OnlyOnFaulted);
    }

    static readonly string[] Windows = ["auto", "200000", "400000", "600000", "1000000"];   // the CLI takes 100k to 1M

    // Bound to "" rather than @onchange: @bind makes Blazor record the picked value, so the "" re-render resets the select.
    async Task SetWindow(string? w)
    {
        if (w is not { Length: > 0 } || compacting) return;
        compacting = true;
        error = null;
        try { await Session.Send($"/autocompact {w}"); }
        catch (Exception ex) { error = L["Ctx.WindowFailed", ex.Message]; }
        finally { compacting = false; }
    }

    // Plain user text: slash commands run locally in the CLI.
    // Send awaits apply_flag_settings (Ultracode) before the turn starts, so Status stays Idle meanwhile: refuse a second click here.
    bool compacting;
    async Task Compact()
    {
        if (compacting) return;
        compacting = true;
        error = null;
        try { await Session.Send("/compact"); }
        catch (Exception ex) { error = L["Ctx.CompactFailed", ex.Message]; }
        finally { compacting = false; }
    }
}
