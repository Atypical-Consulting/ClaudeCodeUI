@* Selected tool: Diff (edits, and a Bash command's bashEditDiff) or Sortie, Entrée, JSON brut, and a .kv footer. *@
@using System.Text.Encodings.Web
@inject UiState Ui

<div class="ph"><h2 class="ttl">@L["Inspector"]</h2><span class="sub">@Tool.Name · @(FilePath is { } fp ? Path.GetFileName(fp) : ToolKinds.Target(Tool.Name, Tool.Input, Session.Cwd))</span>
    <span class="end"><TaskActions Session="Session" Tool="Tool" /><button class="btn ghost" title="@L["Action.Close"]" aria-label="@L["Action.Close"]" @onclick="() => Ui.SelectedToolId = null"><Icon Name="x" Sm /></button></span>
</div>
<div class="tabs" role="tablist" aria-label="@L["Inspector"]">
    @foreach (var (t, label) in new[] { (0, ToolKinds.IsEdit(Tool.Name) ? L["Tool.Diff"].Value : L["Tool.Output"].Value), (1, L["Tool.Input"].Value), (2, L["Tool.RawJson"].Value) })
    {
        <button id="td-tab-@t" class="tab @(tab == t ? "on" : null)" role="tab" aria-selected="@((tab == t) ? "true" : "false")" aria-controls="td-panel"
                tabindex="@(tab == t ? 0 : -1)" @onclick="() => tab = t">@label</button>
    }
</div>
<div id="td-panel" role="tabpanel" aria-labelledby="td-tab-@tab" tabindex="0" class="scroll">
    @switch (tab)
    {
        case 0 when edit && Tool.State is not (ToolState.Denied or ToolState.Error or ToolState.NotRun):
            <div class="diffs" style="padding:16px">
                @if (!ToolKinds.IsEdit(Tool.Name))
                {
                    @* A Bash command that changed files: its output first, then what it changed. *@
                    <pre class="cmdlog" style="margin:0;overflow:auto">@(Tool.ResultText is { Length: > 0 } br ? br : L["Tool.NoOutput"])</pre>
                }
                @if (diffs.Any(d => d.Lines.Count > 0))
                {
                    @foreach (var d in diffs)
                    {
                        <DiffView @key="(diffState, d.Path)" Path="@ToolKinds.Relative(d.Path, Session.Cwd)" Lines="d.Lines" />
                    }
                }
                else
                {
                    <p style="margin:0;color:var(--fg-4);font-size:13px">@L["Tool.NoChanges"]</p>
                }
                @if (Events.Prop(Tool.Structured ?? default, "bashEditDiff") is { } bed && Events.Long(bed, "moreFiles") is > 0 and var more)
                {
                    <p style="margin:0;color:var(--fg-4);font-size:13px">@L["Diff.MoreFiles", more]</p>
                }
            </div>
            break;
        case 0 when Tool.State is ToolState.NotRun:
            <div style="padding:16px"><p style="margin:0 0 12px;color:var(--fg-3);font-size:13px">@L["Tool.NotRunWhy"]</p><pre class="cmdlog" style="margin:0;overflow:auto">@Tool.ResultText</pre></div>
            break;
        case 0 when Tool.State is ToolState.Error or ToolState.Denied:
            <div style="padding:16px"><div class="errbox">@Tool.ResultText</div>
                @if (Tool.State == ToolState.Error && Mcp.ServerOf(Tool.Name, Mcp.Names(Session)) is { } server)
                {
                    @* A failed MCP call: its server's page (status, Retry), and for a refused credential a fresh sign-in. *@
                    @if (Mcp.AuthError(Tool.ResultText) && !server.StartsWith("claude.ai "))
                    {
                        <p>@L["Mcp.AuthFailed", server]</p>
                        @if (authUrl is { } au)
                        {
                            <p role="status">@L["Mcp.AuthWaiting"]</p>
                            <div class="acts"><a class="btn primary" href="@au" target="_blank" rel="noopener noreferrer">@L["Ext.OpenSignIn"]</a></div>
                        }
                        else if (authNote is { } an)
                        {
                            <p role="status">@an</p>
                        }
                    }
                    <div class="acts">
                        @if (Mcp.AuthError(Tool.ResultText) && !server.StartsWith("claude.ai ") && authUrl is null)
                        {
                            <button class="btn primary" disabled="@authBusy" @onclick="() => SignInAgain(server)"><Icon Name="plug" Sm />@L["Mcp.SignInAgain"]</button>
                        }
                        <a class="btn" href="@($"extensions?tab=mcp&session={Session.Id}&server={Uri.EscapeDataString(server)}")">@L["Mcp.Servers"]</a>
                    </div>
                }
            </div>
            break;
        case 0 when Tool.Name == AskUser.Tool && AskUser.Answered(Tool.Structured) is { Length: > 0 } answered:
            <div class="section last">
                <dl class="ask-done">
                    @foreach (var (q, a) in answered)
                    {
                        <dt>@q</dt>
                        <dd>@a</dd>
                    }
                </dl>
            </div>
            break;
        case 0 when Tool.Name == "Read" && Tool.ResultText is { } read:
            <FileView Path="@(FilePath ?? "")" ReadResultText="@read" />
            break;
        case 0:
            <div style="padding:16px"><pre class="cmdlog" style="margin:0;overflow:auto">@(Tool.ResultText is { Length: > 0 } r ? r : Tool.State == ToolState.Done ? L["Tool.NoOutput"] : L["Bg.NoOutput"])</pre></div>
            break;
        case 1:
            <div style="padding:16px 16px 0"><Markdown Text="@(input ??= $"```json\n{Pretty(Tool.Input)}\n```")" /></div>
            break;
        default:
            <div style="padding:16px 16px 0"><Markdown Text="@(raw ??= $"```json\n{Raw()}\n```")" /></div>
            break;
    }
</div>
<div class="section" style="margin-top:auto;border-top:1px solid var(--seam);border-bottom:0">
    <div class="kv">
        <span>@L["Tool.Kv.Tool"]</span><span>@Tool.Name</span>
        @if (FilePath is not null)
        {
            <span>@L["Tool.Kv.File"]</span><span>@ToolKinds.Target(Tool.Name, Tool.Input, Session.Cwd)</span>
        }
        @if (readRange is { } range)
        {
            <span>@L["Tool.Kv.Lines"]</span><span>@range</span>
        }
        @if (edit && diffs.Sum(d => d.Lines.Count) > 0)
        {
            <span>@L["Tool.Kv.Diff"]</span><span>+@diffs.Sum(d => d.Lines.Count(l => l.Kind == DiffKind.Add)) −@diffs.Sum(d => d.Lines.Count(l => l.Kind == DiffKind.Del))</span>
        }
        <span>@L["Tool.Kv.Status"]</span>
        @switch (Tool.State)
        {
            case ToolState.Done: <span class="c-ok">@(ToolKinds.IsEdit(Tool.Name) ? L["Tool.Applied"] : L["Tool.Done"])</span> break;
            case ToolState.Denied: <span class="c-err">@L["Tool.Denied"]</span> break;
            case ToolState.Error: <span class="c-err">@L["Tool.Error"]</span> break;
            case ToolState.NotRun: <span>@L["Tool.NotRun"]</span> break;
            case ToolState.Waiting: <span class="c-wait">@L["Tool.Waiting"]</span> break;
            default: <span>@L["Status.Running"]</span> break;
        }
        @if (Tool.EndedAt is { } end)
        {
            <span>@L["Tool.Kv.Duration"]</span><span>@Fmt.Dur(end - Tool.StartedAt)</span>
        }
    </div>
</div>

@code {
    [Parameter] public LiveSession Session { get; set; } = null!;
    [Parameter] public ToolItem Tool { get; set; } = null!;

    static readonly JsonSerializerOptions Indented = new() { WriteIndented = true, Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping };
    public static string Pretty(JsonElement e) => JsonSerializer.Serialize(e, Indented);

    int tab;
    bool edit, authBusy;
    string? authUrl, authNote;

    // mcp_clear_auth then mcp_authenticate (LiveSession.SignInAgain); the CLI reconnects the server once the browser is done.
    async Task SignInAgain(string server)
    {
        authBusy = true;
        authNote = null;
        try
        {
            var start = await Session.SignInAgain(server);
            if (start.Url is { } u && start.CallbackExpected) authUrl = u;
            else authNote = start.Url is null ? L["Mcp.SignedIn", server] : L["Ext.AuthTerminal", server];
        }
        catch (Exception ex) { authNote = L["Ext.ActionFailed", ex.Message.TrimEnd()]; }
        finally { authBusy = false; }
    }
    IReadOnlyList<FileDiff> diffs = [];
    ToolState? diffState;

    string? FilePath => Events.Str(Tool.Input, "file_path");

    // Built once per (state, result), not per render: the Input/Raw JSON, and the Read line range.
    (ToolState, string?)? seen;
    string? input, raw, readRange;

    protected override void OnParametersSet()
    {
        if (seen != (Tool.State, Tool.ResultText))
        {
            seen = (Tool.State, Tool.ResultText);
            raw = null;
            readRange = Tool.Name == "Read" && System.Text.RegularExpressions.Regex.Matches(Tool.ResultText ?? "", @"^\s*(\d+)[→\t]", System.Text.RegularExpressions.RegexOptions.Multiline) is { Count: > 0 } m
                ? $"{m[0].Groups[1].Value}–{m[^1].Groups[1].Value}" : null;
        }
        var bash = EditDiff.FromBash(Tool.Structured);
        edit = ToolKinds.IsEdit(Tool.Name) || bash.Count > 0;
        if (!edit || diffState == Tool.State) return;
        diffState = Tool.State;
        // After the fact: the CLI's structuredPatch; a created file has none. Before (or replayed without it): from the input.
        diffs = bash.Count > 0 ? bash : [new(FilePath ?? "",
            Tool.Structured is { } s && Events.Prop(s, "structuredPatch") is { ValueKind: JsonValueKind.Array } p && p.GetArrayLength() > 0 ? EditDiff.FromPatch(p)
            : Tool.Structured is { } c && Events.Str(c, "type") == "create" ? EditDiff.Created(Events.Str(c, "content") ?? "")
            : EditDiff.FromInput(Tool.Name, Tool.Input))];
    }

    // The tool_use block and its result, as the CLI sent them (rebuilt: the raw lines are not kept).
    string Raw()
    {
        var o = new System.Text.Json.Nodes.JsonObject
        {
            ["tool_use"] = new System.Text.Json.Nodes.JsonObject { ["type"] = "tool_use", ["id"] = Tool.Id, ["name"] = Tool.Name, ["input"] = System.Text.Json.Nodes.JsonNode.Parse(Tool.Input.GetRawText()) },
        };
        if (Tool.ResultText is not null)
            o["tool_result"] = new System.Text.Json.Nodes.JsonObject { ["type"] = "tool_result", ["tool_use_id"] = Tool.Id, ["content"] = Tool.ResultText, ["is_error"] = Tool.State is ToolState.Error or ToolState.Denied or ToolState.NotRun };
        if (Tool.Structured is { } s) o["tool_use_result"] = System.Text.Json.Nodes.JsonNode.Parse(s.GetRawText());
        return o.ToJsonString(Indented);
    }
}
