@inject UiState Ui

<button type="button" class="t @Class" @onclick="Select">
    <Icon Name="@(Selected ? "down" : "right")" Sm Class="chev" />
    <span class="kind" style="color:@ToolKinds.Color(Tool.Name)" title="@Tool.Name">@ToolKinds.Label(Tool.Name)</span>
    <span class="p">@ToolKinds.Target(Tool.Input, Session.Cwd)</span>
    @Meta(Tool)
</button>

@code {
    [Parameter] public LiveSession Session { get; set; } = null!;
    [Parameter] public ToolItem Tool { get; set; } = null!;

    bool Selected => Ui.SelectedToolId == Tool.Id;

    // A row only changes with its tool's state, its selection or the session cwd, not on every page render.
    // Structured/ResultText (read by Meta) are left out on purpose: LiveSession sets them in the same reducer step as
    // State + EndedAt (the only earlier write, an async launch receipt, lands while Running, where Meta shows "…").
    // If a result ever arrives as a separate event, add it to this key and to the Done() cache key.
    (ToolState, DateTimeOffset?, bool, string)? drawn;
    protected override bool ShouldRender()
    {
        var k = (Tool.State, Tool.EndedAt, Selected, Session.Cwd);
        if (drawn == k) return false;
        drawn = k;
        return true;
    }

    void Select()
    {
        Ui.SelectedToolId = Tool.Id;
        Ui.InspectorOpen = true;   // the row's only effect is the Inspector: a closed one would swallow the click
    }
    string? Class => Tool.State switch
    {
        ToolState.Waiting => "wait",
        ToolState.Denied => "void",
        _ => Selected ? "sel" : null,
    };

    // Right-hand slot of a tool row; also used by the subagent rows of Workflow.
    public static RenderFragment Meta(ToolItem t) => t.State switch
    {
        ToolState.Waiting => @<span class="m">@Strings.Get("Tool.Waiting")</span>,
        ToolState.Denied => @<span class="badge no">@Strings.Get("Tool.Denied")</span>,
        ToolState.Error => @<span class="badge no">@Strings.Get("Tool.Error")</span>,
        ToolState.Running => @<span class="m">…</span>,
        _ when t.Name == "Write" && Events.Str(t.Structured ?? default, "type") == "create" => @<span class="badge ok">@Strings.Get("Tool.Created")</span>,
        _ => Done(t) is { Length: > 0 } m ? @<span class="m">@m</span> : _ => { },
    };

    // Computed once per finished tool, keyed on EndedAt (a background agent can finish again).
    static readonly System.Runtime.CompilerServices.ConditionalWeakTable<ToolItem, Tuple<DateTimeOffset?, string>> metas = new();

    static string Done(ToolItem t)
    {
        if (metas.TryGetValue(t, out var c) && c.Item1 == t.EndedAt) return c.Item2;
        var m = Compute(t);
        metas.AddOrUpdate(t, Tuple.Create(t.EndedAt, m));
        return m;
    }

    static string Compute(ToolItem t)
    {
        var s = t.Structured ?? default;
        switch (t.Name)
        {
            case "Read":
                var n = Num(Events.Prop(s, "file") ?? default, "numLines") ?? t.ResultText?.TrimEnd('\n').Split('\n').Length ?? 0;
                return n == 1 ? Strings.Get("Tool.Lines1") : Strings.Get("Tool.LinesN", n);
            case "Grep" or "Glob":
                var r = (Events.Str(s, "mode") switch { "content" => Num(s, "numLines"), "count" => Num(s, "numMatches"), _ => Num(s, "numFiles") })
                        ?? t.ResultText?.Split('\n', StringSplitOptions.RemoveEmptyEntries).Length ?? 0;
                return r == 1 ? Strings.Get("Tool.Results1") : Strings.Get("Tool.ResultsN", r);
            case "Edit" or "MultiEdit" or "Write" when Events.Prop(s, "structuredPatch") is { ValueKind: JsonValueKind.Array } patch:
                var lines = patch.EnumerateArray().Where(h => Events.Prop(h, "lines") is { ValueKind: JsonValueKind.Array }).SelectMany(h => h.GetProperty("lines").EnumerateArray()).Select(l => l.GetString() ?? "").ToList();
                return $"+{lines.Count(l => l.StartsWith('+'))} −{lines.Count(l => l.StartsWith('-'))}";
        }
        return t.EndedAt - t.StartedAt is { TotalMilliseconds: >= 50 } d ? Fmt.Dur(d) : "";
    }

    static int? Num(JsonElement e, string name) => Events.Prop(e, name) is { ValueKind: JsonValueKind.Number } v ? (int)v.GetDouble() : null;
}
