@* A failed API turn: same look as the crash card (.crash), but the session is still alive, so no restart. *@
<div class="crash" role="alert">
    <div class="duck" aria-hidden="true"><BlazorKawaii.Components.RubberDuck Mood="Mood.Sad" Size="56" Color="#FCCC0A" /></div>
    <div>
        <h4>@Error.Title</h4>
        <p>@Error.Hint</p>
        <pre>@Error.Raw</pre>
        <div class="acts" style="justify-content:flex-start">
            <button type="button" class="btn" data-copy="@Error.Raw" aria-label="Copier l'erreur API">Copier l'erreur</button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ApiError Error { get; set; } = null!;
}
