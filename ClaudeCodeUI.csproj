<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <Version>0.5.0</Version>
    <DefaultItemExcludes>$(DefaultItemExcludes);desktop/**;publish/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BlazorKawaii" Version="2.2.0"/>
    <PackageReference Include="Markdig" Version="1.4.0"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Repo tooling and dev-only settings: not part of the shipped server. -->
    <Content Update="renovate.json;release-please-config.json;.release-please-manifest.json;appsettings.Development.json" CopyToPublishDirectory="Never"/>
  </ItemGroup>

  <!-- The desktop's bundled server (the only single-file publish) runs as ccui-server: a `Stop-Process -Name ClaudeCodeUI`
       or `pkill ClaudeCodeUI` aimed at a dev instance killed the installed app's server, and every claude session with it. -->
  <Target Name="RenameDesktopServer" AfterTargets="Publish" Condition="'$(PublishSingleFile)' == 'true'">
    <Move SourceFiles="$(PublishDir)$(AssemblyName)$(_NativeExecutableExtension)" DestinationFiles="$(PublishDir)ccui-server$(_NativeExecutableExtension)"/>
  </Target>

</Project>
