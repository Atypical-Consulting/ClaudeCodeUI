{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "claude-code-ui",
      "bump-minor-pre-major": true,
      "initial-version": "0.1.0",
      "include-component-in-tag": false,
      "changelog-sections": [
        { "type": "feat", "section": "Fonctionnalités" },
        { "type": "fix", "section": "Corrections" },
        { "type": "perf", "section": "Performances" },
        { "type": "docs", "section": "Documentation" },
        { "type": "ci", "section": "Intégration continue", "hidden": true },
        { "type": "chore", "section": "Maintenance", "hidden": true }
      ],
      "extra-files": [
        { "type": "json", "path": "desktop/src-tauri/tauri.conf.json", "jsonpath": "$.version" },
        { "type": "toml", "path": "desktop/src-tauri/Cargo.toml", "jsonpath": "$.package.version" },
        { "type": "xml", "path": "ClaudeCodeUI.csproj", "xpath": "//Project/PropertyGroup/Version" }
      ]
    }
  }
}
