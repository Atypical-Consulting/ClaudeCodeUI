{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Code UI",
  "version": "0.1.0",
  "identifier": "com.atypicalconsulting.claudecodeui",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Claude Code UI",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0E0F11",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self'; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Desktop console for Claude Code",
    "copyright": "Copyright (c) 2026 Atypical Consulting",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist"
    },
    "resources": {
      "server/": "server/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY4MjQ4NUMzQjI3RDMzNDIKUldSQ00zMnl3NFVrK0VUTUZadzRDUldxdmV0WXlidkdyaC9WWlhlNVJBWWE4R2MwRHZZbGZmMEcK",
      "endpoints": ["https://github.com/Atypical-Consulting/ClaudeCodeUI/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
