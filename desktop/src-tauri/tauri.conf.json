{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Code UI",
  "version": "0.1.0",
  "identifier": "com.atypicalconsulting.claudecodeui",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Claude Code UI",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0E0F11"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Desktop console for Claude Code",
    "copyright": "Copyright (c) 2026 Atypical Consulting",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist"
    },
    "resources": {
      "server/": "server/"
    }
  }
}
